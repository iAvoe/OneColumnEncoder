<UserControl x:Class="OneColumnEncoder.Components.ValidationActionGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
             xmlns:local="clr-namespace:OneColumnEncoder.Components"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:ValidationActionGroupVM}"
             mc:Ignorable="d"
             d:DesignWidth="450">
    <StackPanel>
        <comps:ValidationCard DataContext="{Binding Card}"
                              ToggleCommand="{Binding DataContext.ToggleMiniCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                              ToggleTag="{Binding DataContext.IsMini, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                              ToggleToolTip="{Binding DataContext.ToggleMiniText, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                              Margin="{Binding CardMargin, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}">
            <comps:ValidationCard.Style>
                <Style TargetType="comps:ValidationCard">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsMini, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </comps:ValidationCard.Style>
        </comps:ValidationCard>

        <cards:MiniValidationCard DataContext="{Binding Card}"
                                  ToggleCommand="{Binding DataContext.ToggleMiniCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                                  ToggleTag="{Binding DataContext.IsMini, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                                  ToggleToolTip="{Binding DataContext.ToggleMiniText, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                                  Margin="{Binding CardMargin, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}">
            <cards:MiniValidationCard.Style>
                <Style TargetType="cards:MiniValidationCard">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsMini, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </cards:MiniValidationCard.Style>
        </cards:MiniValidationCard>

        <ContentControl Content="{Binding MiddleContent, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}" />

        <comps:TwoButtonGroup DataContext="{Binding Buttons}"
                              ButtonHeight="{Binding ButtonHeight, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}"
                              Button2Highlight="{Binding B2_2Highlight}"
                              Margin="{Binding ButtonsMargin, RelativeSource={RelativeSource AncestorType={x:Type local:ValidationActionGroup}}}" />
    </StackPanel>
</UserControl>
