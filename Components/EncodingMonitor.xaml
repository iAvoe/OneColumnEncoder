<UserControl x:Class="OneColumnEncoder.Components.EncodingMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:EncodingMonitorVM}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style x:Key="ProgressAvailableVisibilityStyle"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProgressTrackingAvailable}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AvailableProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Height"
                    Value="20" />
            <Setter Property="Minimum"
                    Value="0" />
            <Setter Property="Maximum"
                    Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                ClipToBounds="True">
                            <Border Margin="1"
                                    CornerRadius="2">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" />
                                    <Border x:Name="PART_Track" />
                                    <Border x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            CornerRadius="2"
                                            Background="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UnavailableProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Height"
                    Value="20" />
            <Setter Property="Minimum"
                    Value="0" />
            <Setter Property="Maximum"
                    Value="100" />
            <Setter Property="Background"
                    Value="{StaticResource MemoryRangeEmpty}" />
            <Setter Property="Foreground"
                    Value="{StaticResource GlobalSecondary}" />
            <Setter Property="IsIndeterminate"
                    Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                ClipToBounds="True">
                            <Border Margin="1"
                                    CornerRadius="2"
                                    Opacity="0.9">
                                <Border.Background>
                                    <DrawingBrush Viewport="0,0,24,24"
                                                  ViewportUnits="Absolute"
                                                  TileMode="Tile"
                                                  Stretch="None">
                                        <DrawingBrush.Transform>
                                            <TransformGroup>
                                                <TranslateTransform x:Name="StripeOffset"
                                                                    X="0" />
                                                <RotateTransform Angle="35"
                                                                 CenterX="12"
                                                                 CenterY="12" />
                                            </TransformGroup>
                                        </DrawingBrush.Transform>
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#006C767D"
                                                                 Geometry="M 0,0 L 24,0 24,24 0,24 Z" />
                                                <GeometryDrawing Brush="#5A6C767D"
                                                                 Geometry="M 0,0 L 12,0 12,24 0,24 Z" />
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate"
                                     Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="StripeOffset"
                                                              Storyboard.TargetProperty="X"
                                                              By="24"
                                                              Duration="0:0:8"
                                                              IsCumulative="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProgressUnavailableVisibilityStyle"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProgressTrackingAvailable}"
                             Value="False">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="15 10 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ProgressTitle}"
                               Style="{StaticResource H3}"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="1"
                          Margin="10 0 14 0"
                          Style="{StaticResource ProgressAvailableVisibilityStyle}">
                        <ProgressBar Style="{StaticResource AvailableProgressBarStyle}"
                                     Value="{Binding ProgressValue}"
                                     Foreground="{StaticResource ProgressGreen}"
                                     Background="{StaticResource MemoryRangeEmpty}" />
                    </Grid>
                    <Grid Grid.Column="1"
                          Margin="10 0 14 0"
                          Style="{StaticResource ProgressUnavailableVisibilityStyle}">
                        <ProgressBar Style="{StaticResource UnavailableProgressBarStyle}" />
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="{Binding ProgressText}"
                               FontSize="13"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgressTrackingAvailable}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Margin="0 15 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MemoryTitle}"
                                   Style="{StaticResource H3}"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="1"
                                      Margin="5 0 5 0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <comps:MemoryRangeBar Items="{Binding MemoryRangeBlocks}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                        </ScrollViewer>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RangeSummary}"
                                   FontSize="13"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeUpstream8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionUpstreamLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionUpstream}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeDownstream8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionDownstreamLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionDownstream}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeCache8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionCacheLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionCache}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeEmpty}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionAvailableLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionAvailable}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <comps:ColumnTextGrid Margin="0 10 0 0"
                                      Items="{Binding MetricColumns}"
                                      ColumnCount="6" />

                <comps:IntegerSlider Margin="0 10 0 0"
                                     Label="{Binding SampleIntervalLabel}"
                                     LabelWidth="120"
                                     Minimum="0"
                                     Maximum="240"
                                     Value="{Binding SampleIntervalSeconds, Mode=TwoWay}"
                                     TickLabels="{Binding SampleIntervalTickLabels}"
                                     TickCount="5"
                                     Step="1"
                                     IsEnabled="{Binding IsMonitoringEnabled}" />

                <comps:TwoButtonGroup Margin="0 5 0 0"
                                      DataContext="{Binding MonitorButtons}"
                                      ButtonHeight="30"
                                      Button1Command="{Binding Cmd1}"
                                      Button2Command="{Binding Cmd2}"
                                      Button1IsEnabled="{Binding B2_1IsEnabled}"
                                      Button2IsEnabled="{Binding B2_2IsEnabled}" />

                <StackPanel Margin="0 10 0 0">
                    <cards:SplitTextCard Title="{Binding StderrTitle}"
                                         LeftText="{Binding UpstreamReportText, Mode=TwoWay}"
                                         RightText="{Binding DownstreamReportText, Mode=TwoWay}"
                                         TextFontSize="{Binding LogFontSize}"
                                         IsRichTextMode="{Binding LogRichTextMode}" />

                    <comps:ThreeButtonGroup Margin="0 15 0 0"
                                            DataContext="{Binding ReportButtons}"
                                            ButtonHeight="30"
                                            Button1Command="{Binding Cmd1}"
                                            Button2Command="{Binding Cmd2}"
                                            Button3Command="{Binding Cmd3}"
                                            Button1IsEnabled="{Binding B3_1IsEnabled}"
                                            Button2IsEnabled="{Binding B3_2IsEnabled}"
                                            Button3IsEnabled="{Binding B3_3IsEnabled}" />
                    <comps:HintPanel Text="{Binding DragLogReportHint}"
                                     HintBrush="{StaticResource GlobalSecondary}"
                                     Margin="0 2.5 0 0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0 10 0 0">
            <comps:ColumnTextGrid Items="{Binding FooterColumns}"
                                  ColumnCount="6" />
            <StackPanel Orientation="Horizontal"
                        Margin="0 15 0 0">
                <CheckBox Content="{Binding EnableMuxText}"
                          IsChecked="{Binding EnableMux, Mode=TwoWay}"
                          IsEnabled="{Binding CanMux}"
                          VerticalAlignment="Center" />
                <CheckBox Content="{Binding RichTextModeText}"
                          IsChecked="{Binding LogRichTextMode, Mode=TwoWay}"
                          Margin="10 0 0 0"
                          VerticalAlignment="Center" />
            </StackPanel>
            <comps:HintPanel Text="{Binding MuxTimebaseHint}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 2.5 0 0" />
            <comps:FiveButtonGroup Margin="0 10 0 0"
                                   DataContext="{Binding FinishButtons}"
                                   ButtonHeight="30"
                                   Button1Command="{Binding Cmd1}"
                                   Button2Command="{Binding Cmd2}"
                                   Button3Command="{Binding Cmd3}"
                                   Button4Command="{Binding Cmd4}"
                                   Button5Command="{Binding Cmd5}"
                                   Button1IsEnabled="{Binding B5_1IsEnabled}"
                                   Button2IsEnabled="{Binding B5_2IsEnabled}"
                                   Button3IsEnabled="{Binding B5_3IsEnabled}"
                                   Button4IsEnabled="{Binding B5_4IsEnabled}"
                                   Button5IsEnabled="{Binding B5_5IsEnabled}" />
            <StackPanel Visibility="{Binding OpusAudioCommandHint, Converter={StaticResource StringToVisibilityConverter}}">
                <comps:HintPanel Text="{Binding OpusAudioCommandHint}"
                                 HintBrush="{StaticResource GlobalSecondary}"
                                 Margin="0 2.5 0 0" />
                <comps:HintPanel Text="{Binding OpusAudioBitrateHint}"
                                 HintBrush="{StaticResource GlobalSecondary}"
                                 Margin="0 2.5 0 0" />
            </StackPanel>
            <comps:HintPanel Text="{Binding SmallNoteText}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 2.5 0 0" />
        </StackPanel>
    </Grid>
</UserControl>
