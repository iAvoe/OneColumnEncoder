<UserControl x:Class="OneColumnEncoder.Components.EncodingMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:EncodingMonitorVM}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="15 10 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <comps:ProgressBar ProgressTitle="{Binding Progress.ProgressTitle}"
                                   ProgressValue="{Binding Progress.ProgressValue}"
                                   ProgressText="{Binding Progress.ProgressText}"
                                   IsProgressTrackingAvailable="{Binding Progress.IsProgressTrackingAvailable}"
                                   IsEncodingActive="{Binding Progress.IsEncodingActive}" />

                <Grid Margin="0 15 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MemoryTitle}"
                                   Style="{StaticResource H3}"
                                   VerticalAlignment="Center" />
                        <ScrollViewer x:Name="MemoryRangeScrollViewer"
                                      Grid.Column="1"
                                      Margin="5 0 5 0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <comps:MemoryRangeBar Items="{Binding MemoryRangeBlocks}"
                                                  Width="{Binding ActualWidth, ElementName=MemoryRangeScrollViewer}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                        </ScrollViewer>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RangeSummary}"
                                   FontSize="13"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Mem usage columns -->
                    <Grid Grid.Row="1"
                          Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeUpstream8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionUpstreamLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionUpstream}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeDownstream8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionDownstreamLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionDownstream}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeCache8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionCacheLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionCache}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeEmpty}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionAvailableLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionAvailable}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <comps:ColumnTextGrid Margin="0 10 0 0"
                                      Items="{Binding MetricColumns}"
                                      ColumnCount="6" />

                <comps:IntegerSlider Margin="0 10 0 0"
                                     Label="{Binding SampleIntervalLabel}"
                                     LabelWidth="120"
                                     Minimum="0"
                                     Maximum="240"
                                     Value="{Binding SampleIntervalSeconds, Mode=TwoWay}"
                                     TickLabels="{Binding SampleIntervalTickLabels}"
                                     TickCount="5"
                                     Step="1"
                                     ZeroText="{Binding SampleIntervalZeroText}"
                                     IsEnabled="{Binding IsMonitoringEnabled}" />

                <!-- Progress log -->
                <StackPanel Margin="0 5 0 0">
                    <cards:SplitTextCard Title="{Binding StderrTitle}"
                                         LeftText="{Binding UpstreamReportText, Mode=TwoWay}"
                                         RightText="{Binding DownstreamReportText, Mode=TwoWay}"
                                         TextFontSize="{Binding LogFontSize}"
                                         IsRichTextMode="{Binding LogRichTextMode}" />

                    <comps:ThreeButtonGroup Margin="0 15 0 0"
                                            DataContext="{Binding ReportButtons}"
                                            ButtonHeight="30"
                                            Button1Command="{Binding Cmd1}"
                                            Button2Command="{Binding Cmd2}"
                                            Button3Command="{Binding Cmd3}"
                                            Button1IsEnabled="{Binding B3_1IsEnabled}"
                                            Button2IsEnabled="{Binding B3_2IsEnabled}"
                                            Button3IsEnabled="{Binding B3_3IsEnabled}" />
                    <comps:HintPanel Text="{Binding DragLogReportHint}"
                                     HintBrush="{StaticResource GlobalSecondary}"
                                     Margin="0 2.5 0 0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0 10 0 0">
            <comps:ColumnTextGrid Items="{Binding FooterColumns}"
                                   ColumnCount="6" />
            <StackPanel Orientation="Horizontal"
                        Margin="0 15 0 0">
                <CheckBox Content="{Binding RichTextModeText}"
                          IsChecked="{Binding LogRichTextMode, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <CheckBox Content="{Binding SaveLogsText}"
                          IsChecked="{Binding SaveLogs, Mode=TwoWay}"
                          Margin="10 0 0 0"
                          VerticalAlignment="Center" />
            </StackPanel>
            <comps:FiveButtonGroup Margin="0 10 0 0"
                                   DataContext="{Binding FinishButtons}"
                                   ButtonHeight="30"
                                   Button1Command="{Binding Cmd1}"
                                   Button2Command="{Binding Cmd2}"
                                   Button3Command="{Binding Cmd3}"
                                   Button4Command="{Binding Cmd4}"
                                   Button5Command="{Binding Cmd5}"
                                   Button1IsEnabled="{Binding B5_1IsEnabled}"
                                   Button2IsEnabled="{Binding B5_2IsEnabled}"
                                   Button3IsEnabled="{Binding B5_3IsEnabled}"
                                   Button4IsEnabled="{Binding B5_4IsEnabled}"
                                   Button5IsEnabled="{Binding B5_5IsEnabled}" />
            <StackPanel Visibility="{Binding OpusAudioCommandHint, Converter={StaticResource StringToVisibilityConverter}}">
                <comps:HintPanel Text="{Binding OpusAudioCommandHint}"
                                 HintBrush="{StaticResource GlobalSecondary}"
                                 Margin="0 2.5 0 0" />
            </StackPanel>
            <comps:HintPanel Text="{Binding SmallNoteText}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 2.5 0 0" />
        </StackPanel>
    </Grid>
</UserControl>
