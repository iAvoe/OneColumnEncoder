<UserControl x:Class="OneColumnEncoder.Components.FrameServerPreviewerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:ui="clr-namespace:OneColumnEncoder.UI"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:VpyPreviewerVM}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PreviewFilenameText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource GlobalPrimary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="TextWrapping"
                    Value="NoWrap" />
        </Style>
    </UserControl.Resources>
    <!-- Unlike EncoderPreviewerPanel(ImgPreviewer) wrapping, VpyPreviewerPanel contains its own layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0.5 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding PreviewCommand}"
                    Height="28"
                    Width="120"
                    Style="{StaticResource QuaternaryButton}"
                    Margin="0 0 5 0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Rectangle Width="14"
                               Height="14"
                               VerticalAlignment="Center"
                               Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GamePlay}"
                                        Stretch="Uniform"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{Binding PreviewButtonText}"
                               VerticalAlignment="Center"
                               FontWeight="Normal"
                               Margin="5 0 0 0" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <!-- Tool dropdown: use avs2yuv or avs2pipemod -->
                <ComboBox Visibility="{Binding IsAvsPreview, Converter={StaticResource BoolToVisibility}}"
                          ItemsSource="{Binding AviSynthPreviewTools}"
                          SelectedItem="{Binding SelectedPreviewTool, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          Style="{StaticResource RoundedDropdownMenu}"
                          ToolTip="{Binding SelectedItem.FullPath, RelativeSource={RelativeSource Self}}"
                          MinWidth="150"
                          Height="25"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="2.5 0 10 0" />
                
                <!-- AVS-VS-FFmpeg message -->
                <comps:HintPanel Text="{Binding FrameServerLogText}"
                                 HintBrush="{StaticResource GlobalSecondary}" />
            </StackPanel>
            
            <!-- Zoom toggles -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0 0 5 0">
                <TextBlock Text="Zoom: "
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}" />
                <Button Content="--"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineOut_Click" />
                <Rectangle Width="3" />
                <Button Content="-"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomOut_Click" />
                <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                           Width="55"
                           FontSize="13"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}" />
                <Button Content="+"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomIn_Click" />
                <Rectangle Width="3" />
                <Button Content="++"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineIn_Click" />
                <Rectangle Width="5" />
                <Button Content="Fit"
                        Width="40"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFit_Click" />
                <Rectangle Width="3" />
                <Button Content="100%"
                        Width="50"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="Zoom100_Click" />
                <Rectangle Width="3" />
                <Button Content="200%"
                        Width="50"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="Zoom200_Click" />
            </StackPanel>

            <Button Grid.Column="3"
                    Width="30"
                    Height="30"
                    Style="{StaticResource NormalButton}"
                    Command="{Binding InspectFrameDataCommand}">
                <Rectangle Width="14"
                           Height="14"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameInfo}"
                                    Stretch="Uniform"
                                    AlignmentX="Center"
                                    AlignmentY="Center" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Button>
        </Grid>

        <comps:ImgPreviewer Grid.Row="1"
                            x:Name="PreviewViewer"
                            Margin="0 7.5 0 10" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Frame:"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource GlobalPrimary}" />
            <comps:IntegerSlider Grid.Column="1"
                                 Minimum="0"
                                 Maximum="{Binding MaxPositionSeconds}"
                                 Value="{Binding PreviewPositionSeconds, Mode=TwoWay}"
                                 TickLabels="{Binding PositionTickLabels}"
                                 TickCount="5"
                                 LabelWidth="0"
                                 HorizontalAlignment="Stretch"
                                 IsEnabled="{Binding IsIdle}" />
        </Grid>
    </Grid>
</UserControl>
