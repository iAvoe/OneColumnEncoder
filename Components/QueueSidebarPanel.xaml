<UserControl x:Class="OneColumnEncoder.Components.QueueSidebarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:EncodingMonitorVM}"
             mc:Ignorable="d"
             Width="350">
    <Grid Background="{StaticResource Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="15 15 0 15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Lang.QueueSidebarTitle}"
                           Style="{StaticResource H3}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{Binding Lang.QueueSidebarCollapseText}"
                        Command="{Binding QueueSidebarToggleCmd}"
                        Style="{StaticResource LinkButton}"
                        FontSize="13" />
            </Grid>
            <comps:TwoButtonGroup Margin="0 0 0 0"
                                  DataContext="{Binding QueueSidebarButtons}"
                                  ButtonHeight="26"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding QueueSidebar.Jobs}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.IsDeferredScrollingEnabled="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 HorizontalContentAlignment="Stretch"
                 Margin="5 0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0 0 0 5"
                            HorizontalAlignment="Stretch">
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected}"
                                            IsCancel="{Binding IsCancel}"
                                            HorizontalAlignment="Stretch" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Margin="0 5 0 0">
            <comps:SectionHeader HeaderText="{Binding Lang.QueueSidebarTitle}" />
            <TextBlock Text="{Binding QueueSidebar.StatsText}"
                       FontSize="10"
                       Foreground="{StaticResource GlobalSecondary}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
