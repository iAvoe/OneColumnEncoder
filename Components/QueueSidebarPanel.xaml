<UserControl x:Class="OneColumnEncoder.Components.QueueSidebarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:EncodingMonitorVM}"
             mc:Ignorable="d"
             Width="315">
    <UserControl.Resources>
        <Thickness x:Key="QueueSidebarContentPadding">7.5 10</Thickness>
        <Thickness x:Key="QueueSidebarItemMargin">0 2.5</Thickness>
    </UserControl.Resources>

    <Border Background="{StaticResource Background}"
            Padding="{StaticResource QueueSidebarContentPadding}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Lang.QueueSidebarTitle}"
                               Style="{StaticResource H3}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{Binding Lang.QueueSidebarCollapseText}"
                            Command="{Binding QueueSidebarToggleCmd}"
                            Style="{StaticResource LinkButton}"
                            FontSize="13" />
                </Grid>
                <comps:TwoButtonGroup DataContext="{Binding QueueSidebarButtons}"
                                      ButtonHeight="25"
                                      Button1Command="{Binding Cmd1}"
                                      Button2Command="{Binding Cmd2}"
                                      Button1IsEnabled="{Binding B2_1IsEnabled}"
                                      Button2IsEnabled="{Binding B2_2IsEnabled}" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding QueueSidebar.Jobs}"
                     SelectedItem="{Binding QueueSidebar.SelectedJob, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="0 5 0 0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="{StaticResource QueueSidebarItemMargin}"
                                HorizontalAlignment="Stretch">
                            <cards:MiniItemCard DataContext="{Binding}"
                                                IsSelected="{Binding IsSelected}"
                                                IsCancel="{Binding IsCancel}"
                                                HorizontalAlignment="Stretch" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Margin="0 5 0 0">
                <comps:SectionHeader HeaderText="{Binding Lang.QueueSidebarTitle}" />
                <TextBlock Text="{Binding QueueSidebar.StatsText}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
