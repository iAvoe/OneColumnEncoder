<UserControl x:Class="OneColumnEncoder.Components.ClipRangeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TrackHost"
              Grid.Row="0"
              VerticalAlignment="Center">
            <Border x:Name="TrackBackground"
                    HorizontalAlignment="Stretch"
                    Height="50"
                    VerticalAlignment="Center"
                    Background="#D9CAE4"
                    BorderBrush="#9673A6"
                    BorderThickness="1"
                    CornerRadius="2"/>

            <Canvas x:Name="TrackCanvas"
                    ClipToBounds="True">
                <Thumb x:Name="SelectionThumb"
                       Height="45"
                       DragDelta="SelectionThumb_DragDelta"
                       DragStarted="Thumb_DragStarted"
                       DragCompleted="Thumb_DragCompleted"
                       Cursor="SizeAll">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#F5E6A4"
                                    BorderBrush="#D2B45A"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Canvas>
        </Grid>

        <ItemsControl x:Name="AxisLabelsHost"
                      Grid.Row="1"
                      ItemsSource="{Binding AxisLabels, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding AxisColumnCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="10"
                               Foreground="{StaticResource GlobalSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
