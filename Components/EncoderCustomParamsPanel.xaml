<UserControl x:Class="OneColumnEncoder.Components.EncoderCustomParamsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:EncoderConfVM}"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding CustomParamsTitle}"
                   Style="{StaticResource H2}" />

        <comps:AppConfContainer Header="{Binding BasicParamsText, Mode=OneWay}"
                                Margin="0 10 0 0">
            <comps:AppConfItem Text="{Binding X264Text, Mode=OneWay}">
                <comps:DropdownMenu MinWidth="150"
                                    Height="25"
                                    DataContext="{Binding X264ModeDropdown}" />
            </comps:AppConfItem>

            <comps:AppConfItem Text="{Binding X265Text, Mode=OneWay}">
                <comps:DropdownMenu MinWidth="150"
                                    Height="25"
                                    DataContext="{Binding X265ModeDropdown}" />
            </comps:AppConfItem>

            <comps:AppConfItem Text="{Binding SvtAv1Text, Mode=OneWay}">
                <comps:DropdownMenu MinWidth="150"
                                    Height="25"
                                    DataContext="{Binding SvtAv1ModeDropdown}" />
            </comps:AppConfItem>

            <comps:AppConfItem Text="{Binding VvencText, Mode=OneWay}">
                <comps:DropdownMenu MinWidth="150"
                                    Height="25"
                                    DataContext="{Binding VvencModeDropdown}" />
            </comps:AppConfItem>
        </comps:AppConfContainer>

        <comps:HintPanel Text="{Binding VvencHintText, Mode=OneWay}"
                         FontSize="10"
                         Margin="5 2 5 0" />
        <comps:HintPanel Text="{Binding BlankPresetHint, Mode=OneWay}"
                         Margin="5 5 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />

        <TextBlock Text="{Binding KeyframeSecondsText, Mode=OneWay}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />
        <comps:IntegerSliderGroup>
            <comps:IntegerSlider Label="{Binding X264Text}"
                                 Minimum="6"
                                 Maximum="15"
                                 Value="{Binding X264Keyframe, Mode=TwoWay}"
                                 TickLabels="{Binding X264KeyframeLabels}"
                                 TickCount="4"
                                 SliderMaxWidth="430" />
            <comps:IntegerSlider Label="{Binding X265Text}"
                                 Minimum="4"
                                 Maximum="13"
                                 Value="{Binding X265Keyframe, Mode=TwoWay}"
                                 TickLabels="{Binding X265KeyframeLabels}"
                                 TickCount="4"
                                 SliderMaxWidth="430"
                                 Margin="0 6 0 0" />
            <comps:IntegerSlider Label="{Binding SvtAv1Text}"
                                 Minimum="6"
                                 Maximum="15"
                                 Value="{Binding SvtAv1Keyframe, Mode=TwoWay}"
                                 TickLabels="{Binding SvtAv1KeyframeLabels}"
                                 TickCount="4"
                                 SliderMaxWidth="430"
                                 Margin="0 6 0 0" />
        </comps:IntegerSliderGroup>

        <comps:HintPanel Text="{Binding KeyframeHintText1, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding KeyframeHintText2, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />

        <comps:AppConfContainer Header="{Binding ThirdPartyParamsText, Mode=OneWay}"
                                Margin="0 15 0 0">
            <comps:AppConfItem Text="{Binding X264ModText, Mode=OneWay}">
                <CheckBox IsChecked="{Binding X264Mod, Mode=TwoWay}" />
            </comps:AppConfItem>
            <comps:AppConfItem Text="{Binding X265JpsdrAqText, Mode=OneWay}">
                <CheckBox IsChecked="{Binding X265Aq, Mode=TwoWay}" />
            </comps:AppConfItem>
            <comps:AppConfItem Text="{Binding X265JpsdrDarkText, Mode=OneWay}">
                <CheckBox IsChecked="{Binding X265Dark, Mode=TwoWay}"
                          IsEnabled="{Binding IsX265DarkEnabled}" />
            </comps:AppConfItem>
            <comps:AppConfItem Text="{Binding X265JpsdrTextureText, Mode=OneWay}">
                <CheckBox IsChecked="{Binding X265Texture, Mode=TwoWay}"
                          IsEnabled="{Binding IsX265TextureEnabled}" />
            </comps:AppConfItem>
            <comps:AppConfItem Text="{Binding SvtAv1EssentialDl2Text, Mode=OneWay}">
                <CheckBox IsChecked="{Binding SvtAv1Dl2, Mode=TwoWay}" />
            </comps:AppConfItem>
            <comps:AppConfItem Text="{Binding SvtAv1EssentialAutoTileText, Mode=OneWay}">
                <CheckBox IsChecked="{Binding SvtAv1AutoTile, Mode=TwoWay}" />
            </comps:AppConfItem>
        </comps:AppConfContainer>

        <comps:HintPanel Text="{Binding ThirdPartyHintText1, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding ThirdPartyHintText2, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding ThirdPartyHintText3, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding ThirdPartyHintText4, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />

        <TextBlock Text="{Binding FreeTextControlTitle}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />
        <TabControl Margin="0 10 0 0">
            <TabItem Header="{Binding X264Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <StackPanel>
                    <TextBox Text="{Binding FreeTextParamsX264, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             FontFamily="{DynamicResource CodeFont}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                    <comps:HintPanel Text="{Binding AutoFfprobeHintX264, Mode=OneWay}"
                                     Margin="5 5 5 0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     FontWeight="Normal" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{Binding X265Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <StackPanel>
                    <TextBox Text="{Binding FreeTextParamsX265, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             FontFamily="{DynamicResource CodeFont}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                    <comps:HintPanel Text="{Binding AutoFfprobeHintX265, Mode=OneWay}"
                                     Margin="5 5 5 0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     FontWeight="Normal" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{Binding SvtAv1Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <StackPanel>
                    <TextBox Text="{Binding FreeTextParamsSvtAv1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             FontFamily="{DynamicResource CodeFont}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                    <comps:HintPanel Text="{Binding AutoFfprobeHintSvtAv1, Mode=OneWay}"
                                     Margin="5 5 5 0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     FontWeight="Normal" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Text="{Binding PreviewFreeTextControlTitle}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />
        <TabControl Margin="0 10 0 0">
            <TabItem Header="{Binding X264Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding PreviewFreeTextParamsX264, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         FontFamily="{DynamicResource CodeFont}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="{Binding X265Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding PreviewFreeTextParamsX265, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         FontFamily="{DynamicResource CodeFont}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="{Binding SvtAv1Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding PreviewFreeTextParamsSvtAv1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         FontFamily="{DynamicResource CodeFont}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
