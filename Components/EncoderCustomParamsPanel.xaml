<UserControl x:Class="OneColumnEncoder.Components.EncoderCustomParamsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:EncoderConfVM}"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding CustomParamsTitle}"
                   Style="{StaticResource H2}" />

        <TextBlock Text="{Binding BasicParamsText}"
                   Style="{StaticResource H3}"
                   Margin="0 10 0 0" />

        <Grid Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding X264Text}"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <comps:DropdownMenu Grid.Column="1"
                                MinWidth="150"
                                Height="25"
                                DataContext="{Binding X264ModeDropdown}" />
        </Grid>

        <Grid Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding X265Text}"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <comps:DropdownMenu Grid.Column="1"
                                MinWidth="150"
                                Height="25"
                                DataContext="{Binding X265ModeDropdown}" />
        </Grid>

        <Grid Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SvtAv1Text}"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <comps:DropdownMenu Grid.Column="1"
                                MinWidth="150"
                                Height="25"
                                DataContext="{Binding SvtAv1ModeDropdown}" />
        </Grid>

        <Grid Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding VvencText}"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <comps:DropdownMenu Grid.Column="1"
                                MinWidth="150"
                                Height="25"
                                DataContext="{Binding VvencModeDropdown}" />
        </Grid>

        <comps:HintPanel Text="{Binding VvencHintText, Mode=OneWay}"
                         FontSize="10"
                         Margin="5 2 5 0" />
        <comps:HintPanel Text="{Binding BlankPresetHint, Mode=OneWay}"
                         Margin="5 5 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />

        <TextBlock Text="{Binding KeyframeSecondsText, Mode=OneWay}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />
        <comps:IntegerSliderGroup>
            <comps:IntegerSlider Label="{Binding X264Text}"
                                 Minimum="6"
                                 Maximum="15"
                                 Value="{Binding X264Keyframe, Mode=TwoWay}"
                                 TickLabels="{Binding X264KeyframeLabels}"
                                 TickCount="4"
                                 SliderMaxWidth="430" />
            <comps:IntegerSlider Label="{Binding X265Text}"
                                 Minimum="4"
                                 Maximum="13"
                                 Value="{Binding X265Keyframe, Mode=TwoWay}"
                                 TickLabels="{Binding X265KeyframeLabels}"
                                 TickCount="4"
                                 SliderMaxWidth="430"
                                 Margin="0 6 0 0" />
            <comps:IntegerSlider Label="{Binding SvtAv1Text}"
                                 Minimum="6"
                                 Maximum="15"
                                 Value="{Binding SvtAv1Keyframe, Mode=TwoWay}"
                                 TickLabels="{Binding SvtAv1KeyframeLabels}"
                                 TickCount="4"
                                 SliderMaxWidth="430"
                                 Margin="0 6 0 0" />
        </comps:IntegerSliderGroup>

        <comps:HintPanel Text="{Binding KeyframeHintText1, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding KeyframeHintText2, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />

        <TextBlock Text="{Binding ThirdPartyParamsText, Mode=OneWay}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />
        <Grid Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="{Binding X264ModText, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0 5 0 0" />
            <CheckBox Grid.Row="0"
                      Grid.Column="1"
                      IsChecked="{Binding X264Mod, Mode=TwoWay}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Row="1"
                       Text="{Binding X265JpsdrAqText, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0 15 0 0" />
            <CheckBox Grid.Row="1"
                      Grid.Column="1"
                      IsChecked="{Binding X265Aq, Mode=TwoWay}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0 15 0 0" />
            <TextBlock Grid.Row="2"
                       Text="{Binding X265JpsdrDarkText, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0 15 0 0"
                       IsEnabled="{Binding IsX265DarkEnabled}" />
            <CheckBox Grid.Row="2"
                      Grid.Column="1"
                      IsChecked="{Binding X265Dark, Mode=TwoWay}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0 15 0 0"
                      IsEnabled="{Binding IsX265DarkEnabled}" />
            <TextBlock Grid.Row="3"
                       Text="{Binding X265JpsdrTextureText, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0 15 0 0"
                       IsEnabled="{Binding IsX265TextureEnabled}" />
            <CheckBox Grid.Row="3"
                      Grid.Column="1"
                      IsChecked="{Binding X265Texture, Mode=TwoWay}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0 15 0 0"
                      IsEnabled="{Binding IsX265TextureEnabled}" />
            <TextBlock Grid.Row="4"
                       Text="{Binding SvtAv1EssentialDl2Text, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0 15 0 0" />
            <CheckBox Grid.Row="4"
                      Grid.Column="1"
                      IsChecked="{Binding SvtAv1Dl2, Mode=TwoWay}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0 15 0 0" />
            <TextBlock Grid.Row="5"
                       Text="{Binding SvtAv1EssentialAutoTileText, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0 15 0 0" />
            <CheckBox Grid.Row="5"
                      Grid.Column="1"
                      IsChecked="{Binding SvtAv1AutoTile, Mode=TwoWay}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0 10 0 0" />
        </Grid>

        <comps:HintPanel Text="{Binding ThirdPartyHintText1, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding ThirdPartyHintText2, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding ThirdPartyHintText3, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
        <comps:HintPanel Text="{Binding ThirdPartyHintText4, Mode=OneWay}"
                         Margin="5 10 5 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />

        <TextBlock Text="{Binding FreeTextControlTitle}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />
        <TabControl Margin="0 10 0 0">
            <TabItem Header="{Binding X264Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding FreeTextParamsX264, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="{Binding X265Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding FreeTextParamsX265, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="{Binding SvtAv1Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding FreeTextParamsSvtAv1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>

        <TextBlock Text="{Binding PreviewFreeTextControlTitle}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />
        <TabControl Margin="0 10 0 0">
            <TabItem Header="{Binding X264Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding PreviewFreeTextParamsX264, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="{Binding X265Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding PreviewFreeTextParamsX265, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="{Binding SvtAv1Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <TextBox Text="{Binding PreviewFreeTextParamsSvtAv1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
