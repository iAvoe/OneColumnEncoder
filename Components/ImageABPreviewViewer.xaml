<UserControl x:Class="OneColumnEncoder.Components.ImageABPreviewViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:OneColumnEncoder.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ImageABPreviewVM}"
             ClipToBounds="True"
             Focusable="True"
             Background="White"
             MouseWheel="Viewer_MouseWheel"
             MouseLeftButtonDown="Viewer_MouseLeftButtonDown"
             MouseLeftButtonUp="Viewer_MouseLeftButtonUp"
             MouseMove="Viewer_MouseMove"
             SizeChanged="Viewer_SizeChanged">
    <Grid>
        <Grid.Resources>
            <Border x:Key="MaskSource"
                    Background="Black"
                    CornerRadius="8"
                    Width="{Binding ActualWidth, ElementName=MaskBorder}"
                    Height="{Binding ActualHeight, ElementName=MaskBorder}" />
        </Grid.Resources>

        <Border BorderBrush="{StaticResource GlobalPrimary}"
                BorderThickness="1.5"
                CornerRadius="10"
                Background="White" />

        <Border x:Name="MaskBorder"
                Margin="1.5"
                CornerRadius="8"
                Background="White">

            <Border.OpacityMask>
                <VisualBrush Visual="{StaticResource MaskSource}" />
            </Border.OpacityMask>

            <Grid x:Name="Viewport"
                  Background="White">
                <Canvas x:Name="ImageCanvas"
                        ClipToBounds="True"
                        Width="{Binding ActualWidth, ElementName=Viewport}"
                        Height="{Binding ActualHeight, ElementName=Viewport}">
                    <Image x:Name="EncodedImage"
                           Source="{Binding EncodedImage}"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    <Canvas x:Name="SourceLayer"
                            ClipToBounds="True"
                            Canvas.Left="0"
                            Canvas.Top="0">
                        <Image x:Name="SourceImage"
                               Source="{Binding SourceImage}"
                               Stretch="Fill"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Canvas>

                    <Border x:Name="SplitHandle"
                            Width="2"
                            Background="{StaticResource GlobalSecondary}"
                            Cursor="SizeWE"
                            MouseLeftButtonDown="SplitHandle_MouseLeftButtonDown"
                            MouseLeftButtonUp="SplitHandle_MouseLeftButtonUp"
                            MouseMove="SplitHandle_MouseMove" />
                </Canvas>

                <TextBlock Text="SOURCE"
                           FontSize="80"
                           Foreground="{StaticResource GlobalSecondary}"
                           Opacity="0.75"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="50 0 0 0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SourceImage}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="ENCODE"
                           FontSize="80"
                           Foreground="{StaticResource GlobalSecondary}"
                           Opacity="0.75"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0 0 50 0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EncodedImage}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
