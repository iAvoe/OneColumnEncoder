<UserControl x:Class="OneColumnEncoder.Components.HintPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:OneColumnEncoder.UI"
             x:Name="uc"
             mc:Ignorable="d"
             d:DesignHeight="20"
             d:DesignWidth="400">
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy"
                        Executed="CopyText_Executed" />
    </UserControl.CommandBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Rectangle Width="10"
                   Grid.Column="0"
                   Height="10"
                   VerticalAlignment="Center"
                   Fill="{Binding HintBrush, ElementName=uc}">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameInfo}"
                            Stretch="Uniform" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <TextBlock Grid.Column="1"
                   Text="{Binding Text, ElementName=uc}"
                   FontSize="{Binding FontSize, ElementName=uc}"
                   Foreground="{Binding HintBrush, ElementName=uc}"
                   Margin="3.5 0 0 0"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap">
            <TextBlock.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy"
                              Command="ApplicationCommands.Copy"
                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}" />
                </ContextMenu>
            </TextBlock.ContextMenu>
        </TextBlock>
    </Grid>
</UserControl>
