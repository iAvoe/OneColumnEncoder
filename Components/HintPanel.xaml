<UserControl x:Class="OneColumnEncoder.Components.HintPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
             x:Name="uc"
             mc:Ignorable="d"
             d:DesignHeight="20"
             d:DesignWidth="400">
    <StackPanel Orientation="Horizontal">
        <Rectangle Width="10"
                   Height="10"
                   VerticalAlignment="Center"
                   Fill="{Binding HintBrush, ElementName=uc}">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                            Stretch="Uniform" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <TextBlock Text="{Binding Text, ElementName=uc}"
                   FontSize="{Binding FontSize, ElementName=uc}"
                   Foreground="{Binding HintBrush, ElementName=uc}"
                   Margin="3.5 0 0 0"
                   VerticalAlignment="Center"
                   Focusable="False" />
    </StackPanel>
</UserControl>
