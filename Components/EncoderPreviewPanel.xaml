<UserControl x:Class="OneColumnEncoder.Components.EncoderPreviewPanel"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:comps="clr-namespace:OneColumnEncoder.Components"
              xmlns:ui="clr-namespace:OneColumnEncoder.UI"
              xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
               d:DataContext="{d:DesignInstance Type=vms:ImgABPvVM}"
               mc:Ignorable="d"
               Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding EncoderLabel}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0 0 10 0"
                       Foreground="{StaticResource GlobalPrimary}" />
            <comps:DropdownMenu Grid.Column="1"
                                Height="30"
                                IsEnabled="true"
                                DataContext="{Binding EncoderDropdown}" />

            <TextBlock Grid.Column="2"
                       Text="{Binding StatusText}"
                       FontSize="13"
                       Foreground="{StaticResource GlobalSecondary}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="5 0 0 0" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10 0">

                <TextBlock Text="{Binding ZoomLabel}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}" />

                <Rectangle Width="10" />

                <Button Content="--"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineOut_Click" />

                <Rectangle Width="5" />

                <Button Content="-"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomOut_Click" />

                <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                           Width="55"
                           FontSize="13"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}" />

                <Button Content="+"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomIn_Click" />

                <Rectangle Width="5" />

                <Button Content="++"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineIn_Click" />
            </StackPanel>

            <comps:ThreeButtonGroup Grid.Column="4"
                                    DataContext="{Binding ZoomPresetButtons}"
                                    ButtonHeight="30"
                                    Width="330"
                                    Button1Command="{Binding Cmd1}"
                                    Button2Command="{Binding Cmd2}"
                                    Button3Command="{Binding Cmd3}" />
        </Grid>

        <comps:ImgABPvViewer Grid.Row="1"
                                    x:Name="PreviewViewer"
                                    Margin="0 10 0 10" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding PositionLabel}"
                       FontSize="13"
                       VerticalAlignment="Center" />
            <comps:IntegerSlider Grid.Column="1"
                                  Minimum="0"
                                  Maximum="{Binding MaxPositionSeconds}"
                                  Value="{Binding PreviewPositionSeconds, Mode=TwoWay}"
                                  TickLabels="{Binding PositionTickLabels}"
                                  TickCount="5"
                                  LabelWidth="0"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding IsIdle}" />
        </Grid>

        <Grid Grid.Row="3"
              Margin="0 5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="850" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding DisplayModeLabel}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0 0 10 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <comps:FiveButtonGroup Grid.Column="1"
                                   DataContext="{Binding DisplayModeButtons}"
                                   ButtonHeight="30"
                                   Button1Command="{Binding Cmd1}"
                                   Button2Command="{Binding Cmd2}"
                                   Button3Command="{Binding Cmd3}"
                                   Button4Command="{Binding Cmd4}"
                                   Button5Command="{Binding Cmd5}" />

            <Button Grid.Column="3"
                    Command="{Binding PreviewCommand}"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PrimaryButton}"
                    Background="Black">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Rectangle Width="14"
                               Height="14"
                               VerticalAlignment="Center"
                               Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GamePlay}"
                                        Stretch="Uniform"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{Binding PreviewButtonText}"
                               VerticalAlignment="Center"
                               Margin="5 0 0 0" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="4"
              Margin="0 5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <comps:HintPanel Text="{Binding Hint1Text}"
                                 HintBrush="{StaticResource GlobalSecondary}"
                                 FontSize="10"
                                 Margin="0 10 0 0" />
                <comps:HintPanel Text="{Binding Hint2Text}"
                                 HintBrush="{StaticResource GlobalSecondary}"
                                 FontSize="10"
                                 Margin="0 5 0 0" />
                <comps:HintPanel Text="{Binding Hint3Text}"
                                 HintBrush="{StaticResource GlobalSecondary}"
                                 FontSize="10"
                                 Margin="0 5 0 0" />
                <comps:HintPanel Text="{Binding SsimulacraScoreHint}"
                                  HintBrush="{StaticResource GlobalSecondary}"
                                  FontSize="10"
                                  Margin="0 5 0 0" />
                <comps:HintPanel Text="{Binding ButteraugliScoreHint}"
                                  HintBrush="{StaticResource GlobalSecondary}"
                                  FontSize="10"
                                  Margin="0 5 0 0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right">
                <TextBlock Text="{Binding Ssimulacra2StatusText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           HorizontalAlignment="Right"
                           Margin="2.5 2.5 2.5 1"
                           Background="AliceBlue"
                           Padding="1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="#10739E" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ButteraugliStatusText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           HorizontalAlignment="Right"
                           Margin="2.5 1 2.5 2.5"
                           Background="AliceBlue"
                           Padding="1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="#10739E" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
