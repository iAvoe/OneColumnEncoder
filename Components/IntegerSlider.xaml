<UserControl x:Class="OneColumnEncoder.Components.IntegerSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             mc:Ignorable="d"
             d:DesignHeight="64"
             d:DesignWidth="520">
    <UserControl.Resources>
        <conv:SliderTrackPositionConverter x:Key="SliderTrackPositionConverter" />
        <conv:TickLabelPositionConverter x:Key="TickLabelPositionConverter" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="13" />

        <Grid Grid.Column="2"
              VerticalAlignment="Center"
              Height="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="14" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1"
                  x:Name="TrackHost"
                  VerticalAlignment="Center">
                <Border Height="3"
                        Background="{StaticResource GlobalSecondary}"
                        CornerRadius="2"
                        VerticalAlignment="Center" />
                <Canvas Height="14"
                        VerticalAlignment="Center">
                    <Thumb Width="14"
                           Height="14"
                           Background="Transparent"
                           DragStarted="Thumb_DragStarted"
                           DragDelta="Thumb_DragDelta"
                           DragCompleted="Thumb_DragCompleted"
                           Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid>
                                    <Ellipse Width="13" Height="13" Fill="White" Stroke="{StaticResource GlobalSecondary}" StrokeThickness="2" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                        <Thumb.RenderTransform>
                            <TranslateTransform>
                                <TranslateTransform.X>
                                    <MultiBinding Converter="{StaticResource SliderTrackPositionConverter}">
                                        <Binding ElementName="TrackHost" Path="ActualWidth" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="Minimum" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="Maximum" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="Value" />
                                    </MultiBinding>
                                </TranslateTransform.X>
                            </TranslateTransform>
                        </Thumb.RenderTransform>
                    </Thumb>
                    <Border Padding="6,1"
                            CornerRadius="2"
                            BorderThickness="1"
                            BorderBrush="{StaticResource GlobalSecondary}"
                            Canvas.Top="-20">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource SliderTrackPositionConverter}">
                                <Binding ElementName="TrackHost" Path="ActualWidth" />
                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="Minimum" />
                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="Maximum" />
                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="Value" />
                            </MultiBinding>
                        </Canvas.Left>
                        <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="10"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Canvas>
            </Grid>

            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding TickLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          AlternationCount="1000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource TickLabelPositionConverter}">
                                    <Binding ElementName="TrackHost" Path="ActualWidth" />
                                    <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
                                    <Binding RelativeSource="{RelativeSource Self}" Path="(ItemsControl.AlternationIndex)" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="TickCount" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="10"
                                   Foreground="{StaticResource GlobalSecondary}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
