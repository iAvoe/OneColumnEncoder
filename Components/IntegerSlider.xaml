<UserControl x:Class="OneColumnEncoder.Components.IntegerSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             mc:Ignorable="d"
             d:DesignHeight="50"
             d:DesignWidth="520">
    <!-- Shared converters used to map slider values to visual positions. -->
    <UserControl.Resources>
        <conv:SliderTrackPositionConverter x:Key="SliderTrackPositionConverter" />
        <conv:SliderValuePopupPositionConverter x:Key="SliderValuePopupPositionConverter" />
        <conv:TickLabelPositionConverter x:Key="TickLabelPositionConverter" />
        <conv:SliderZeroDisplayConverter x:Key="SliderZeroDisplayConverter" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left-side label for the slider caption. -->
        <TextBlock x:Name="LabelTextBlock"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Width="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="13" />

        <!-- Right-side slider area with track, thumb, popup value, and tick labels. -->
        <Grid Grid.Column="1"
              VerticalAlignment="Center"
              HorizontalAlignment="Stretch"
              MaxWidth="{Binding SliderMaxWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Height="40"
              Margin="5 0 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="15" />
                <RowDefinition Height="10" />
                <RowDefinition Height="15" />
            </Grid.RowDefinitions>

            <!-- Track host: draws the rail and places the draggable thumb. -->
            <Grid Grid.Row="1"
                  x:Name="TrackHost"
                  VerticalAlignment="Center">
                <Border Height="3"
                        Background="{StaticResource GlobalSecondary}"
                        CornerRadius="2"
                        VerticalAlignment="Center" />
                <Canvas Height="14"
                        VerticalAlignment="Center">
                    <!-- Draggable thumb that follows the current slider value. -->
                    <Thumb Width="14"
                           Height="14"
                           Background="Transparent"
                           DragStarted="Thumb_DragStarted"
                           DragDelta="Thumb_DragDelta"
                           DragCompleted="Thumb_DragCompleted"
                           Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid>
                                    <Ellipse Width="13"
                                             Height="13"
                                             Fill="{StaticResource Background}"
                                             Stroke="{StaticResource GlobalSecondary}"
                                             StrokeThickness="1.5" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                        <Thumb.RenderTransform>
                            <TranslateTransform>
                                <TranslateTransform.X>
                                    <MultiBinding Converter="{StaticResource SliderTrackPositionConverter}">
                                        <Binding ElementName="TrackHost"
                                                 Path="ActualWidth" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                 Path="Minimum" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                 Path="Maximum" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                 Path="Value" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                 Path="IsLogarithmic" />
                                    </MultiBinding>
                                </TranslateTransform.X>
                            </TranslateTransform>
                        </Thumb.RenderTransform>
                    </Thumb>
                    
                    <!-- Floating value popup shown above the thumb. -->
                    <Border Padding="2.5 0.75"
                            CornerRadius="2"
                            Canvas.Top="-18"
                            BorderThickness="1"
                            BorderBrush="{StaticResource ButtonPrimary}"
                            Background="{StaticResource Background}">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource SliderValuePopupPositionConverter}">
                                <Binding ElementName="TrackHost"
                                         Path="ActualWidth" />
                                <Binding RelativeSource="{RelativeSource Self}"
                                         Path="ActualWidth" />
                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                         Path="Minimum" />
                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                         Path="Maximum" />
                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                         Path="Value" />
                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                         Path="IsLogarithmic" />
                            </MultiBinding>
                        </Canvas.Left>
                        <TextBlock FontSize="9"
                                   Foreground="{StaticResource ButtonPrimary}"
                                   HorizontalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SliderZeroDisplayConverter}">
                                 <Binding Path="Value" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                     <Binding Path="ZeroText" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                     <Binding Path="ValueText" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                 </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Tick labels rendered along the bottom of the track. -->
            <ItemsControl Grid.Row="2"
                          Width="{Binding ActualWidth, ElementName=TrackHost}"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding TickLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          AlternationCount="1000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="{Binding ActualWidth, ElementName=TrackHost}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource TickLabelPositionConverter}">
                                    <Binding ElementName="TrackHost"
                                             Path="ActualWidth" />
                                    <Binding RelativeSource="{RelativeSource Self}"
                                             Path="ActualWidth" />
                                    <Binding />
                                    <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                             Path="Minimum" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                             Path="Maximum" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                             Path="IsLogarithmic" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="10"
                                   Foreground="{StaticResource GlobalSecondary}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
