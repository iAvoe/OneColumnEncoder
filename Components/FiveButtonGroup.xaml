<UserControl x:Class="OneColumnEncoder.Components.FiveButtonGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OneColumnEncoder.Components"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="450">
    <UserControl.Resources>
        <conv:ButtonWidthConverter x:Key="ButtonWidthConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                Command="{Binding Button1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding Button1IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ButtonWidthConverter}, ConverterParameter='5,5'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ButtonHeight}"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Style="{StaticResource NormalButton}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Rectangle Width="14"
                           Height="14"
                           Margin="0 0 4 0"
                           VerticalAlignment="Center"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding B5_1Icon}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding B5_1Icon}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding B5_1Text}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button Grid.Column="1"
                Content="{Binding B5_2Text}"
                Command="{Binding Button2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding Button2IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ButtonWidthConverter}, ConverterParameter='5,5'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ButtonHeight}"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryButton}" />
        <Button Grid.Column="2"
                Content="{Binding B5_3Text}"
                Command="{Binding Button3Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding Button3IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ButtonWidthConverter}, ConverterParameter='5,5'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ButtonHeight}"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryButton}" />
        <Button Grid.Column="3"
                Content="{Binding B5_4Text}"
                Command="{Binding Button4Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding Button4IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ButtonWidthConverter}, ConverterParameter='5,5'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ButtonHeight}"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryButton}" />
        <Button Grid.Column="4"
                Command="{Binding Button5Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding Button5IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ButtonWidthConverter}, ConverterParameter='5,5'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ButtonHeight}"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButton}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Rectangle Width="14"
                           Height="14"
                           Margin="0 0 4 0"
                           VerticalAlignment="Center"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding B5_5Icon}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding B5_5Icon}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding B5_5Text}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
