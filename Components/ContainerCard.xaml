<UserControl x:Class="OneColumnEncoder.Components.ContainerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:OneColumnEncoder.ViewModels"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             d:DataContext="{d:DesignInstance Type=comps:DropdownMenu}"
             mc:Ignorable="d"
             d:DesignWidth="450">
    <!--
    | Title      | R1 | R2 |
    | P1                   |
    R1: Import dropdown
    R2: Import button
    P1: ChecklistContainer
    -->
    <Border BorderBrush="{StaticResource GlobalPrimary}"
            BorderThickness="2"
            CornerRadius="20"
            Padding="20"
            Background="{StaticResource Background}">
        <Grid>
            <!-- Title, R1, R2 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Title, P1 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{Binding Name}"
                       Style="{StaticResource H2}" />
            <comps:DropdownMenu Grid.Row="0"
                                Grid.Column="1"
                                DataContext="{Binding ImportDropdown}"/>
            <Button Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" />

            <comps:ChecklistContainer Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      ItemsSource="{Binding ToolsChecklist}">
                <comps:ChecklistContainer.ItemTemplate>
                    <DataTemplate>
                        <comps:ChecklistItem Text="{Binding Text}"
                                             Status="{Binding Status}" />
                    </DataTemplate>
                </comps:ChecklistContainer.ItemTemplate>
            </comps:ChecklistContainer>
        </Grid>
    </Border>
</UserControl>
