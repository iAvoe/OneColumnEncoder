<UserControl x:Class="OneColumnEncoder.Components.MuxTrackItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels.MuxTracks"
             d:DataContext="{d:DesignInstance Type=vms:MuxTrackEntryVM}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border BorderBrush="{StaticResource GlobalPrimary}" BorderThickness="1.5" CornerRadius="8" Padding="8" Margin="0 0 0 6">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="{StaticResource GlobalSecondary}" FontSize="11" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0 6 0 0">
                <TextBlock Text="{Binding DataContext.Lang[MuxTracks.Sync], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" />
                <TextBox Text="{Binding SyncText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6 0 12 0" Padding="2" />
                <CheckBox Content="{Binding DataContext.Lang[MuxTracks.Primary], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding IsDefault}" VerticalAlignment="Center" />
                <Button Content="{Binding MoveUpText}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" Style="{StaticResource LinkButton}" Margin="18 0 0 0" />
                <Button Content="{Binding MoveDownText}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" Style="{StaticResource LinkButton}" />
                <Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Style="{StaticResource LinkButton}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
