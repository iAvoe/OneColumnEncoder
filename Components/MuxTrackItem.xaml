<UserControl x:Class="OneColumnEncoder.Components.MuxTrackItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels.MuxTracks"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             d:DataContext="{d:DesignInstance Type=vms:MuxTrackEntryVM}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             MaxWidth="{Binding Width, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid Margin="0 0 0 5"
          HorizontalAlignment="Stretch"
          MinWidth="0"
          MaxWidth="{Binding Width, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border BorderThickness="1.5"
                CornerRadius="8"
                Padding="12.5 10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource MuxTrackUserBorder}" />
                    <Setter Property="Background"
                            Value="{StaticResource MuxTrackUserBackground}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Model.IsSourceTrack}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource MuxTrackSourceBorder}" />
                            <Setter Property="Background"
                                    Value="{StaticResource MuxTrackSourceBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"
                                   MinHeight="20" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DurationText}"
                               Foreground="{StaticResource GlobalSecondary}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Sync label and textbox -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Set to Primary checkbox and label -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Lang code selection -->
                        <ColumnDefinition Width="135"
                                          MinWidth="80" />
                        <!-- Spacer to push below items right -->
                        <ColumnDefinition Width="*" />
                        <!-- Move order and delete -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding DataContext.Lang[MuxTracks.Sync], RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SyncText, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="SyncTextBox_LostFocus"
                             FontSize="11"
                             Width="50"
                             Margin="4 0 0 0"
                             Padding="0"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextAlignment="Right"/>

                    <CheckBox Grid.Column="2"
                              Content="{Binding DataContext.Lang[MuxTracks.Primary], RelativeSource={RelativeSource AncestorType=Window}}"
                              IsChecked="{Binding IsDefault}"
                              Margin="15 0.5 0 0"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding DataContext.Lang[MuxTracks.Language], RelativeSource={RelativeSource AncestorType=Window}}"
                               Margin="12.5 0 0 0"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="4"
                                        DataContext="{Binding LanguageDropdown}"
                                        Margin="2.5 0 0 0"
                                        VerticalAlignment="Center" />

                    <Border Grid.Column="5" />

                    <Button Grid.Column="6"
                            Content="{Binding MoveUpText}"
                            Command="{Binding MoveUpCommand}"
                            IsEnabled="{Binding CanMoveUp}"
                            Style="{StaticResource LinkButton}"
                            Margin="0" />
                    <Button Grid.Column="7"
                            Content="{Binding MoveDownText}"
                            Command="{Binding MoveDownCommand}"
                            IsEnabled="{Binding CanMoveDown}"
                            Style="{StaticResource LinkButton}"
                            Margin="5 0 0 0" />
                    <Button Grid.Column="8"
                            Content="{Binding RemoveText}"
                            Command="{Binding RemoveCommand}"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource LinkButton}"
                            Margin="5 0 0 0" />
                </Grid>
            </Grid>
        </Border>

        <Border BorderThickness="1.5"
                CornerRadius="8"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                BorderBrush="{StaticResource BorderAmber}"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecentlyMoved, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
