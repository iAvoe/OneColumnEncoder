<UserControl x:Class="OneColumnEncoder.Components.MuxTrackItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels.MuxTracks"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             d:DataContext="{d:DesignInstance Type=vms:MuxTrackEntryVM}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             MaxWidth="{Binding Width, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid Margin="0 0 0 5"
          HorizontalAlignment="Stretch"
          MinWidth="0"
          MaxWidth="{Binding Width, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border BorderThickness="1.5"
                CornerRadius="8"
                Padding="12.5 10 12.5 7.5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource MuxTrackUserBorder}" />
                    <Setter Property="Background"
                            Value="{StaticResource MuxTrackUserBackground}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Model.IsSourceTrack}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource MuxTrackSourceBorder}" />
                            <Setter Property="Background"
                                    Value="{StaticResource MuxTrackSourceBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DurationText}"
                               Foreground="{StaticResource GlobalSecondary}" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0 5 0 0">
                    <Grid.ColumnDefinitions>
                        <!-- Set to Primary checkbox and label -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Lang code selection -->
                        <ColumnDefinition Width="135"
                                          MinWidth="80" />
                        <!-- Spacer to push delete right -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="{Binding DataContext.Lang[MuxTracks.Primary], RelativeSource={RelativeSource AncestorType=Window}}"
                              IsChecked="{Binding IsDefault}"
                              Margin="0 0.5 0 0"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DataContext.Lang[MuxTracks.Language], RelativeSource={RelativeSource AncestorType=Window}}"
                               Margin="12.5 -1 0 0"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="2"
                                        DataContext="{Binding LanguageDropdown}"
                                        Margin="5 -0.5 0 0"
                                        VerticalAlignment="Center" />

                    <Border Grid.Column="3" />

                    <Button Grid.Column="4"
                            Content="{Binding RemoveText}"
                            Command="{Binding RemoveCommand}"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource LinkButton}"
                            Margin="0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
