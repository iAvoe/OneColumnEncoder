<UserControl x:Class="OneColumnEncoder.Components.MemoryRangeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             mc:Ignorable="d"
             d:DesignHeight="20"
             d:DesignWidth="260">
    <UserControl.Resources>
        <conv:MemoryRangeBlockToBrushConverter x:Key="MemoryRangeBlockToBrush" />
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="1"
                             Columns="0" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="{Binding BlockWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Height="20"
                        Margin="0.68 0"
                        CornerRadius="1"
                        ToolTip="{Binding Tooltip}">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource MemoryRangeBlockToBrush}">
                            <Binding Path="Category" />
                            <Binding Path="FillLevel" />
                        </MultiBinding>
                    </Border.Background>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
