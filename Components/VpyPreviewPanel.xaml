<UserControl x:Class="OneColumnEncoder.Components.VpyPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:VspipePreviewVM}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PreviewFilenameText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource GlobalPrimary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="TextWrapping"
                    Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding PreviewSources}"
                      SelectedItem="{Binding SelectedPreviewSource, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      Style="{StaticResource RoundedDropdownMenu}"
                      ToolTip="{Binding SelectedItem.FullPath, RelativeSource={RelativeSource Self}}"
                      MinWidth="150"
                      MaxWidth="200"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="2.5 0 10 0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0 0 5 0">
                <TextBlock Text="Zoom: "
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}" />
                <Button Content="--"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineOut_Click" />
                <Rectangle Width="3" />
                <Button Content="-"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomOut_Click" />
                <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                           Width="55"
                           FontSize="13"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}" />
                <Button Content="+"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomIn_Click" />
                <Rectangle Width="3" />
                <Button Content="++"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineIn_Click" />
                <Rectangle Width="5" />
                <Button Content="Fit"
                        Width="40"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFit_Click" />
                <Rectangle Width="3" />
                <Button Content="100%"
                        Width="50"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="Zoom100_Click" />
                <Rectangle Width="3" />
                <Button Content="200%"
                        Width="50"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="Zoom200_Click" />
            </StackPanel>

            <Button Grid.Column="2"
                    Command="{Binding PreviewCommand}"
                    Content="{Binding PreviewButtonText}"
                    Height="30"
                    Width="100"
                    Style="{StaticResource PrimaryButton}"
                    Background="Black"
                    Margin="0 0 2.5 0"/>
        </Grid>

        <comps:ImgABPvViewer Grid.Row="1"
                             x:Name="PreviewViewer"
                             Margin="0 10 0 10" />

        <Grid Grid.Row="2"
              Margin="0 0 0 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Frame:"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource GlobalPrimary}" />
            <comps:IntegerSlider Grid.Column="1"
                                 Minimum="0"
                                 Maximum="{Binding MaxPositionSeconds}"
                                 Value="{Binding PreviewPositionSeconds, Mode=TwoWay}"
                                 TickLabels="{Binding PositionTickLabels}"
                                 TickCount="5"
                                 LabelWidth="0"
                                 HorizontalAlignment="Stretch"
                                 IsEnabled="{Binding IsIdle}" />
        </Grid>

        <comps:HintPanel Grid.Row="3"
                         Text="{Binding StatusText}"
                         HintBrush="{StaticResource GlobalSecondary}"
                         FontSize="10" />
    </Grid>
</UserControl>
