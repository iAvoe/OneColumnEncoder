<UserControl x:Class="OneColumnEncoder.Components.EncoderAutoParamsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:EncoderConfVM}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding AutoParamsTitle}"
                   Style="{StaticResource H2}" />

        <TabControl Grid.Row="1"
                    Margin="0 10 0 0">

            <TabItem Header="{Binding X264Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="10 5 0 5">
                    <comps:IntegerSliderGroup>
                        <comps:IntegerSlider Label="{Binding AutoLookaheadText}"
                                             Minimum="100"
                                             Maximum="300"
                                             Step="10"
                                             Value="{Binding X264AutoLookaheadPercent, Mode=TwoWay}"
                                             ValueText="{Binding X264LookaheadDisplay, Mode=OneWay}"
                                             TickLabels="{Binding AutoLookaheadLabels}"
                                             TickLabelValues="{Binding AutoLookaheadValues}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:HintPanel Text="{Binding AutoLookaheadHint, Mode=OneWay}"
                                         Margin="5 2.5 5 0"
                                         FontWeight="Normal"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                        <comps:HintPanel Text="{Binding AutoFixedMappingHint, Mode=OneWay}"
                                         Margin="5 2.5 5 0"
                                         FontWeight="Normal"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                    </comps:IntegerSliderGroup>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding X265Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="10 5 0 5">
                    <comps:IntegerSliderGroup>
                        <comps:IntegerSlider Label="{Binding AutoLookaheadText}"
                                             Minimum="100"
                                             Maximum="300"
                                             Step="10"
                                             Value="{Binding X265AutoLookaheadPercent, Mode=TwoWay}"
                                             ValueText="{Binding X265LookaheadDisplay, Mode=OneWay}"
                                             TickLabels="{Binding AutoLookaheadLabels}"
                                             TickLabelValues="{Binding AutoLookaheadValues}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:HintPanel Text="{Binding AutoLookaheadHint, Mode=OneWay}"
                                         Margin="5 2.5 5 0"
                                         FontWeight="Normal"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />

                        <TextBlock Text="{Binding AutoMerangeText}"
                                   Style="{StaticResource H3}"
                                   Margin="0 10 0 2" />
                        <comps:IntegerSlider Label="≥4K"
                                             Minimum="4"
                                             Maximum="128"
                                             Value="{Binding X265AutoMerange4K, Mode=TwoWay}"
                                             TickLabels="{Binding AutoMerangeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:IntegerSlider Label="≥1440p"
                                             Minimum="4"
                                             Maximum="128"
                                             Value="{Binding X265AutoMerange1440P, Mode=TwoWay}"
                                             TickLabels="{Binding AutoMerangeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:IntegerSlider Label="≥1080p"
                                             Minimum="4"
                                             Maximum="128"
                                             Value="{Binding X265AutoMerange1080P, Mode=TwoWay}"
                                             TickLabels="{Binding AutoMerangeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:IntegerSlider Label="≥720p"
                                             Minimum="4"
                                             Maximum="128"
                                             Value="{Binding X265AutoMerange720P, Mode=TwoWay}"
                                             TickLabels="{Binding AutoMerangeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:IntegerSlider Label="&lt;720p"
                                             Minimum="4"
                                             Maximum="128"
                                             Value="{Binding X265AutoMerangeSd, Mode=TwoWay}"
                                             TickLabels="{Binding AutoMerangeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:HintPanel Text="{Binding AutoMerangeHint, Mode=OneWay}"
                                         Margin="5 2.5 5 0"
                                         FontWeight="Normal"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />

                        <TextBlock Text="{Binding AutoSubmeText}"
                                   Style="{StaticResource H3}"
                                   Margin="0 10 0 2" />
                        <comps:IntegerSlider Label="&lt;25 fps"
                                             Minimum="0"
                                             Maximum="7"
                                             Value="{Binding X265AutoSubmeUnder25, Mode=TwoWay}"
                                             TickLabels="{Binding AutoSubmeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:IntegerSlider Label="&lt;49 fps"
                                             Minimum="0"
                                             Maximum="7"
                                             Value="{Binding X265AutoSubmeUnder49, Mode=TwoWay}"
                                             TickLabels="{Binding AutoSubmeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:IntegerSlider Label="&lt;61 fps"
                                             Minimum="0"
                                             Maximum="7"
                                             Value="{Binding X265AutoSubmeUnder61, Mode=TwoWay}"
                                             TickLabels="{Binding AutoSubmeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:IntegerSlider Label="≥61 fps"
                                             Minimum="0"
                                             Maximum="7"
                                             Value="{Binding X265AutoSubmeAtLeast61, Mode=TwoWay}"
                                             TickLabels="{Binding AutoSubmeLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="430"
                                             Margin="0 2.5"
                                             HorizontalAlignment="Stretch"
                                             FontWeight="Normal" />
                        <comps:HintPanel Text="{Binding AutoSubmeHint, Mode=OneWay}"
                                         Margin="5 2.5 5 0"
                                         FontWeight="Normal"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                        <comps:HintPanel Text="{Binding AutoFixedMappingHint, Mode=OneWay}"
                                         Margin="5 2.5 5 0"
                                         FontWeight="Normal"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                    </comps:IntegerSliderGroup>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding SvtAv1Text}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="10 5 0 5">
                    <comps:HintPanel Text="{Binding AutoNoAdjustHint, Mode=OneWay}"
                                     Margin="5 5 5 0"
                                     FontWeight="Normal"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
