<UserControl x:Class="OneColumnEncoder.Components.TwoButtonGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OneColumnEncoder.Components"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             xmlns:viewmodels="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ButtonGroupVM}"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="450">
    <UserControl.Resources>
        <conv:ButtonWidthConverter x:Key="ButtonWidthConverter" />
        <Style x:Key="HighlightablePrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Button2Highlight, RelativeSource={RelativeSource AncestorType=local:TwoButtonGroup}}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource BorderAmber}" />
                    <Setter Property="Background"
                            Value="{StaticResource BackgroundAmber}" />
                    <Setter Property="Foreground"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="BorderThickness"
                            Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Button2TextStyle"
               TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Button2Strikethrough, RelativeSource={RelativeSource AncestorType=local:TwoButtonGroup}}"
                             Value="True">
                    <Setter Property="TextDecorations"
                            Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0"
                Command="{Binding Button1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding Button1IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ButtonWidthConverter}, ConverterParameter='2,5'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ButtonHeight}"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Style="{StaticResource NormalButton}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Rectangle Width="14"
                           Height="14"
                           Margin="0 0 4 0"
                           VerticalAlignment="Center"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding B2_1Icon}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding B2_1Icon}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <!-- FontSize by App.xaml -->
                <TextBlock Text="{Binding B2_1Text}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button Grid.Column="1"
                Command="{Binding Button2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding Button2IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ButtonWidthConverter}, ConverterParameter='2,5'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ButtonHeight}"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Style="{StaticResource HighlightablePrimaryButton}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Rectangle Width="14"
                           Height="14"
                           Margin="0 0 4 0"
                           VerticalAlignment="Center"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding B2_2Icon}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding B2_2Icon}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding B2_2Text}"
                           Style="{StaticResource Button2TextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
