<UserControl x:Class="OneColumnEncoder.Components.ToolsImportCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             xmlns:ui="clr-namespace:OneColumnEncoder.UI"
             xmlns:cards="clr-namespace:OneColumnEncoder.ViewModels.Cards"
             d:DataContext="{d:DesignInstance Type=cards:ToolsImportCardVM}"
             mc:Ignorable="d"
             d:DesignWidth="450">
    <UserControl.Resources>
        <conv:WidthToColumnCountConverter x:Key="WidthToColumnCount" />
        <Style x:Key="ToolsImportCardToggleButton"
               TargetType="Button"
               BasedOn="{StaticResource LinkButton}">
            <Setter Property="Content"
                    Value=" &#x25BC;&#x25BC; " />
            <Setter Property="MinWidth"
                    Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter Property="Content"
                            Value=" &#x25B6;&#x25B6; " />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!--
    | Title | Import dropdown | Import button | Toggle |
    | P1: ChecklistContainer |
    -->
    <Grid>
        <!-- Shadow stays on a separate layer so text and buttons remain sharp. -->
        <Border BorderBrush="{StaticResource GlobalPrimary}"
                BorderThickness="1.5"
                CornerRadius="18"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="13"
                                              ShadowDepth="3"
                                              Opacity="0.4"
                                              Color="Black" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Style>
        </Border>

        <!-- Content layer keeps the original card layout and state styling. -->
        <Border CornerRadius="18"
                Padding="17.5 20"
                SnapsToDevicePixels="True"
                Background="{StaticResource Background}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="BorderThickness"
                            Value="1.5" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    Value="0.85" />
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource GlobalTertiary}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding Name}"
                           Style="{StaticResource H2}" />

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Command="{Binding ToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Tag="{Binding ToggleTag, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        ToolTip="{Binding ToggleToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        VerticalAlignment="Center"
                        Focusable="False"
                        KeyboardNavigation.IsTabStop="False"
                        Margin="5 0 0 0"
                        Style="{StaticResource ToolsImportCardToggleButton}" />
                 
                <!-- Import dropdown -->
                <comps:DropdownMenu Grid.Row="0"
                                     Grid.Column="1"
                                     MinWidth="180"
                                     Height="25"
                                     Margin="0 0 5 0"
                                     DataContext="{Binding ImportDropdown}" />
                  
                <!-- Import button -->
                <Button Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="90"
                        Height="25"
                        VerticalAlignment="Center"
                        Margin="0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Rectangle Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameImport}"
                                            Stretch="Uniform"
                                            AlignmentX="Center"
                                            AlignmentY="Center" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="/"
                                   FontWeight="Black"
                                   VerticalAlignment="Center"
                                   Margin="5 0 0 0"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Rectangle Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Margin="5 0 0 0"
                                   Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameReplace}"
                                            Stretch="Uniform"
                                            AlignmentX="Center"
                                            AlignmentY="Center" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </StackPanel>
                </Button>

                <UniformGrid Grid.Row="1"
                             Grid.ColumnSpan="4"
                             Columns="{Binding ActualWidth,
                                        RelativeSource={RelativeSource FindAncestor,
                                                                       AncestorType={x:Type ScrollViewer}},
                                        Converter={StaticResource WidthToColumnCount}}">
                    <comps:ChecklistContainer ItemsSource="{Binding Checklist1}">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Margin="0 10 0 0" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>

                    <comps:ChecklistContainer ItemsSource="{Binding Checklist2}">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Margin="0 10 0 0" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>
                </UniformGrid>

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Grid.ColumnSpan="2"
                           Text="{Binding Version}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           FontSize="12"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 -15 5 0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
