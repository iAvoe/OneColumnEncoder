<UserControl x:Class="OneColumnEncoder.Components.ToolsImportCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
             xmlns:cards="clr-namespace:OneColumnEncoder.ViewModels.Cards"
             d:DataContext="{d:DesignInstance Type=cards:ToolsImportCardVM}"
             mc:Ignorable="d"
             d:DesignWidth="450">
    <!--
    | Title        | R1 | R2 |
    | P1: ChecklistContainer |
    R1: Import dropdown
    R2: Import button
    -->
    <Grid>
        <!-- Shadow stays on a separate layer so text and buttons remain sharp. -->
        <Border BorderBrush="{StaticResource GlobalPrimary}"
                BorderThickness="1.5"
                CornerRadius="20"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10"
                                              ShadowDepth="2"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14"
                                                      ShadowDepth="3"
                                                      Opacity="0.26"
                                                      Color="#000000" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Content layer keeps the original card layout and state styling. -->
        <Border BorderBrush="{StaticResource GlobalPrimary}"
                BorderThickness="1.5"
                SnapsToDevicePixels="True"
                CornerRadius="20"
                Padding="17.5 20"
                Background="{StaticResource Background}">
            <Grid>
                <!-- Title, R1, R2 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Title, P1 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Top"
                           Text="{Binding Name}"
                           Style="{StaticResource H2}" />
                
                <!-- Import dropdown -->
                <comps:DropdownMenu Grid.Row="0"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    Height="25"
                                    Margin="0 0 5 0"
                                    DataContext="{Binding ImportDropdown}" />
                
                <!-- Import button -->
                <Button Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="90"
                        Height="25"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Rectangle Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameImport}"
                                            Stretch="Uniform"
                                            AlignmentX="Center"
                                            AlignmentY="Center" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="/"
                                   FontWeight="Black"
                                   VerticalAlignment="Center"
                                   Margin="5 0 0 0"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Rectangle Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Margin="5 0 0 0"
                                   Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameReplace}"
                                            Stretch="Uniform"
                                            AlignmentX="Center"
                                            AlignmentY="Center" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </StackPanel>
                </Button>

                <comps:ChecklistContainer Grid.Row="1"
                                          Grid.ColumnSpan="3"
                                          ItemsSource="{Binding ToolsChecklist}">
                    <comps:ChecklistContainer.ItemTemplate>
                        <DataTemplate>
                            <comps:ChecklistItem Text="{Binding Text}"
                                                 Status="{Binding Status}"
                                                 Margin="0 10 0 0" />
                        </DataTemplate>
                    </comps:ChecklistContainer.ItemTemplate>
                </comps:ChecklistContainer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
