<UserControl x:Class="OneColumnEncoder.Components.Cards.MiniToolsImportCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:cards="clr-namespace:OneColumnEncoder.ViewModels.Cards"
             xmlns:ui="clr-namespace:OneColumnEncoder.UI"
             d:DataContext="{d:DesignInstance Type=cards:ToolsImportCardVM}"
             mc:Ignorable="d"
             d:DesignWidth="450"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="MiniToolsImportTitle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>
        <Style x:Key="MiniToolsImportToggleButton"
               TargetType="Button"
               BasedOn="{StaticResource LinkButton}">
            <Setter Property="Content"
                    Value=" &#x25BC;&#x25BC; " />
            <Setter Property="MinWidth"
                    Value="32" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Padding"
                    Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter Property="Content"
                            Value=" &#x25B6;&#x25B6; " />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type comps:ChecklistItem}">
            <Setter Property="Foreground"
                    Value="{StaticResource ButtonPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type comps:ChecklistItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="IconMask"
                                       Grid.Column="0"
                                       Width="12"
                                       Height="12"
                                       VerticalAlignment="Center"
                                       Fill="{TemplateBinding Foreground}"
                                       Margin="0 0 4 0">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameWaiting}"
                                                Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Grid.Column="1"
                                        Text="{TemplateBinding Text}"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{TemplateBinding Foreground}"
                                        TextWrapping="Wrap" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="comps:ChecklistItem.Status"
                                     Value="Waiting">
                                <Setter Property="Foreground"
                                        Value="{StaticResource ButtonPrimary}" />
                                <Setter TargetName="IconMask"
                                        Property="OpacityMask">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameWaiting}"
                                                    Stretch="Uniform" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="comps:ChecklistItem.Status"
                                     Value="Success">
                                <Setter Property="Foreground"
                                        Value="{StaticResource CorrectTeal}" />
                                <Setter TargetName="IconMask"
                                        Property="OpacityMask">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameCorrectMark}"
                                                    Stretch="Uniform" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="comps:ChecklistItem.Status"
                                     Value="Warning">
                                <Setter Property="Foreground"
                                        Value="{StaticResource WarningOrange}" />
                                <Setter TargetName="IconMask"
                                        Property="OpacityMask">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameWarning}"
                                                    Stretch="Uniform" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="comps:ChecklistItem.Status"
                                     Value="Error">
                                <Setter Property="Foreground"
                                        Value="{StaticResource ErrorRed}" />
                                <Setter TargetName="IconMask"
                                        Property="OpacityMask">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GameXMark}"
                                                    Stretch="Uniform" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border BorderThickness="1.5"
                CornerRadius="13"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1.5"
                                              Opacity="0.26"
                                              Color="Black" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Style>
        </Border>

        <Border BorderThickness="1.5"
                CornerRadius="13"
                Padding="14 15"
                SnapsToDevicePixels="True"
                Opacity="{Binding CardOpacity}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{StaticResource GlobalPrimary}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    Value="0.65" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               Style="{StaticResource MiniToolsImportTitle}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Command="{Binding ToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Tag="{Binding ToggleTag, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            ToolTip="{Binding ToggleToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 0 0 0"
                            Style="{StaticResource MiniToolsImportToggleButton}" />
                </Grid>

                <UniformGrid Grid.Row="1"
                             Columns="2"
                             Margin="0 6 0 0">
                    <comps:ChecklistContainer ItemsSource="{Binding Checklist1}"
                                              Margin="0 0 10 0">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Margin="0 6 0 0" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>

                    <comps:ChecklistContainer ItemsSource="{Binding Checklist2}"
                                              Margin="10 0 0 0">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Margin="0 6 0 0" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
