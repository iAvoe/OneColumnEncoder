<UserControl x:Class="OneColumnEncoder.Components.Cards.CPUNodeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels.Cards"
             d:DataContext="{d:DesignInstance Type=vms:CPUNodeCardVM}"
             mc:Ignorable="d"
             d:DesignHeight="100"
             d:DesignWidth="150">
    <Border BorderThickness="2"
            SnapsToDevicePixels="True"
            CornerRadius="8"
            Padding="8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush"
                        Value="{StaticResource GlobalPrimary}" />
                <Setter Property="Background"
                        Value="{StaticResource Background}" />
                <Setter Property="TextElement.Foreground"
                        Value="{StaticResource GlobalPrimary}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="BorderBrush"
                                Value="{StaticResource BorderGreen}" />
                        <Setter Property="Background"
                                Value="{StaticResource BackgroundGreen}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="False">
                        <Setter Property="BorderBrush"
                                Value="{StaticResource GlobalSecondary}" />
                        <Setter Property="TextElement.Foreground"
                                Value="{StaticResource GlobalSecondary}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Opacity"
                                Value="0.7" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <!-- Section 1: NodeId and GroupId -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 4">
                <TextBlock Text="Node " FontWeight="Bold" />
                <TextBlock Text="{Binding NodeId}" FontWeight="Bold" Margin="0 0 4 0" />
                <TextBlock Text=" (Group " FontWeight="Bold" />
                <TextBlock Text="{Binding GroupId}" FontWeight="Bold" />
                <TextBlock Text=")" FontWeight="Bold" />
            </StackPanel>
            <!-- Divider -->
            <Rectangle Height="1" Fill="{StaticResource GlobalTertiary}" Margin="0 4" />
            <!-- Section 2: small gray text under the card -->
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource GlobalSecondary}">
                <Run Text="Threads: " />
                <Run Text="{Binding MinThreadNum}" />
                <Run Text="-" />
                <Run Text="{Binding MaxThreadNum}" />
                <Run Text=", " />
                <Run Text="Memory: " />
                <Run Text="{Binding HasMemGB}" />
                <Run Text=" GB" />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>