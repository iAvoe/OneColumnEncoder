<UserControl x:Class="OneColumnEncoder.Components.Cards.MiniItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:QueueJobItemVM}"
             mc:Ignorable="d"
             d:DesignHeight="55"
             d:DesignWidth="270"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <conv:NullOrWhiteSpaceToPlaceholderConverter x:Key="NullOrWhiteSpaceToPlaceholderConverter" />
        <Style x:Key="MiniPrimaryText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12" />
            <Style.Triggers>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniSecondaryText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Foreground"
                    Value="{StaticResource ButtonPrimary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="1">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="2">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="3">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="4">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground4}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="False">
                    <Setter Property="Foreground"
                            Value="{StaticResource GlobalSecondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniLinkButton"
               TargetType="Button"
               BasedOn="{StaticResource H3C}">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{StaticResource GlobalPrimary}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="MinWidth"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Margin="{TemplateBinding Margin}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="1">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="2">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="3">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="4">
                    <Setter Property="Foreground"
                            Value="{StaticResource RemixedForeground4}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.7" />
                    <Setter Property="BorderBrush"
                            Value="AliceBlue" />
                </Trigger>
                <Trigger Property="IsFocused"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource BorderGreen}" />
                </Trigger>
                <Trigger Property="IsCancel"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource BorderRed}" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{StaticResource GlobalSecondary}" />
                    <Setter Property="Cursor"
                            Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
    Two-layer technique: a dedicated shadow border sits behind the content border.
    This avoids DropShadowEffect being applied to the content layer, which would
    blur text and UI elements (WPF renders Effect on the entire visual tree of the
    element it is attached to). IsHitTestVisible="False" ensures the shadow layer
    never intercepts mouse input.
    -->
    <Grid>
        <!-- Shadow layer: transparent background, no hit-test, carries only the effect. -->
        <Border BorderThickness="1"
                CornerRadius="7"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1.5"
                                              Opacity="0.26"
                                              Color="Black" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="1">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="2">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder2}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground2}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="3">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder3}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground3}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="4">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder4}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground4}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}" />
                            <Setter Property="Background"
                                    Value="{StaticResource BackgroundGreen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCancel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource BorderRed}" />
                            <Setter Property="Background"
                                    Value="{StaticResource BackgroundRed}" />
                        </DataTrigger>
                        <!-- Strengthen the shadow on hover for a subtle lift feedback. -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.4"
                                                      Color="Black" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Content layer: holds the actual card layout with no Effect so text stays sharp. -->
        <Border BorderThickness="1"
                CornerRadius="7"
                Padding="9 7"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{StaticResource GlobalPrimary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="1">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="2">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder2}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground2}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground2}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="3">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder3}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground3}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground3}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="4">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder4}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground4}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground4}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}" />
                            <Setter Property="Background"
                                    Value="{StaticResource BackgroundGreen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCancel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource BorderRed}" />
                            <Setter Property="Background"
                                    Value="{StaticResource BackgroundRed}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="False">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource GlobalSecondary}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource GlobalSecondary}" />
                        </DataTrigger>
                        <!-- Fade content slightly on hover; the shadow layer handles the elevation cue. -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    Value="0.65" />
                            <Setter Property="BorderBrush"
                                    Value="AliceBlue" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"
                                      MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      VerticalAlignment="Center"
                      MinWidth="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Bold"
                               Style="{StaticResource MiniPrimaryText}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding P1Text, Converter={StaticResource NullOrWhiteSpaceToPlaceholderConverter}}"
                               Style="{StaticResource MiniSecondaryText}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Stretch" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowActionButtons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="{Binding DisplayR1Text}"
                            Command="{Binding R1Command}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IsEnabled="{Binding R1IsEnabled}"
                            Focusable="False"
                            Style="{StaticResource MiniLinkButton}" />
                    <Button Content="{Binding R2Text}"
                            Command="{Binding R2Command}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IsEnabled="{Binding R2IsEnabled}"
                            Margin="2.5 0 0 0"
                            Focusable="False"
                            Style="{StaticResource MiniLinkButton}" />
                    <Button Content="{Binding R3Text}"
                            Command="{Binding R3Command}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IsEnabled="{Binding R3IsEnabled}"
                            Margin="2.5 0 0 0"
                            Focusable="False"
                            Style="{StaticResource MiniLinkButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border BorderThickness="1.5"
                CornerRadius="7"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                BorderBrush="{StaticResource BorderAmber}"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecentlyMoved, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
