<UserControl x:Class="OneColumnEncoder.Components.Cards.MiniItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:QueueJobItemVM}"
             mc:Ignorable="d"
             d:DesignHeight="55"
             d:DesignWidth="270"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="MiniLinkButton"
               TargetType="Button"
               BasedOn="{StaticResource H3C}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource GlobalPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Margin="{TemplateBinding Margin}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource GlobalSecondary}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BorderGreen}" />
                </Trigger>
                <Trigger Property="IsCancel" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BorderRed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
    Two-layer technique: a dedicated shadow border sits behind the content border.
    This avoids DropShadowEffect being applied to the content layer, which would
    blur text and UI elements (WPF renders Effect on the entire visual tree of the
    element it is attached to). IsHitTestVisible="False" ensures the shadow layer
    never intercepts mouse input.
    -->
    <Grid>
        <!-- Shadow layer: transparent background, no hit-test, carries only the effect. -->
        <Border BorderThickness="1"
                CornerRadius="7"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background" Value="{StaticResource Background}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1.5"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecentlyMoved}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderAmber}" />
                            <Setter Property="Background" Value="{StaticResource BackgroundAmber}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderGreen}" />
                            <Setter Property="Background" Value="{StaticResource BackgroundGreen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCancel, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderRed}" />
                            <Setter Property="Background" Value="{StaticResource BackgroundRed}" />
                        </DataTrigger>
                        <!-- Strengthen the shadow on hover for a subtle lift feedback. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.26"
                                                      Color="#000000" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Content layer: holds the actual card layout with no Effect so text stays sharp. -->
        <Border BorderThickness="1"
                CornerRadius="7"
                Padding="6 5"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background" Value="{StaticResource Background}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource GlobalPrimary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecentlyMoved}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderAmber}" />
                            <Setter Property="Background" Value="{StaticResource BackgroundAmber}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderGreen}" />
                            <Setter Property="Background" Value="{StaticResource BackgroundGreen}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCancel, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderRed}" />
                            <Setter Property="Background" Value="{StaticResource BackgroundRed}" />
                        </DataTrigger>
                        <!-- Fade content slightly on hover; the shadow layer handles the elevation cue. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  VerticalAlignment="Center"
                  MinWidth="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}"
                            FontWeight="Bold"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="1"
                           Text="{Binding P1Text}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Stretch" />
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="{Binding DisplayR1Text}"
                        Command="{Binding R1Command}"
                        IsEnabled="{Binding R1IsEnabled}"
                        FontSize="10"
                        Focusable="False"
                        Style="{StaticResource MiniLinkButton}" />
                <Button Content="{Binding R2Text}"
                        Command="{Binding R2Command}"
                        IsEnabled="{Binding R2IsEnabled}"
                        FontSize="10"
                        Margin="2.5 0 0 0"
                        Focusable="False"
                        Style="{StaticResource MiniLinkButton}" />
                <Button Content="{Binding R3Text}"
                        Command="{Binding R3Command}"
                        IsEnabled="{Binding R3IsEnabled}"
                        FontSize="10"
                        Margin="2.5 0 0 0"
                        Focusable="False"
                        Style="{StaticResource MiniLinkButton}" />
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</UserControl>
