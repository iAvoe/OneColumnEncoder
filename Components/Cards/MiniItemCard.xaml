<UserControl x:Class="OneColumnEncoder.Components.Cards.MiniItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:QueueJobItemVM}"
             mc:Ignorable="d"
             d:DesignHeight="55"
             d:DesignWidth="280"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </UserControl.Resources>
    <Border BorderThickness="1.5" CornerRadius="8" Padding="8 5" SnapsToDevicePixels="True" HorizontalAlignment="Stretch">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GlobalPrimary}" />
                <Setter Property="Background" Value="{StaticResource Background}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource GlobalPrimary}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderGreen}" />
                        <Setter Property="Background" Value="{StaticResource BackgroundGreen}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCancel, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderRed}" />
                        <Setter Property="Background" Value="{StaticResource BackgroundRed}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Source filename + Status -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           FontWeight="Bold" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding P1Text}"
                           FontSize="11"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center"
                           Margin="4 0 0 0" />
            </Grid>

            <!-- Row 1: Output filename + action buttons -->
            <Grid Grid.Row="1" Margin="0 2 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding P2Text}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="4 0 0 0">
                    <Button Content="{Binding DisplayR1Text}"
                            Command="{Binding R1Command}"
                            Style="{StaticResource LinkButton}"
                            FontSize="10"
                            Focusable="False"
                            Visibility="{Binding DisplayR1Text, Converter={StaticResource StringToVisibility}}" />
                    <Button Content="{Binding R2Text}"
                            Command="{Binding R2Command}"
                            Style="{StaticResource LinkButton}"
                            FontSize="10"
                            Focusable="False"
                            Margin="4 0 0 0"
                            Visibility="{Binding R2Text, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
