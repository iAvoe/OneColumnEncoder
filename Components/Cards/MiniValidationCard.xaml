<UserControl x:Class="OneColumnEncoder.Components.Cards.MiniValidationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:cards="clr-namespace:OneColumnEncoder.ViewModels.Cards"
             d:DataContext="{d:DesignInstance Type=cards:ValidationCardBaseVM}"
             mc:Ignorable="d"
             d:DesignWidth="270"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="MiniValidationTitle"
               TargetType="TextBlock"
               BasedOn="{StaticResource H3}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                    <Setter Property="FontSize"
                            Value="14" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniValidationToggleButton"
               TargetType="Button"
               BasedOn="{StaticResource LinkButton}">
            <Setter Property="Content"
                    Value=" &#x25BC;&#x25BC; " />
            <Setter Property="MinWidth"
                    Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter Property="Content"
                            Value=" &#x25B6;&#x25B6; " />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Shadow layer: transparent background, no hit-test, carries only the effect. -->
        <Border BorderThickness="1"
                CornerRadius="7"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1.5"
                                              Opacity="0.26"
                                              Color="Black" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="1">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="2">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder2}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground2}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="3">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder3}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground3}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="4">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder4}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground4}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.4"
                                                      Color="Black" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Content layer: holds the actual card layout with no Effect so text stays sharp. -->
        <Border BorderThickness="1"
                CornerRadius="7"
                Padding="6 5"
                SnapsToDevicePixels="True"
                Opacity="{Binding CardOpacity}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GlobalPrimary}" />
                    <Setter Property="Background"
                            Value="{StaticResource Background}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{StaticResource GlobalPrimary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="1">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="2">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder2}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground2}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground2}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="3">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder3}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground3}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground3}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PaletteIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="4">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource RemixedBorder4}" />
                            <Setter Property="Background"
                                    Value="{StaticResource RemixedBackground4}" />
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource RemixedForeground4}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    Value="0.65" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"
                                          MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource MiniValidationTitle}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Command="{Binding ToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Tag="{Binding ToggleTag, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            ToolTip="{Binding ToggleToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 0 0 0"
                            Style="{StaticResource MiniValidationToggleButton}" />
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="0 4 0 0">
                    <TextBlock Text="{Binding P1Name}"
                               Style="{StaticResource H4}" />
                    <comps:ChecklistContainer ItemsSource="{Binding Checklist1}">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     Margin="0 5 0 0" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>

                    <TextBlock Text="{Binding P3Name}"
                               Style="{StaticResource H4}"
                               Margin="0 5 0 0" />
                    <comps:ChecklistContainer ItemsSource="{Binding Checklist2}">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     Margin="0 5 0 0" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
