<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="AppendGitCommitCount" AfterTargets="CoreGenerateAssemblyInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-list --count HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          Condition="'$(GitCommitCount)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>

    <PropertyGroup>
      <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
    </PropertyGroup>

    <WriteLinesToFile File="$(GeneratedAssemblyInfoFile)"
                      Lines="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;GitCommitCount&quot;, &quot;$(GitCommitCount)&quot;)]"
                      Overwrite="false" />
  </Target>

  <ItemGroup>
    <Resource Include="favicon.ico" />
  </ItemGroup>

</Project>
