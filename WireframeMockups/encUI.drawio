          <mxGeometry height="20" width="540" x="380" y="5000" as="geometry" />
        </mxCell>
        <mxCell id="IYs4aYTg9IDFscR6ozX7-507" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;b&gt;自定义参数&lt;/b&gt;" vertex="1">
