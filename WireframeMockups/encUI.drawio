          <mxGeometry height="40" width="120" x="120" y="4380" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--464" parent="1" style="dashed=0;labelPosition=right;align=left;shape=mxgraph.gmdl.checkbox;strokeColor=none;fillColor=#009587;strokeWidth=2;aspect=fixed;sketch=0;html=1;" value="" vertex="1">
          <mxGeometry height="20" width="20" x="499" y="4640" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--465" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="优先使用性能核心（P-Core）" vertex="1">
          <mxGeometry height="20" width="510" x="-20" y="4640" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--466" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="若上游程序使用了高占用滤镜且视频源内容复杂，则上下游各占一个节点的压制理论速度更快（算力瓶颈），否则共用节点更快（通信瓶颈）" vertex="1">
          <mxGeometry height="40" width="540" x="-20" y="4500" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--467" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=0;strokeColor=default;align=left;spacingLeft=10;fontSize=16;whiteSpace=wrap;rounded=0;strokeWidth=1;fillColor=#FAFAFA;overflow=hidden;fontColor=#111111;" value="" vertex="1">
          <mxGeometry height="1110" width="580" x="-40" y="4930" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--468" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=#343A40;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontStyle=0;fontColor=#FAFAFA;labelBackgroundColor=none;labelBorderColor=none;spacing=5;" value="编码器参数自定义" vertex="1">
          <mxGeometry height="30" width="580" x="-40" y="4900" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--469" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=default;strokeWidth=1;fillColor=#F8F9FA;fontColor=#000000;whiteSpace=wrap;align=center;verticalAlign=middle;spacingLeft=0;fontStyle=0;fontSize=16;spacing=5;" value="取消" vertex="1">
          <mxGeometry height="30" width="260" x="-20" y="5987" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--470" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#343A40;strokeWidth=1;fillColor=#343A40;fontColor=#ffffff;whiteSpace=wrap;align=center;verticalAlign=middle;spacingLeft=0;fontStyle=0;fontSize=16;spacing=5;" value="确认" vertex="1">
          <mxGeometry height="30" width="260" x="260" y="5987" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--471" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=0;strokeColor=default;align=left;spacingLeft=10;fontSize=16;whiteSpace=wrap;rounded=0;strokeWidth=1;fillColor=#FAFAFA;overflow=hidden;fontColor=#111111;" value="" vertex="1">
          <mxGeometry height="1410" width="700" x="-100" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--472" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=#343A40;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontStyle=0;fontColor=#FAFAFA;labelBackgroundColor=none;labelBorderColor=none;spacing=5;" value="使用与合规" vertex="1">
          <mxGeometry height="30" width="700" x="-100" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--473" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="本程序严格遵循自上而下、从左到右的操作顺序——确认按钮皆位于右侧。" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--474" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;使用与合规&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--475" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;为什么「开始编码」按钮不可用&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--476" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&amp;nbsp; 1. 在 ⚙️ 设置中关闭基于硬件的禁用选项&lt;br&gt;&amp;nbsp; 2. 视频源—朽木不可雕也（但大多数情况并不会禁用）&lt;br&gt;&amp;nbsp; 3. 编码损坏的视频在极少数情况下可能导致电脑崩溃（蓝屏）" vertex="1">
          <mxGeometry height="60" width="660" x="-80" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--477" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;如何使用本程序&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--478" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="开始使用的最简单方法是：" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--479" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&amp;nbsp; 1. 导入并点选上游工具（ffmpeg、vspipe、avs2yuv 等）&lt;br&gt;&amp;nbsp; 2. 导入并点选编码器/下游工具（x264、x265 等）&lt;br&gt;&amp;nbsp; 3. 导入源视频文件&lt;br&gt;&amp;nbsp; 4. 选择编码设置（将验证兼容性与健康状态）&lt;br&gt;&amp;nbsp; 5. 清除检查清单并开始" vertex="1">
          <mxGeometry height="100" width="660" x="-80" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--480" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;b&gt;用户有责任确保其所在地区的软件许可证、编解码器专利、媒体格式和字体许可证的合规性。&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--481" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;手动指定—第三方扩展参数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="2490" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--482" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;· 基础参数：帧率、分辨率、总帧数、矩阵格式、传输特质、原色色系&lt;/div&gt;&lt;div&gt;· 编码参数：前瞻帧数、动态搜索直径、子像素对齐搜索强度&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="660" x="-80" y="2100" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--483" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;本程序配置参数的策略为保持与源一致，并给予视频编码器充足的发挥空间。&lt;/div&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--484" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;手动指定—率控制模式&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="2370" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--485" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;· 仅支持码率调谐常量（CRF）模式，范围=超清|高清|流媒体|无损|默认&lt;/div&gt;&lt;div&gt;· x264：13~16 | 18~20 | 21~24 | 0 | 23&lt;br&gt;· x265：17~20 | 21~25 | 26~30 | 0 | 28&lt;br&gt;· SVT-AV1：28~32 | 33~36 | 37~40 | 1 | 35&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="660" x="-80" y="2400" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--486" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;非官方版的视频编码器提供了扩展功能，本程序支持的设置包括：&lt;/div&gt;&lt;div&gt;· x264：基于高频信息量的率失真优化（Film Grain Optimization）&lt;/div&gt;&lt;div&gt;· x265 jpsdr Mod：自适应量化迟滞（AQ Hysteresis）&lt;/div&gt;&lt;div&gt;· SVT-AV1-Essential：高精度去块滤镜（DLF 2）、自动计算瓦片大小（Auto Tile）&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="660" x="-80" y="2520" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--487" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;自动指定或通过 Y4M 管道配置的编码参数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="2070" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--488" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="「自动指定」会排除能够自主配置上述参数的编码器" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--489" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;· x264：通用、剪辑素材&lt;/div&gt;&lt;div&gt;· x265：通用、录像、剪辑素材、动漫、压力测试&lt;/div&gt;&lt;div&gt;· SVT-AV1：极致画质、压缩优先、速度优先&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="660" x="-80" y="2230" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--490" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;手动指定—基础参数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--491" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;「手动指定」参数由编码器的当下性能指标与下放到命令行的参数（即开发者意图）而定，这些参数会影响码率分配的精度，即无损压缩机制的压缩率。&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="660" x="-80" y="2310" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--492" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;i&gt;提示：本窗口支持拖选与 Ctrl+C 复制&lt;/i&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--493" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;视频压制相关工具下载&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--494" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&amp;nbsp; · https://github.com/iAvoe/encoding-tools-download-tutorial" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--495" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;商业使用合规要求&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--496" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&amp;nbsp; · FFmpeg / FFprobe 法律与许可证：https://ffmpeg.org/legal.html&lt;br&gt;&amp;nbsp; · VapourSynth 许可证：https://github.com/vapoursynth/vapoursynth/blob/master/COPYING&lt;br&gt;&amp;nbsp; · Avs2YUV 许可证：https://github.com/FFMS/ffms2/blob/master/COPYING.GPLv3&lt;br&gt;&amp;nbsp; · Avs2Pipemod 许可证：https://github.com/pinterf/AvsPmod&lt;br&gt;&amp;nbsp; · SVFI 许可证：https://github.com/Justin62628/Squirrel-RIFE/blob/master/LICENSE&lt;br&gt;&amp;nbsp; · x264 许可证与 AVC 专利信息：https://x264.org/licensing/&lt;br&gt;&amp;nbsp; · x265 许可证与 HEVC 专利信息：https://www.videolan.org/developers/x265.html&lt;br&gt;&amp;nbsp; · SVT-AV1 / AV1 许可证信息：https://gitlab.com/AOMediaCodec/SVT-AV1/-/blob/master/LICENSE.md" vertex="1">
          <mxGeometry height="150" width="660" x="-80" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--497" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="本程序使用 Apache 2.0 许可证。对于商业用途，请参考导入本工具的程序的相关合规要求。" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--498" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="......包括视频容器格式、音频编码器，以及商业用途中涉及的字体的合规要求。" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="1940" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--499" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;参数配置功能说明&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="660" x="-80" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--500" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#343A40;strokeWidth=1;fillColor=#343A40;fontColor=#ffffff;whiteSpace=wrap;align=center;verticalAlign=middle;spacingLeft=0;fontStyle=0;fontSize=16;spacing=5;" value="关闭" vertex="1">
          <mxGeometry height="30" width="660" x="-80" y="2620" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--501" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;b&gt;码率控制策略&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="-20" y="4960" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--502" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;b&gt;基础参数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="-20" y="5280" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--503" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;b&gt;自定义参数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="-20" y="5240" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--504" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="x264" vertex="1">
          <mxGeometry height="20" width="440" x="-20" y="5300" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--505" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="x265" vertex="1">
          <mxGeometry height="20" width="440" x="-20" y="5340" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--506" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="SVT-AV1" vertex="1">
          <mxGeometry height="20" width="440" x="-20" y="5380" as="geometry" />
        </mxCell>
        <mxCell id="4jGKFz-QeBpfQ_gHfw7--507" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;b&gt;关键帧距离秒数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="-20" y="5420" as="geometry" />
