          <mxGeometry height="20" width="540" x="500" y="5120" as="geometry" />
        </mxCell>
        <mxCell id="E2ZmZZi2j64fPM_wwybV-503" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;b&gt;自定义参数&lt;/b&gt;" vertex="1">
