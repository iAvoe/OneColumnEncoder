        </mxCell>
        <mxCell id="i1WwoltrwN95cvGNP1ue-448" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;b&gt;检测到的核心缓存分组（跨组越多，缓存命中率越低）&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="422" y="3930" as="geometry" />
        </mxCell>
