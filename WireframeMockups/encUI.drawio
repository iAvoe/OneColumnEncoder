          <mxGeometry height="20" width="540" x="200" y="5960" as="geometry" />
        </mxCell>
        <mxCell id="E_9Vxl2Gjiiu8lQGBKJA-508" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#6C767D;strokeWidth=1;fillColor=#6C767D;fontColor=#FFFFFF;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=0;fontSize=14;spacingLeft=10;labelBackgroundColor=none;" value="通用" vertex="1">
