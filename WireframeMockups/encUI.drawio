        <mxCell id="E_9Vxl2Gjiiu8lQGBKJA-462" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#6C767D;strokeWidth=1;fillColor=#F8F9FA;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontStyle=0;fontSize=13;spacing=10;" value="Node 7&lt;font style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp;· &lt;/font&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;N/A&lt;/font&gt;" vertex="1">
