        <mxCell id="-tGouwIUQegnlJcW6Ygj-31" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=20;strokeColor=#6C767D;align=left;spacingLeft=10;fontSize=16;whiteSpace=wrap;rounded=0;strokeWidth=2;fillColor=#FAFAFA;overflow=hidden;fontColor=#666666;" value="" vertex="1">
          <mxGeometry height="140" width="600" x="-320" y="3340" as="geometry" />
