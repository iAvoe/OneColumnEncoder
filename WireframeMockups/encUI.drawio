        <mxCell id="Q7i7MrcMBAsFEkv-3OfC-445" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="尝试逐物理核心分配编码器线程" vertex="1">
          <mxGeometry height="20" width="510" x="280" y="5218" as="geometry" />
        </mxCell>
        <mxCell id="Q7i7MrcMBAsFEkv-3OfC-446" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;本程序会忽略不同工具中各异的并行功能，并使用以下并行计算控制策略：&lt;/div&gt;&lt;div&gt;· 使用 CPU Sets 引荐线程活动范围（系统仍可临时外迁）&lt;/div&gt;&lt;div&gt;· 尝试优先在指定 NUMA 节点分配部分内存&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="540" x="280" y="4680" as="geometry" />
        </mxCell>
        <mxCell id="Q7i7MrcMBAsFEkv-3OfC-447" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;本程序不会调整进程优先级，以避免编码器卡死时系统无限等待的问题&lt;/div&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="280" y="4755" as="geometry" />
        </mxCell>
        <mxCell id="Q7i7MrcMBAsFEkv-3OfC-448" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;b&gt;超线程与异构处理器的调度策略&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="280" y="5180" as="geometry" />
        </mxCell>
        <mxCell id="Q7i7MrcMBAsFEkv-3OfC-449" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;b&gt;检测到的核心缓存分组（跨组越多，缓存命中率越低）&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="282" y="4790" as="geometry" />
        </mxCell>
        <mxCell id="Q7i7MrcMBAsFEkv-3OfC-450" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="· 每 8 核共用一组 32MB 的 L3 缓存" vertex="1">
