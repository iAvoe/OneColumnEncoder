        <mxCell id="IYs4aYTg9IDFscR6ozX7-448" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="尝试逐物理核心分配编码器线程" vertex="1">
