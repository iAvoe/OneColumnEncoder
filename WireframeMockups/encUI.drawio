        <mxCell id="nZUv0ywVRFsaRsaWOF7R-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=0;fontColor=#111111;spacing=2;autosizeText=0;fontSize=18;spacingLeft=0;spacingRight=0;" value="&lt;div align=&quot;center&quot;&gt;游&lt;/div&gt;" vertex="1">
