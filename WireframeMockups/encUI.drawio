          <mxGeometry height="30" width="660" x="140" y="3160" as="geometry" />
        </mxCell>
        <mxCell id="E_9Vxl2Gjiiu8lQGBKJA-501" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;b&gt;码率控制策略&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="200" y="5500" as="geometry" />
        </mxCell>
        <mxCell id="E_9Vxl2Gjiiu8lQGBKJA-502" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;b&gt;基础参数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="200" y="5820" as="geometry" />
        </mxCell>
        <mxCell id="E_9Vxl2Gjiiu8lQGBKJA-503" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;b&gt;自定义参数&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="540" x="200" y="5780" as="geometry" />
