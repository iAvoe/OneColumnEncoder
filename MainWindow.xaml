<Window x:Class="OneColumnEncoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OneColumnEncoder"
        xmlns:views="clr-namespace:OneColumnEncoder.Views"
        mc:Ignorable="d"
        Title="1cenc"
        Width="520"
        Height="1080">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <!-- DataContext is inherited from parent (MainVM), so there is no binding needed here -->
        <views:MainUI />
    </ScrollViewer>
</Window>