<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                    xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
                    xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                    xmlns:views="clr-namespace:OneColumnEncoder.Views">

    <!-- DataTemplates for modals -->
    <DataTemplate DataType="{x:Type vms:AppConfVM}">
        <comps:AppConfItem />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:AppUsageVM}">
        <views:AppUsageModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ParallelismConfVM}">
        <views:ParallelismConfModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:EncoderConfVM}">
        <views:EncoderConfModal />
    </DataTemplate>

    <!-- Spacing -->
    <Style TargetType="{x:Type Control}"
           x:Key="BaseControl">
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="Cursor"
                Value="Hand" />
    </Style>

    <!-- Colors -->
    <SolidColorBrush Color="#111"
                     x:Key="GlobalPrimary" />
    <SolidColorBrush Color="#6C767D"
                     x:Key="GlobalSecondary" />
    <SolidColorBrush Color="#939CA2"
                     x:Key="GlobalTertiary" />

    <SolidColorBrush Color="#EA6B66"
                     x:Key="BorderRed" />
    <SolidColorBrush Color="#67AB9F"
                     x:Key="BorderGreen" />
    <SolidColorBrush Color="#FAFAFA"
                     x:Key="Background" />
    <SolidColorBrush Color="#FEF7F7"
                     x:Key="BackgroundRed" />
    <SolidColorBrush Color="#F1FBF9"
                     x:Key="BackgroundGreen" />
    <SolidColorBrush Color="#009587"
                     x:Key="CorrectGreen" />
    <SolidColorBrush Color="#F68819"
                     x:Key="WarningOrange" />
    <SolidColorBrush Color="#95000E"
                     x:Key="ErrorRed" />
    <SolidColorBrush Color="#343A40"
                     x:Key="ButtonPrimary" />
    <SolidColorBrush Color="#7d736c"
                     x:Key="ButtonTertiary" />
    <!-- Viridis 9-color Heatmap -->
    <SolidColorBrush Color="#440154"
                     x:Key="Heatmap0" />
    <SolidColorBrush Color="#482878"
                     x:Key="Heatmap1" />
    <SolidColorBrush Color="#3E4A89"
                     x:Key="Heatmap2" />
    <SolidColorBrush Color="#31688E"
                     x:Key="Heatmap3" />
    <SolidColorBrush Color="#218F8B"
                     x:Key="Heatmap4" />
    <SolidColorBrush Color="#35B779"
                     x:Key="Heatmap5" />
    <SolidColorBrush Color="#8FD744"
                     x:Key="Heatmap6" />
    <SolidColorBrush Color="#DCE319"
                     x:Key="Heatmap7" />
    <SolidColorBrush Color="#FDE725"
                     x:Key="Heatmap8" />
    <!-- Fonts -->
    <Style TargetType="TextBlock"
           x:Key="H1">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H1C">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H2">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H2C">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H3">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H3C">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4Normal">
        <Setter Property="FontSize"
                Value="11" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H4C">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <!-- Status Icon -->
    <Style TargetType="{x:Type comps:ChecklistItem}">
        <Setter Property="Foreground"
                Value="{StaticResource ButtonPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistItem}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="IconMask"
                                   Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding Foreground}"
                                   Margin="0 0 5 0">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                            Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Textblock -->
                        <TextBlock Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- Waiting -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Waiting">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ButtonPrimary}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Success -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Success">
                            <Setter Property="Foreground"
                                    Value="{StaticResource CorrectGreen}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameCorrectMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Warning">
                            <Setter Property="Foreground"
                                    Value="{StaticResource WarningOrange}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWarning}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Error">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ErrorRed}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameXMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:ChecklistContainer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistContainer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                      ItemTemplate="{TemplateBinding ItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:AppConfItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfItem}">
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Heatmap Legend -->
    <Style TargetType="{x:Type comps:HeatmapLegend}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:HeatmapLegend}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding ColdText}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0 0 4 0" />
                        <Rectangle Grid.Column="1" Width="16" Height="16" Fill="{StaticResource Heatmap00}" />
                        <Rectangle Grid.Column="2" Width="16" Height="16" Fill="{StaticResource Heatmap01}" />
                        <Rectangle Grid.Column="3" Width="16" Height="16" Fill="{StaticResource Heatmap02}" />
                        <Rectangle Grid.Column="4" Width="16" Height="16" Fill="{StaticResource Heatmap03}" />
                        <Rectangle Grid.Column="5" Width="16" Height="16" Fill="{StaticResource Heatmap04}" />
                        <Rectangle Grid.Column="6" Width="16" Height="16" Fill="{StaticResource Heatmap05}" />
                        <Rectangle Grid.Column="7" Width="16" Height="16" Fill="{StaticResource Heatmap06}" />
                        <Rectangle Grid.Column="8" Width="16" Height="16" Fill="{StaticResource Heatmap07}" />
                        <Rectangle Grid.Column="9" Width="16" Height="16" Fill="{StaticResource Heatmap08}" />
                        <TextBlock Grid.Column="10"
                                   Text="{TemplateBinding HotText}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="4 0 0 0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Heatmap Grid -->
    <Style TargetType="{x:Type comps:HeatmapGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:HeatmapGrid}">
                    <Image x:Name="PART_Image"
                           Stretch="None"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:AppConfContainer}">
        <Setter Property="Margin"
                Value="0 0 0 10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfContainer}">
                    <StackPanel>
                        <!-- Header is from HeaderedItemsControl -->
                        <TextBlock Text="{TemplateBinding Header}"
                                   Style="{StaticResource H3}"
                                   Margin="0 0 0 10" />
                        <ItemsPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
