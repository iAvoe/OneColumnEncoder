<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                    xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
                    xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                    xmlns:views="clr-namespace:OneColumnEncoder.Views">

    <!-- DataTemplates for modals -->
    <DataTemplate DataType="{x:Type vms:AppConfVM}">
        <comps:AppConfItem />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:AppUsageVM}">
        <views:AppUsageModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ParallelismConfVM}">
        <views:ParallelismConfModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:EncoderConfVM}">
        <views:EncoderConfModal />
    </DataTemplate>

    <!-- Spacing -->
    <Style TargetType="{x:Type Control}"
           x:Key="BaseControl">
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="Cursor"
                Value="Hand" />
    </Style>

    <!-- Colors -->
    <SolidColorBrush Color="#111"
                     x:Key="GlobalPrimary" />
    <SolidColorBrush Color="#6C767D"
                     x:Key="GlobalSecondary" />
    <SolidColorBrush Color="#939CA2"
                     x:Key="GlobalTertiary" />
    <SolidColorBrush Color="#4A5458"
                     x:Key="GlobalQuaternary" />

    <SolidColorBrush Color="#EA6B66"
                     x:Key="BorderRed" />
    <SolidColorBrush Color="#67AB9F"
                     x:Key="BorderGreen" />
    <SolidColorBrush Color="#FAFAFA"
                     x:Key="Background" />
    <SolidColorBrush Color="#FEF7F7"
                     x:Key="BackgroundRed" />
    <SolidColorBrush Color="#F1FBF9"
                     x:Key="BackgroundGreen" />
    <SolidColorBrush Color="#009587"
                     x:Key="CorrectGreen" />
    <SolidColorBrush Color="#F68819"
                     x:Key="WarningOrange" />
    <SolidColorBrush Color="#95000E"
                     x:Key="ErrorRed" />
    <SolidColorBrush Color="#343A40"
                     x:Key="ButtonPrimary" />
    <SolidColorBrush Color="#7d736c"
                     x:Key="ButtonTertiary" />
    <!-- Memory range palette: empty block -->
    <SolidColorBrush Color="#E9EEF2"
                     x:Key="MemoryRangeEmpty" />

    <!-- Upstream program (yellow to orange occupancy family) -->
    <SolidColorBrush Color="#FFF8E1"
                     x:Key="MemoryRangeUpstream1" />
    <SolidColorBrush Color="#FFECB3"
                     x:Key="MemoryRangeUpstream2" />
    <SolidColorBrush Color="#FFE082"
                     x:Key="MemoryRangeUpstream3" />
    <SolidColorBrush Color="#FFD54F"
                     x:Key="MemoryRangeUpstream4" />
    <SolidColorBrush Color="#FFCA28"
                     x:Key="MemoryRangeUpstream5" />
    <SolidColorBrush Color="#FFB300"
                     x:Key="MemoryRangeUpstream6" />
    <SolidColorBrush Color="#FF8F00"
                     x:Key="MemoryRangeUpstream7" />
    <SolidColorBrush Color="#E65100"
                     x:Key="MemoryRangeUpstream8" />

    <!-- Downstream program / encoder (pink to maroon occupancy family) -->
    <SolidColorBrush Color="#FCE4EC"
                     x:Key="MemoryRangeDownstream1" />
    <SolidColorBrush Color="#F8BBD0"
                     x:Key="MemoryRangeDownstream2" />
    <SolidColorBrush Color="#F48FB1"
                     x:Key="MemoryRangeDownstream3" />
    <SolidColorBrush Color="#F06292"
                     x:Key="MemoryRangeDownstream4" />
    <SolidColorBrush Color="#E91E63"
                     x:Key="MemoryRangeDownstream5" />
    <SolidColorBrush Color="#C2185B"
                     x:Key="MemoryRangeDownstream6" />
    <SolidColorBrush Color="#AD1457"
                     x:Key="MemoryRangeDownstream7" />
    <SolidColorBrush Color="#880E4F"
                     x:Key="MemoryRangeDownstream8" />

    <!-- Other programs (light blue to navy occupancy family) -->
    <SolidColorBrush Color="#E3F2FD"
                     x:Key="MemoryRangeOther1" />
    <SolidColorBrush Color="#BBDEFB"
                     x:Key="MemoryRangeOther2" />
    <SolidColorBrush Color="#90CAF9"
                     x:Key="MemoryRangeOther3" />
    <SolidColorBrush Color="#64B5F6"
                     x:Key="MemoryRangeOther4" />
    <SolidColorBrush Color="#42A5F5"
                     x:Key="MemoryRangeOther5" />
    <SolidColorBrush Color="#1E88E5"
                     x:Key="MemoryRangeOther6" />
    <SolidColorBrush Color="#1565C0"
                     x:Key="MemoryRangeOther7" />
    <SolidColorBrush Color="#0D47A1"
                     x:Key="MemoryRangeOther8" />

    <!-- System cache (pale green to deep green occupancy family) -->
    <SolidColorBrush Color="#E8F5E9"
                     x:Key="MemoryRangeCache1" />
    <SolidColorBrush Color="#C8E6C9"
                     x:Key="MemoryRangeCache2" />
    <SolidColorBrush Color="#A5D6A7"
                     x:Key="MemoryRangeCache3" />
    <SolidColorBrush Color="#81C784"
                     x:Key="MemoryRangeCache4" />
    <SolidColorBrush Color="#66BB6A"
                     x:Key="MemoryRangeCache5" />
    <SolidColorBrush Color="#4CAF50"
                     x:Key="MemoryRangeCache6" />
    <SolidColorBrush Color="#2E7D32"
                     x:Key="MemoryRangeCache7" />
    <SolidColorBrush Color="#1B5E20"
                     x:Key="MemoryRangeCache8" />
    <!-- Fonts -->
    <Style TargetType="TextBlock"
           x:Key="H1">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H1C">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H2">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H2C">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H3">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H3C">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4Normal">
        <Setter Property="FontSize"
                Value="11" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H4C">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <!-- Status Icon -->
    <Style TargetType="{x:Type comps:ChecklistItem}">
        <Setter Property="Foreground"
                Value="{StaticResource ButtonPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistItem}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="IconMask"
                                   Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding Foreground}"
                                   Margin="0 0 5 0">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                            Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Textblock -->
                        <TextBlock Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- Waiting -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Waiting">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ButtonPrimary}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Success -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Success">
                            <Setter Property="Foreground"
                                    Value="{StaticResource CorrectGreen}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameCorrectMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Warning">
                            <Setter Property="Foreground"
                                    Value="{StaticResource WarningOrange}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWarning}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Error">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ErrorRed}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameXMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:ChecklistContainer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistContainer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                      ItemTemplate="{TemplateBinding ItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:AppConfItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfItem}">
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Memory Range Legend -->
    <Style TargetType="{x:Type comps:MemoryRangeLegend}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:MemoryRangeLegend}">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Title}"
                                   Style="{StaticResource H3}" />
                        <Grid Margin="0 5 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Upstream -->
                            <Rectangle Grid.Row="0" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeUpstream8}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{TemplateBinding UpstreamLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                            <!-- Downstream -->
                            <Rectangle Grid.Row="1" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeDownstream8}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{TemplateBinding DownstreamLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                            <!-- Cache -->
                            <Rectangle Grid.Row="2" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeCache8}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{TemplateBinding CacheLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                            <!-- Available -->
                            <Rectangle Grid.Row="3" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeEmpty}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{TemplateBinding AvailableLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:AppConfContainer}">
        <Setter Property="Margin"
                Value="0 0 0 10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfContainer}">
                    <StackPanel>
                        <!-- Header is from HeaderedItemsControl -->
                        <TextBlock Text="{TemplateBinding Header}"
                                   Style="{StaticResource H3}"
                                   Margin="0 0 0 10" />
                        <ItemsPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
