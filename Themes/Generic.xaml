<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OneColumnEncoder.Components">

    <!-- Spacing -->
    <Style TargetType="{x:Type Control}"
           x:Key="BaseControl">
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="Cursor"
                Value="Hand" />
    </Style>

    <!-- Colors -->
    <SolidColorBrush Color="#111"
                     x:Key="GlobalPrimary" />
    <SolidColorBrush Color="#6C767D"
                     x:Key="GlobalSecondary" />
    <SolidColorBrush Color="#EA6B66"
                     x:Key="BorderRed" />
    <SolidColorBrush Color="#67AB9F"
                     x:Key="BorderGreen" />
    <SolidColorBrush Color="#FAFAFA"
                     x:Key="Background" />
    <SolidColorBrush Color="#FEF7F7"
                     x:Key="BackgroundRed" />
    <SolidColorBrush Color="#F1FBF9"
                     x:Key="BackgroundGreen" />
    <SolidColorBrush Color="#009587"
                     x:Key="CorrectGreen" />
    <SolidColorBrush Color="#F68819"
                     x:Key="WarningOrange" />
    <SolidColorBrush Color="#95000E"
                     x:Key="ErrorRed" />
    <SolidColorBrush Color="#343A40"
                     x:Key="ButtonPrimary" />

    <!-- Fonts -->
    <Style TargetType="TextBlock"
           x:Key="H2">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H2C">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H3">
        <Setter Property="FontSize"
                Value="10" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H3C">
        <Setter Property="FontSize"
                Value="10" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4">
        <Setter Property="FontSize"
                Value="10" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H4C">
        <Setter Property="FontSize"
                Value="10" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    
    <!-- Status Icon -->
    <Style TargetType="{x:Type local:ChecklistItem}">
        <Setter Property="Foreground"
                Value="{StaticResource ButtonPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChecklistItem}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Initialize to questionmark symbol -->
                        <TextBlock x:Name="IconText"
                                   Text="?"
                                   VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="16"
                                   Foreground="{TemplateBinding Foreground}"
                                   Margin="0 0 10 0" />
                        <!-- Textblock -->
                        <TextBlock Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- Waiting -->
                        <Trigger Property="local:ChecklistItem.Status"
                                 Value="Waiting">
                            <Setter TargetName="IconText"
                                    Property="Text"
                                    Value="⏳" />
                            <Setter TargetName="IconText"
                                    Property="Foreground"
                                    Value="Gray" />
                        </Trigger>
                        <!-- Success -->
                        <Trigger Property="local:ChecklistItem.Status"
                                 Value="Success">
                            <Setter TargetName="IconText"
                                    Property="Text"
                                    Value="✓" />
                            <Setter TargetName="IconText"
                                    Property="Foreground"
                                    Value="Green" />
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="local:ChecklistItem.Status"
                                 Value="Warning">
                            <Setter TargetName="IconText"
                                    Property="Text"
                                    Value="⚠" />
                            <Setter TargetName="IconText"
                                    Property="Foreground"
                                    Value="Orange" />
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="local:ChecklistItem.Status"
                                 Value="Error">
                            <Setter TargetName="IconText"
                                    Property="Text"
                                    Value="✖" />
                            <Setter TargetName="IconText"
                                    Property="Foreground"
                                    Value="Red" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ChecklistContainer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChecklistContainer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}"
                                       Style="{StaticResource H2}"
                                       Margin="0 5 0 5" />
                            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                          ItemTemplate="{TemplateBinding ItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
