                     x:Key="MemoryRangeOther8" />

    <!-- System cache (pale green to deep green occupancy family) -->
    <SolidColorBrush Color="#E8F5E9"
                     x:Key="MemoryRangeCache1" />
    <SolidColorBrush Color="#C8E6C9"
                     x:Key="MemoryRangeCache2" />
    <SolidColorBrush Color="#A5D6A7"
                     x:Key="MemoryRangeCache3" />
    <SolidColorBrush Color="#81C784"
                     x:Key="MemoryRangeCache4" />
    <SolidColorBrush Color="#66BB6A"
                     x:Key="MemoryRangeCache5" />
    <SolidColorBrush Color="#4CAF50"
                     x:Key="MemoryRangeCache6" />
    <SolidColorBrush Color="#2E7D32"
                     x:Key="MemoryRangeCache7" />
    <SolidColorBrush Color="#1B5E20"
                     x:Key="MemoryRangeCache8" />
    <!-- Fonts -->
    <Style TargetType="TextBlock"
           x:Key="H1">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H1C">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H2">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H2C">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H3">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H3C">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4Normal">
        <Setter Property="FontSize"
                Value="11" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H4C">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <!-- Status Icon -->
    <Style TargetType="{x:Type comps:ChecklistItem}">
        <Setter Property="Foreground"
                Value="{StaticResource ButtonPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="IconMask"
                                   Grid.Column="0"
                                   Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding Foreground}"
                                   Margin="0 0 5 0">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                            Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Textblock -->
                        <TextBlock Grid.Column="1"
                                   Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Waiting -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Waiting">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ButtonPrimary}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Success -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Success">
                            <Setter Property="Foreground"
                                    Value="{StaticResource CorrectTeal}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameCorrectMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Warning">
                            <Setter Property="Foreground"
                                    Value="{StaticResource WarningOrange}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWarning}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Error">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ErrorRed}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameXMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:ChecklistContainer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistContainer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                      ItemTemplate="{TemplateBinding ItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings item -->
    <Style TargetType="{x:Type comps:AppConfItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfItem}">
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Memory Range Legend -->
    <Style TargetType="{x:Type comps:MemoryRangeLegend}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:MemoryRangeLegend}">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Title}"
                                   Style="{StaticResource H3}" />
                        <Grid Margin="0 5 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Upstream -->
                            <Rectangle Grid.Row="0" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeUpstream8}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{TemplateBinding UpstreamLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                            <!-- Downstream -->
                            <Rectangle Grid.Row="1" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeDownstream8}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{TemplateBinding DownstreamLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                            <!-- Cache -->
                            <Rectangle Grid.Row="2" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeCache8}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{TemplateBinding CacheLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                            <!-- Available -->
                            <Rectangle Grid.Row="3" Grid.Column="0"
                                       Width="12" Height="12" Margin="0 2 6 2"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource MemoryRangeEmpty}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{TemplateBinding AvailableLabel}"
                                       FontSize="12" Foreground="{StaticResource GlobalSecondary}" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:AppConfContainer}">
        <Setter Property="Margin"
                Value="0 0 0 10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfContainer}">
                    <StackPanel>
                        <!-- Header is from HeaderedItemsControl -->
                        <TextBlock Text="{TemplateBinding Header}"
                                   Style="{StaticResource H3}"
                                   Margin="0 0 0 10" />
                        <ItemsPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
