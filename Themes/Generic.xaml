<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                    xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
                    xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                    xmlns:views="clr-namespace:OneColumnEncoder.Views">

    <!-- DataTemplates for modals -->
    <DataTemplate DataType="{x:Type vms:AppConfVM}">
        <comps:AppConfItem />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:AppUsageVM}">
        <views:AppUsageModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ParallelismConfVM}">
        <views:ParallelismConfModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:EncoderConfVM}">
        <views:EncoderConfModal />
    </DataTemplate>

    <!-- Spacing -->
    <Style TargetType="{x:Type Control}"
           x:Key="BaseControl">
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="Cursor"
                Value="Hand" />
    </Style>

    <!-- Colors -->
    <SolidColorBrush Color="#111"
                     x:Key="GlobalPrimary" />
    <SolidColorBrush Color="#6C767D"
                     x:Key="GlobalSecondary" />
    <SolidColorBrush Color="#939CA2"
                     x:Key="GlobalTertiary" />

    <SolidColorBrush Color="#EA6B66"
                     x:Key="BorderRed" />
    <SolidColorBrush Color="#67AB9F"
                     x:Key="BorderGreen" />
    <SolidColorBrush Color="#FAFAFA"
                     x:Key="Background" />
    <SolidColorBrush Color="#FEF7F7"
                     x:Key="BackgroundRed" />
    <SolidColorBrush Color="#F1FBF9"
                     x:Key="BackgroundGreen" />
    <SolidColorBrush Color="#009587"
                     x:Key="CorrectGreen" />
    <SolidColorBrush Color="#F68819"
                     x:Key="WarningOrange" />
    <SolidColorBrush Color="#95000E"
                     x:Key="ErrorRed" />
    <SolidColorBrush Color="#343A40"
                     x:Key="ButtonPrimary" />
    <SolidColorBrush Color="#7d736c"
                     x:Key="ButtonTertiary" />
    <!-- Memory Heatmap palette: cold/empty cell -->
    <SolidColorBrush Color="#F2F2F2"
                     x:Key="HeatmapEmpty" />

    <!-- Upstream program (yellow → orange hot family) -->
    <SolidColorBrush Color="#FFF8E1"
                     x:Key="HeatmapUpstream1" />
    <SolidColorBrush Color="#FFECB3"
                     x:Key="HeatmapUpstream2" />
    <SolidColorBrush Color="#FFE082"
                     x:Key="HeatmapUpstream3" />
    <SolidColorBrush Color="#FFD54F"
                     x:Key="HeatmapUpstream4" />
    <SolidColorBrush Color="#FFCA28"
                     x:Key="HeatmapUpstream5" />
    <SolidColorBrush Color="#FFB300"
                     x:Key="HeatmapUpstream6" />
    <SolidColorBrush Color="#FF8F00"
                     x:Key="HeatmapUpstream7" />
    <SolidColorBrush Color="#E65100"
                     x:Key="HeatmapUpstream8" />

    <!-- Downstream program / encoder (pink → crimson → maroon hot family) -->
    <SolidColorBrush Color="#FCE4EC"
                     x:Key="HeatmapDownstream1" />
    <SolidColorBrush Color="#F8BBD0"
                     x:Key="HeatmapDownstream2" />
    <SolidColorBrush Color="#F48FB1"
                     x:Key="HeatmapDownstream3" />
    <SolidColorBrush Color="#F06292"
                     x:Key="HeatmapDownstream4" />
    <SolidColorBrush Color="#E91E63"
                     x:Key="HeatmapDownstream5" />
    <SolidColorBrush Color="#C2185B"
                     x:Key="HeatmapDownstream6" />
    <SolidColorBrush Color="#AD1457"
                     x:Key="HeatmapDownstream7" />
    <SolidColorBrush Color="#880E4F"
                     x:Key="HeatmapDownstream8" />

    <!-- Other programs (light blue → navy hot family) -->
    <SolidColorBrush Color="#E3F2FD"
                     x:Key="HeatmapOther1" />
    <SolidColorBrush Color="#BBDEFB"
                     x:Key="HeatmapOther2" />
    <SolidColorBrush Color="#90CAF9"
                     x:Key="HeatmapOther3" />
    <SolidColorBrush Color="#64B5F6"
                     x:Key="HeatmapOther4" />
    <SolidColorBrush Color="#42A5F5"
                     x:Key="HeatmapOther5" />
    <SolidColorBrush Color="#1E88E5"
                     x:Key="HeatmapOther6" />
    <SolidColorBrush Color="#1565C0"
                     x:Key="HeatmapOther7" />
    <SolidColorBrush Color="#0D47A1"
                     x:Key="HeatmapOther8" />

    <!-- System cache (pale green → deep green hot family) -->
    <SolidColorBrush Color="#E8F5E9"
                     x:Key="HeatmapCache1" />
    <SolidColorBrush Color="#C8E6C9"
                     x:Key="HeatmapCache2" />
    <SolidColorBrush Color="#A5D6A7"
                     x:Key="HeatmapCache3" />
    <SolidColorBrush Color="#81C784"
                     x:Key="HeatmapCache4" />
    <SolidColorBrush Color="#66BB6A"
                     x:Key="HeatmapCache5" />
    <SolidColorBrush Color="#4CAF50"
                     x:Key="HeatmapCache6" />
    <SolidColorBrush Color="#2E7D32"
                     x:Key="HeatmapCache7" />
    <SolidColorBrush Color="#1B5E20"
                     x:Key="HeatmapCache8" />
    <!-- Fonts -->
    <Style TargetType="TextBlock"
           x:Key="H1">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H1C">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H2">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H2C">
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H3">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H3C">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>
    <Style TargetType="TextBlock"
           x:Key="H4Normal">
        <Setter Property="FontSize"
                Value="11" />
    </Style>
    <Style TargetType="{x:Type Control}"
           x:Key="H4C">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <!-- Status Icon -->
    <Style TargetType="{x:Type comps:ChecklistItem}">
        <Setter Property="Foreground"
                Value="{StaticResource ButtonPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistItem}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="IconMask"
                                   Width="13"
                                   Height="13"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding Foreground}"
                                   Margin="0 0 5 0">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                            Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Textblock -->
                        <TextBlock Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- Waiting -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Waiting">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ButtonPrimary}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWaiting}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Success -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Success">
                            <Setter Property="Foreground"
                                    Value="{StaticResource CorrectGreen}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameCorrectMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Warning">
                            <Setter Property="Foreground"
                                    Value="{StaticResource WarningOrange}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameWarning}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="comps:ChecklistItem.Status"
                                 Value="Error">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ErrorRed}" />
                            <Setter TargetName="IconMask"
                                    Property="OpacityMask">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameXMark}"
                                                Stretch="Uniform" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:ChecklistContainer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:ChecklistContainer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                      ItemTemplate="{TemplateBinding ItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:AppConfItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfItem}">
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Heatmap Legend -->
    <Style TargetType="{x:Type comps:HeatmapLegend}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:HeatmapLegend}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Cold to hot text -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{TemplateBinding ColdToHotText}"
                                   Style="{StaticResource H3}"
                                   VerticalAlignment="Center" />
                        <!-- Upstream row -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{TemplateBinding UpstreamLabel}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0 0 10 0"
                                   Foreground="{StaticResource GlobalSecondary}" />
                        <Rectangle Grid.Row="1"
                                   Grid.Column="1"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapEmpty}" />
                        <Rectangle Grid.Row="1"
                                   Grid.Column="2"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapUpstream2}" />
                        <Rectangle Grid.Row="1"
                                   Grid.Column="3"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapUpstream4}" />
                        <Rectangle Grid.Row="1"
                                   Grid.Column="4"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapUpstream6}" />
                        <Rectangle Grid.Row="1"
                                   Grid.Column="5"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 0 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapUpstream8}" />
                        <!-- Downstream row -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{TemplateBinding DownstreamLabel}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0 5 10 0"
                                   Foreground="{StaticResource GlobalSecondary}" />
                        <Rectangle Grid.Row="2"
                                   Grid.Column="1"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapEmpty}" />
                        <Rectangle Grid.Row="2"
                                   Grid.Column="2"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapDownstream2}" />
                        <Rectangle Grid.Row="2"
                                   Grid.Column="3"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapDownstream4}" />
                        <Rectangle Grid.Row="2"
                                   Grid.Column="4"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapDownstream6}" />
                        <Rectangle Grid.Row="2"
                                   Grid.Column="5"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 0 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapDownstream8}" />
                        <!-- Cache row -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="{TemplateBinding CacheLabel}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0 5 10 0"
                                   Foreground="{StaticResource GlobalSecondary}" />
                        <Rectangle Grid.Row="3"
                                   Grid.Column="1"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapEmpty}" />
                        <Rectangle Grid.Row="3"
                                   Grid.Column="2"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapCache2}" />
                        <Rectangle Grid.Row="3"
                                   Grid.Column="3"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapCache4}" />
                        <Rectangle Grid.Row="3"
                                   Grid.Column="4"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 5 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapCache6}" />
                        <Rectangle Grid.Row="3"
                                   Grid.Column="5"
                                   Width="15"
                                   Height="15"
                                   Margin="0 5 0 0"
                                   RadiusX="2.5"
                                   RadiusY="2.5"
                                   Fill="{StaticResource HeatmapCache8}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Heatmap Grid -->
    <Style TargetType="{x:Type comps:HeatmapGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:HeatmapGrid}">
                    <Image x:Name="PART_Image"
                           Stretch="None"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type comps:AppConfContainer}">
        <Setter Property="Margin"
                Value="0 0 0 10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comps:AppConfContainer}">
                    <StackPanel>
                        <!-- Header is from HeaderedItemsControl -->
                        <TextBlock Text="{TemplateBinding Header}"
                                   Style="{StaticResource H3}"
                                   Margin="0 0 0 10" />
                        <ItemsPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
