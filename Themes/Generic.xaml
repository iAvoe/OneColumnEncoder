<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                    xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
                    xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                    xmlns:views="clr-namespace:OneColumnEncoder.Views">

    <!-- DataTemplates for modals -->
    <DataTemplate DataType="{x:Type vms:AppConfVM}">
        <comps:AppConfItem />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:AppUsageVM}">
        <views:AppUsageModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ParallelismConfVM}">
        <views:ParallelismConfModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:EncoderConfVM}">
        <views:EncoderConfModal />
    </DataTemplate>

    <!-- Spacing -->
    <Style TargetType="{x:Type Control}"
           x:Key="BaseControl">
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="Cursor"
                Value="Hand" />
    </Style>

    <!-- Colors -->
    <SolidColorBrush Color="#111"
                     x:Key="GlobalPrimary" />
    <SolidColorBrush Color="#6C767D"
                     x:Key="GlobalSecondary" />
    <SolidColorBrush Color="#939CA2"
                     x:Key="GlobalTertiary" />
    <SolidColorBrush Color="#4A5458"
                     x:Key="GlobalQuaternary" />

    <SolidColorBrush Color="#EA6B66"
                     x:Key="BorderRed" />
    <SolidColorBrush Color="#67AB9F"
                     x:Key="BorderGreen" />
    <SolidColorBrush Color="#FAFAFA"
                     x:Key="Background" />
    <SolidColorBrush Color="#FEF7F7"
                     x:Key="BackgroundRed" />
    <SolidColorBrush Color="#F1FBF9"
                     x:Key="BackgroundGreen" />
    <SolidColorBrush Color="#009587"
                     x:Key="CorrectTeal" />
    <SolidColorBrush Color="#F68819"
                     x:Key="WarningOrange" />
    <SolidColorBrush Color="#95000E"
                     x:Key="ErrorRed" />
    <SolidColorBrush Color="#D4A017"
                     x:Key="BorderAmber" />
    <SolidColorBrush Color="#FFF8E1"
                     x:Key="BackgroundAmber" />
    <SolidColorBrush Color="#343A40"
                     x:Key="ButtonPrimary" />
    <SolidColorBrush Color="#878574"
                      x:Key="ButtonTertiary" />
    <SolidColorBrush Color="#2FA34F"
                      x:Key="ProgressGreen" />
    <SolidColorBrush Color="#F1F5F9"
                      x:Key="ScriptAccentAvsBackground" />
    <SolidColorBrush Color="#0F52BA"
                      x:Key="ScriptAccentAvsForeground" />
    <SolidColorBrush Color="#F0FDF4"
                      x:Key="ScriptAccentVpyBackground" />
    <SolidColorBrush Color="#166534"
                      x:Key="ScriptAccentVpyForeground" />
    <SolidColorBrush Color="#FBF0FD"
                      x:Key="ScriptAccentFfmpegBackground" />
    <SolidColorBrush Color="#5C1665"
                      x:Key="ScriptAccentFfmpegForeground" />
    <SolidColorBrush Color="#D9CAE4"
                      x:Key="TimelineTrackBackground" />
    <SolidColorBrush Color="#9673A6"
                      x:Key="TimelineTrackBorder" />
    <SolidColorBrush Color="#F5E6A4"
                      x:Key="TimelineThumbBackground" />
    <SolidColorBrush Color="#D2B45A"
                      x:Key="TimelineThumbBorder" />
    <!-- Remixed card palette (light gray blue background) -->
    <SolidColorBrush Color="#BAD3D2"
                     x:Key="RemixedBackground" />
    <SolidColorBrush Color="#002B33"
                     x:Key="RemixedForeground" />
    <SolidColorBrush Color="#235D59"
                     x:Key="RemixedBorder" />
    <SolidColorBrush Color="#808080"
                     x:Key="RemixedDisabledForeground" />
    <SolidColorBrush Color="#2A3A3A"
                     x:Key="RemixedBackgroundGreen" />
    <SolidColorBrush Color="#3A2A2A"
                     x:Key="RemixedBackgroundRed" />
    <!-- Remixed card palette (light gray green background, left analogous) -->
    <SolidColorBrush Color="#BAC8D3"
                     x:Key="RemixedBackground2" />
    <SolidColorBrush Color="#013"
                     x:Key="RemixedForeground2" />
    <SolidColorBrush Color="#23445D"
                     x:Key="RemixedBorder2" />

    <!-- Remixed card palette (light pink background, left analogous) -->
    <SolidColorBrush Color="#EAD2BC"
                     x:Key="RemixedBackground3" />
    <SolidColorBrush Color="#271E0C"
                     x:Key="RemixedForeground3" />
    <SolidColorBrush Color="#623B1E"
                     x:Key="RemixedBorder3" />

    <!-- Remixed card palette (light purple background, left analogous) -->
    <SolidColorBrush Color="#d5d7b6"
                     x:Key="RemixedBackground4" />
    <SolidColorBrush Color="#1c1f14"
                     x:Key="RemixedForeground4" />
    <SolidColorBrush Color="#4e4e32"
                     x:Key="RemixedBorder4" />
    
    <!-- Memory range palette: empty block -->
    <SolidColorBrush Color="#E9EEF2"
                     x:Key="MemoryRangeEmpty" />

    <!-- Scrollbars -->
    <Style x:Key="ScrollBarPageButton"
           TargetType="RepeatButton">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundedScrollBarThumb"
           TargetType="Thumb">
        <Setter Property="Background"
                Value="{StaticResource MemoryRangeEmpty}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Margin="1"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource GlobalSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging"
                                 Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource GlobalQuaternary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate"
                     TargetType="ScrollBar">
        <Grid Background="Transparent"
              Margin="0 4">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource RoundedScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                     TargetType="ScrollBar">
        <Grid Background="Transparent"
              Margin="4 1 4 2">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource RoundedScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="Width"
                Value="10" />
        <Setter Property="MinWidth"
                Value="10" />
        <Setter Property="MinHeight"
                Value="24" />
        <Setter Property="Template"
                Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation"
                     Value="Horizontal">
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="MinWidth"
                        Value="24" />
                <Setter Property="Height"
                        Value="12" />
                <Setter Property="MinHeight"
                        Value="12" />
                <Setter Property="Template"
                        Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Upstream program (yellow to orange occupancy family) -->
    <SolidColorBrush Color="#FFF8E1"
                     x:Key="MemoryRangeUpstream1" />
    <SolidColorBrush Color="#FFECB3"
                     x:Key="MemoryRangeUpstream2" />
    <SolidColorBrush Color="#FFE082"
                     x:Key="MemoryRangeUpstream3" />
    <SolidColorBrush Color="#FFD54F"
                     x:Key="MemoryRangeUpstream4" />
    <SolidColorBrush Color="#FFCA28"
                     x:Key="MemoryRangeUpstream5" />
    <SolidColorBrush Color="#FFB300"
                     x:Key="MemoryRangeUpstream6" />
    <SolidColorBrush Color="#FF8F00"
                     x:Key="MemoryRangeUpstream7" />
    <SolidColorBrush Color="#E65100"
                     x:Key="MemoryRangeUpstream8" />

    <!-- Downstream program / encoder (pink to maroon occupancy family) -->
    <SolidColorBrush Color="#FCE4EC"
                     x:Key="MemoryRangeDownstream1" />
    <SolidColorBrush Color="#F8BBD0"
                     x:Key="MemoryRangeDownstream2" />
    <SolidColorBrush Color="#F48FB1"
                     x:Key="MemoryRangeDownstream3" />
    <SolidColorBrush Color="#F06292"
                     x:Key="MemoryRangeDownstream4" />
    <SolidColorBrush Color="#E91E63"
                     x:Key="MemoryRangeDownstream5" />
    <SolidColorBrush Color="#C2185B"
                     x:Key="MemoryRangeDownstream6" />
    <SolidColorBrush Color="#AD1457"
