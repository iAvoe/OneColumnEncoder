                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            Margin="5 2.5">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:HintPanel Text="{Binding EncodersZoneSelectedPath}"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <!-- Select Tool Dependencies -->
            <comps:SectionHeader HeaderText="{Binding SectionTexts[SelectDependencies]}"
                                 Margin="0 15 0 0">
                <comps:SectionHeader.HeaderExtra>
                    <Button Command="{Binding ToggleMiniDependenciesZoneCmd}"
                            Tag="{Binding IsMiniDependenciesZone}"
