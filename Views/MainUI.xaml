<UserControl x:Class="OneColumnEncoder.Views.MainUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OneColumnEncoder.Views"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
             xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:MainVM}"
             Background="WhiteSmoke">
    <UserControl.Resources>
        <FrameworkElement x:Key="BindingProxy"
                          DataContext="{Binding}" />
        <conv:WidthToColumnCountConverter x:Key="WidthToColumnCount" />
        <Style x:Key="SectionHeaderToggleButton"
               TargetType="Button"
               BasedOn="{StaticResource LinkButton}">
            <Setter Property="Content"
                    Value=" ▼▼ " />
            <Setter Property="MinWidth"
                    Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter Property="Content"
                            Value=" ▶▶ " />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="10 2 10 15">
            <comps:ToolsImportCard DataContext="{Binding ToolsImportCard}"
                                   ToggleCommand="{Binding DataContext.ToggleMiniToolsImportCardCmd, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                   ToggleTag="{Binding DataContext.IsMiniToolsImportCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                   ToggleToolTip="{Binding DataContext.ToggleMiniToolsImportCardText, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                   Margin="5 2.5">
                <comps:ToolsImportCard.Style>
                    <Style TargetType="comps:ToolsImportCard">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsMiniToolsImportCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </comps:ToolsImportCard.Style>
            </comps:ToolsImportCard>
            <cards:MiniToolsImportCard DataContext="{Binding ToolsImportCard}"
                                       ToggleCommand="{Binding DataContext.ToggleMiniToolsImportCardCmd, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                       ToggleTag="{Binding DataContext.IsMiniToolsImportCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                       ToggleToolTip="{Binding DataContext.ToggleMiniToolsImportCardText, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                       Margin="5 2.5">
                <cards:MiniToolsImportCard.Style>
                    <Style TargetType="cards:MiniToolsImportCard">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsMiniToolsImportCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </cards:MiniToolsImportCard.Style>
            </cards:MiniToolsImportCard>

            <!-- Setting Access -->
            <comps:TwoButtonGroup DataContext="{Binding OpenAppConfButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 10 10 0" />

            <!-- Hint: FFmpeg is optional, but needed for video frame previewing -->
            <comps:HintPanel Text="{Binding FfmpegOptionalHintText}"
                             RefreshTextOnLanguageChanged="True"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <!-- Select Upstream Tools -->
            <comps:SectionHeader HeaderText="{Binding SectionTexts[SelectUpstream]}"
                                 Margin="0 15 0 0">
                <comps:SectionHeader.HeaderExtra>
                    <Button Command="{Binding ToggleMiniUpstreamsZoneCmd}"
                            Tag="{Binding IsMiniUpstreamsZone}"
                            ToolTip="{Binding ToggleMiniUpstreamsZoneText}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 2.5"
                            Style="{StaticResource SectionHeaderToggleButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding UpstreamsZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniUpstreamsZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3:186}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Margin="5 2.5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding UpstreamsZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniUpstreamsZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <!-- Columns : Width per column -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=4:156.25}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            Margin="5 2.5">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:HintPanel Text="{Binding UpstreamsZoneSelectedPath}"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <!-- Select Encoders -->
            <comps:SectionHeader HeaderText="{Binding SectionTexts[SelectEncoder]}"
                                 Margin="0 15 0 0">
                <comps:SectionHeader.HeaderExtra>
                    <Button Command="{Binding ToggleMiniEncodersZoneCmd}"
                            Tag="{Binding IsMiniEncodersZone}"
                            ToolTip="{Binding ToggleMiniEncodersZoneText}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 2.5"
                            Style="{StaticResource SectionHeaderToggleButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding EncodersZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniEncodersZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3:186}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        Margin="5 2.5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                 RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding EncodersZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniEncodersZone}"
