<UserControl x:Class="OneColumnEncoder.Views.MainUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OneColumnEncoder.Views"
             xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
             xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
              xmlns:comps="clr-namespace:OneColumnEncoder.Components"
              xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
              xmlns:conv="clr-namespace:OneColumnEncoder.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:MainVM}"
             Background="WhiteSmoke">
    <UserControl.Resources>
        <FrameworkElement x:Key="BindingProxy"
                          DataContext="{Binding}" />
        <conv:WidthToColumnCountConverter x:Key="WidthToColumnCount" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="10 2 10 15">
            <comps:ToolsImportCard DataContext="{Binding ToolsImportCard}"
                                   Margin="5" />

            <!-- Setting Access -->
            <comps:TwoButtonGroup DataContext="{Binding OpenAppConfButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 15" />

             <!-- Select Upstream Tools -->
            <comps:SectionHeader HeaderText="{Binding SectionSelectUpstream}"
                                 Margin="0 15 0 0">
                <comps:SectionHeader.HeaderExtra>
                     <Button Content="{Binding ToggleMiniUpstreamsZoneText}"
                             Command="{Binding ToggleMiniUpstreamsZoneCmd}"
                             VerticalAlignment="Center"
                             Focusable="False"
                             KeyboardNavigation.IsTabStop="False"
                             Margin="5 0"
                             Style="{StaticResource LinkButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding UpstreamsZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniUpstreamsZone}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Margin="5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding UpstreamsZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniUpstreamsZone}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 5:120: max number of columns : width per column -->
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=5:120}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            IsCompactText="True"
                                            Margin="3">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Select Encoders -->
            <comps:SectionHeader HeaderText="{Binding SectionSelectEncoder}">
                <comps:SectionHeader.HeaderExtra>
                     <Button Content="{Binding ToggleMiniEncodersZoneText}"
                             Command="{Binding ToggleMiniEncodersZoneCmd}"
                             VerticalAlignment="Center"
                             Focusable="False"
                             KeyboardNavigation.IsTabStop="False"
                             Margin="5 0"
                             Style="{StaticResource LinkButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding EncodersZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniEncodersZone}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        Margin="5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                 RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding EncodersZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniEncodersZone}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=5:120}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            IsCompactText="True"
                                            Margin="3">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Select Analytic Tools -->
            <comps:SectionHeader HeaderText="{Binding SectionSelectAnalytics}">
                <comps:SectionHeader.HeaderExtra>
                     <Button Content="{Binding ToggleMiniAnalyticsZoneText}"
                             Command="{Binding ToggleMiniAnalyticsZoneCmd}"
                             VerticalAlignment="Center"
                             Focusable="False"
                             KeyboardNavigation.IsTabStop="False"
                             Margin="5 0"
                             Style="{StaticResource LinkButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding AnalyticsZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniAnalyticsZone}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        Margin="5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                 RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding AnalyticsZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniAnalyticsZone}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=5:120}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            IsCompactText="True"
                                            Margin="3">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:TwoButtonGroup DataContext="{Binding AnalyzeSrcButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 0" />

            <!-- Hint: OneLineShotArgs upstream does not support clipping -->
            <comps:HintPanel Text="{Binding AnalyzeNeedsSourceText}"
                             Margin="10 5"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <!-- Select Tool Dependencies -->
            <comps:SectionHeader HeaderText="{Binding SectionSelectDependencies}">
                <comps:SectionHeader.HeaderExtra>
                     <Button Content="{Binding ToggleMiniDependenciesZoneText}"
                             Command="{Binding ToggleMiniDependenciesZoneCmd}"
                             VerticalAlignment="Center"
                             Focusable="False"
                             KeyboardNavigation.IsTabStop="False"
                             Margin="5 0"
                             Style="{StaticResource LinkButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding DependenciesZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniDependenciesZone}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        Margin="5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                 RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding DependenciesZone}"
                          Margin="0 15">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniDependenciesZone}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=5:120}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            IsCompactText="True"
                                            Margin="3">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Import Source 1 -->
            <comps:SectionHeader HeaderText="{Binding SectionImportSource}" />
            <ItemsControl ItemsSource="{Binding VideoSrcImportZone}"
                          Margin="0 15 0 0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        EnableRealCheck="False"
                                        IsEnabled="{Binding IsEnabled}"
                                        PaletteIndex="1"
                                        Margin="5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Import Source 2 -->
            <ItemsControl ItemsSource="{Binding ActiveScriptSrcImportZone}"
                          Margin="0 15 0 0">
                <ItemsControl.Resources>
                    <SolidColorBrush x:Key="RemixedBackground"
                                     Color="#FAD7AC" />
                    <SolidColorBrush x:Key="RemixedForeground"
                                     Color="#663300" />
                    <SolidColorBrush x:Key="RemixedBorder"
                                     Color="#B46504" />
                    <SolidColorBrush x:Key="RemixedDisabledForeground"
                                     Color="#808080" />
                    <SolidColorBrush x:Key="RemixedBackgroundGreen"
                                     Color="#2A3A3A" />
                    <SolidColorBrush x:Key="RemixedBackgroundRed"
                                     Color="#3A2A2A" />
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        EnableRealCheck="False"
                                        IsEnabled="{Binding IsEnabled}"
                                        PaletteIndex="1"
                                        Margin="5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:TwoButtonGroup DataContext="{Binding FilterScbButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 15" />

            <!-- AnalyticResultsZone -->
            <comps:SectionHeader HeaderText="{Binding SectionAnalysisResults}" />

            <comps:ValidationCard DataContext="{Binding ActiveSrcValidationCard}"
                                   Margin="5 15 5 0" />

            <!-- Inspect and bypass blocking checks -->
            <comps:TwoButtonGroup DataContext="{Binding InspBypsChkButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 15" />

            <!-- Encoding Settings -->
            <comps:SectionHeader HeaderText="{Binding SectionEncodingConfigs}" />
            <ItemsControl ItemsSource="{Binding EncodingConfZone}"
                          Margin="0 15">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        EnableRealCheck="False"
                                        IsEnabled="{Binding IsEnabled}"
                                        PaletteIndex="2"
                                        Margin="5" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Starting Options -->
            <comps:SectionHeader HeaderText="{Binding SectionStartEncoding}"
                                 Margin="0 0 0 10" />
            <comps:ValidationCard DataContext="{Binding EncTermsCard}"
                                  Margin="5" />

            <!-- Hint: NUMA CPU check trigger -->
            <comps:HintPanel Text="{Binding NumaCpuCheckHintText}"
                             Margin="10 0 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <!-- Inspect and bypass encoder pre-check blocking checks -->
            <comps:TwoButtonGroup DataContext="{Binding InspBypsEncChkButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 15" />

            <comps:ValidationCard DataContext="{Binding BestPracticesCard}"
                                  Margin="5" />

            <comps:ThreeButtonGroup DataContext="{Binding EncStartButtons}"
                                    ButtonHeight="35"
                                    Button1Command="{Binding Cmd1}"
                                    Button2Command="{Binding Cmd2}"
                                    Button3Command="{Binding Cmd3}"
                                    Button1IsEnabled="{Binding B3_1IsEnabled}"
                                    Button2IsEnabled="{Binding B3_2IsEnabled}"
                                    Button3IsEnabled="{Binding B3_3IsEnabled}"
                                    Margin="10 10 10 0" />

            <!-- Hint: OneLineShotArgs upstream does not support clipping -->
                <comps:HintPanel Visibility="{Binding SVFIClipDisabledHintVisible, Converter={StaticResource BoolToVisibility}}"
                              Text="{Binding SVFIClipDisabledHintText}"
                              Margin="5 5 5 0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />
        </StackPanel>

        <Border Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}"
                Background="White"
                Opacity="0.5"
                IsHitTestVisible="True" />
    </Grid>
</UserControl>
