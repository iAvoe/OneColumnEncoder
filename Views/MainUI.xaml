<UserControl x:Class="OneColumnEncoder.Views.MainUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OneColumnEncoder.Views"
             xmlns:viewmodels="clr-namespace:OneColumnEncoder.ViewModels"
             xmlns:comps="clr-namespace:OneColumnEncoder.Components"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainVM}">
    <StackPanel Margin="10">
        <!-- Import Tools -->
        <comps:SectionHeader HeaderText="Import Tools"
                             Margin="0 0 0 20" />
        <comps:ImportContainerCard DataContext="{Binding ToolsImportCard}"
                                   Margin="0 0 0 20" />

        <!-- Setting Access -->
        <comps:TwoButtonGroup DataContext="{Binding OpenSettingsButtonsVM}"
                              Margin="0 0 0 20" />

        <!-- Select Upstream Tools -->
        <comps:SectionHeader HeaderText="Select Upstream Tool"
                                   Margin="0 0 0 20" />
        <ItemsControl ItemsSource="{Binding UpstreamsZone}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <comps:ItemCard DataContext="{Binding}"
                                    Margin="0 0 0 20" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Select Encoders -->
        <comps:SectionHeader HeaderText="Select Encoder"
                                   Margin="0 0 0 20" />
        <ItemsControl ItemsSource="{Binding EncodersZone}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <comps:ItemCard DataContext="{Binding}"
                                    Margin="0 0 0 20" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Select Analytic Tools -->
        <comps:SectionHeader HeaderText="Select Analytics &amp; Dependencies"
                             Margin="0 0 0 20" />
        <ItemsControl ItemsSource="{Binding AnalyticsZone}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <comps:ItemCard DataContext="{Binding}"
                                    Margin="0 0 0 20" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Import Source -->
        <comps:SectionHeader HeaderText="Import or Create Source File"
                             Margin="0 0 0 20" />
        <ItemsControl ItemsSource="{Binding SourceImportZone}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <comps:ItemCard DataContext="{Binding}"
                                    Margin="0 0 0 20" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- AnalyticResultsZone -->
        <comps:SectionHeader HeaderText="Analysis Results"
                             Margin="0 0 0 20" />

        <comps:SourceValidationCard DataContext="{Binding SourceValidationCard}"
                                    Margin="0 0 0 20" />

        <!-- Encoding Settings -->
        <comps:SectionHeader HeaderText="Encoding Configurations"
                             Margin="0 0 0 20" />
        <ItemsControl ItemsSource="{Binding EncSettingsZone}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <comps:ItemCard DataContext="{Binding}"
                                    Margin="0 0 0 20" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Starting Options -->
        <comps:SectionHeader HeaderText="Start Encoding Options"
                             Margin="0 0 0 20" />
        
        <!-- TODO: Blocking Conditions Card -->
        
        <comps:ThreeButtonGroup DataContext="{Binding EncodingStartButtonsVM}"/>
    </StackPanel>
</UserControl>
