                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 2.5"
                            Style="{StaticResource SectionHeaderToggleButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding DependenciesZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniDependenciesZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
