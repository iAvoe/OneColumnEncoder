                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:HintPanel Text="{Binding ActiveScriptSrcImportZoneSelectedPath}"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <comps:TwoButtonGroup DataContext="{Binding FilterScbButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 10 10 0" />

            <!-- Select Analytic Tools -->
            <comps:SectionHeader HeaderText="{Binding SectionTexts[SelectAnalytics]}"
                                 Margin="0 15 0 0">
                <comps:SectionHeader.HeaderExtra>
                    <Button Command="{Binding ToggleMiniAnalyticsZoneCmd}"
                            Tag="{Binding IsMiniAnalyticsZone}"
                            ToolTip="{Binding ToggleMiniAnalyticsZoneText}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 2.5"
                            Style="{StaticResource SectionHeaderToggleButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding AnalyticsZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniAnalyticsZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3:186}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        Margin="5 2.5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                                RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding AnalyticsZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniAnalyticsZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=4:156.25}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            Margin="5 2.5">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                   RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                                RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:TwoButtonGroup DataContext="{Binding AnalyzeSrcButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="10 10 10 0" />

            <!-- Hint: OneLineShotArgs upstream does not support clipping -->
            <comps:HintPanel Text="{Binding AnalyzeNeedsSourceText}"
                             RefreshTextOnLanguageChanged="True"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <comps:HintPanel Text="{Binding AnalyticsZoneSelectedPath}"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <comps:ValidationActionGroup DataContext="{Binding SrcValGroup}"
                                         CardMargin="5 5 5 0" />

            <!-- Encoding Settings -->
            <comps:SectionHeader HeaderText="{Binding SectionTexts[EncodingConfigs]}"
                                 Margin="0 15 0 0">
                <comps:SectionHeader.HeaderExtra>
                    <Button Command="{Binding ToggleMiniEncodingConfZoneCmd}"
                            Tag="{Binding IsMiniEncodingConfZone}"
                            ToolTip="{Binding ToggleMiniEncodingConfZoneText}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 2.5"
                            Style="{StaticResource SectionHeaderToggleButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding EncodingConfZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniEncodingConfZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3:186}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        EnableRealCheck="False"
                                        IsEnabled="{Binding IsEnabled}"
                                        PaletteIndex="2"
                                        Margin="5 5 5 0">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding EncodingConfZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniEncodingConfZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=4:156.25}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            IsEnabled="{Binding IsEnabled}"
                                            PaletteIndex="2"
                                            ShowActionButtons="False"
                                            Margin="5 2.5">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:HintPanel Text="{Binding EncodingConfZoneSelectedPath}"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
            <!-- Duration filter for queue mode -->
            <Grid Visibility="{Binding IsDurationFilterVisible, Converter={StaticResource BoolToVisibility}}"
                  Margin="10 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{Binding MinDurationFilterText}"
                          Grid.Column="0"
                          IsChecked="{Binding IsDurationFilterEnabled}"
                          Foreground="{StaticResource GlobalSecondary}"
                          FontWeight="Normal"
                          Margin="0 2.5 0 0"
                          VerticalAlignment="Center" />
                <comps:IntegerSlider Grid.Column="1"
                                     Label=""
                                     Margin="2.5 0 0 0"
                                     Minimum="10"
                                     Maximum="310"
                                     Value="{Binding MinVideoDurationSeconds, Mode=TwoWay}"
                                     Step="10"
                                     TickCount="6"
                                     TickLabels="{Binding DurationTickLabels}"
                                     IsEnabled="{Binding IsDurationFilterEnabled}"
                                     LabelWidth="0"
                                     HorizontalAlignment="Stretch" />
            </Grid>
            <comps:HintPanel Text="{Binding DurationFilterStatusText}"
                             Visibility="{Binding IsDurationFilterStatusVisible, Converter={StaticResource BoolToVisibility}}"
                             RefreshTextOnLanguageChanged="True"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
            <!-- Starting Options -->
            <comps:SectionHeader HeaderText="{Binding SectionTexts[StartEncoding]}"
                                 Margin="0 5 0 0">
                <comps:SectionHeader.HeaderExtra>
                    <Button Command="{Binding ToggleMiniStartEncodingZoneCmd}"
                            Tag="{Binding IsMiniStartEncodingZone}"
                            ToolTip="{Binding ToggleMiniStartEncodingZoneText}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False"
                            Margin="5 2.5"
                            Style="{StaticResource SectionHeaderToggleButton}" />
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <comps:ValidationActionGroup DataContext="{Binding EncTermsValGroup}"
                                         CardMargin="5 10 5 0">
                <comps:ValidationActionGroup.MiddleContent>
                    <comps:HintPanel Text="{Binding DataContext.NumaCpuCheckHintText, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                     RefreshTextOnLanguageChanged="True"
                                     Margin="10 2.5 5 0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center" />
                </comps:ValidationActionGroup.MiddleContent>
            </comps:ValidationActionGroup>

            <comps:ValidationCard DataContext="{Binding BestPracticesCard}"
                                  ToggleCommand="{Binding DataContext.ToggleMiniBestPracticesCardCmd, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                  ToggleTag="{Binding DataContext.IsMiniBestPracticesCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                  ToggleToolTip="{Binding DataContext.ToggleMiniBestPracticesCardText, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                  Margin="5 15 5 5">
                <comps:ValidationCard.Style>
                    <Style TargetType="comps:ValidationCard">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsMiniBestPracticesCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.IsMiniStartEncodingZone, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </comps:ValidationCard.Style>
            </comps:ValidationCard>
            <cards:MiniValidationCard DataContext="{Binding BestPracticesCard}"
                                      ToggleCommand="{Binding DataContext.ToggleMiniBestPracticesCardCmd, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                      ToggleTag="{Binding DataContext.IsMiniBestPracticesCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                      ToggleToolTip="{Binding DataContext.ToggleMiniBestPracticesCardText, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                      Margin="5 15 5 5">
                <cards:MiniValidationCard.Style>
                    <Style TargetType="cards:MiniValidationCard">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsMiniBestPracticesCard, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.IsMiniStartEncodingZone, RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </cards:MiniValidationCard.Style>
            </cards:MiniValidationCard>

            <comps:ThreeButtonGroup DataContext="{Binding EncStartButtons}"
                                    ButtonHeight="35"
                                    Button1Command="{Binding Cmd1}"
                                    Button2Command="{Binding Cmd2}"
                                    Button3Command="{Binding Cmd3}"
                                    Button1IsEnabled="{Binding B3_1IsEnabled}"
                                    Button2IsEnabled="{Binding B3_2IsEnabled}"
                                    Button3IsEnabled="{Binding B3_3IsEnabled}"
                                    Margin="10 15 10 0" />

            <!-- Hint: OneLineShotArgs upstream does not support clipping -->
            <comps:HintPanel Visibility="{Binding SVFIClipDisabledHintVisible, Converter={StaticResource BoolToVisibility}}"
                             Text="{Binding SVFIClipDisabledHintText}"
                             RefreshTextOnLanguageChanged="True"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
        </StackPanel>

        <Border Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}"
                Background="White"
                Opacity="0.5"
                IsHitTestVisible="True" />
    </Grid>
</UserControl>
