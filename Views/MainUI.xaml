                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        Margin="5 2.5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                 RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding DependenciesZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniDependenciesZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=4:156.25}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            ShowActionButtons="False"
                                            Margin="5 2.5">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:HintPanel Text="{Binding DependenciesZoneSelectedPath}"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <!-- Import Source 1 -->
            <comps:SectionHeader HeaderText="{Binding SectionTexts[ImportSource]}"
                                 Margin="0 15 0 0">
                <comps:SectionHeader.HeaderExtra>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ToggleMiniVideoSrcImportZoneCmd}"
                                Tag="{Binding IsMiniVideoSrcImportZone}"
                                ToolTip="{Binding ToggleMiniVideoSrcImportZoneText}"
                                VerticalAlignment="Center"
                                Focusable="False"
                                KeyboardNavigation.IsTabStop="False"
                                Margin="5 0 0 0"
                                Style="{StaticResource SectionHeaderToggleButton}" />
                        <Button Command="{Binding ToggleMiniScriptSrcImportZoneCmd}"
                                Tag="{Binding IsMiniScriptSrcImportZone}"
                                ToolTip="{Binding ToggleMiniScriptSrcImportZoneText}"
                                VerticalAlignment="Center"
                                Focusable="False"
                                KeyboardNavigation.IsTabStop="False"
                                Margin="5 2.5"
                                Style="{StaticResource SectionHeaderToggleButton}" />
                    </StackPanel>
                </comps:SectionHeader.HeaderExtra>
            </comps:SectionHeader>
            <ItemsControl ItemsSource="{Binding VideoSrcImportZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniVideoSrcImportZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3:190}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        EnableRealCheck="False"
                                        IsEnabled="{Binding IsEnabled}"
                                        PaletteIndex="1"
                                        Margin="5 2.5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding VideoSrcImportZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniVideoSrcImportZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=4:160}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard DataContext="{Binding}"
                                            IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                            IsCancel="{Binding IsCancel}"
                                            IsEnabled="{Binding IsEnabled}"
                                            ShowActionButtons="False"
                                            PaletteIndex="1"
                                            Margin="5 2.5">
                            <cards:MiniItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </cards:MiniItemCard.InputBindings>
                        </cards:MiniItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:HintPanel Text="{Binding VideoSrcImportZoneSelectedPath}"
                             Margin="10 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <!-- Import Source 2 -->
            <ItemsControl ItemsSource="{Binding ActiveScriptSrcImportZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniScriptSrcImportZone}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.Resources>
                    <SolidColorBrush x:Key="RemixedBackground"
                                     Color="#FAD7AC" />
                    <SolidColorBrush x:Key="RemixedForeground"
                                     Color="#663300" />
                    <SolidColorBrush x:Key="RemixedBorder"
                                     Color="#B46504" />
                    <SolidColorBrush x:Key="RemixedDisabledForeground"
                                     Color="#808080" />
                    <SolidColorBrush x:Key="RemixedBackgroundGreen"
                                     Color="#2A3A3A" />
                    <SolidColorBrush x:Key="RemixedBackgroundRed"
                                     Color="#3A2A2A" />
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}, Converter={StaticResource WidthToColumnCount}, ConverterParameter=3:190}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <comps:ItemCard DataContext="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        IsCancel="{Binding IsCancel}"
                                        IsReal="{Binding IsReal}"
                                        EnableRealCheck="False"
                                        IsEnabled="{Binding IsEnabled}"
                                        PaletteIndex="1"
                                        Margin="5 2.5">
                            <comps:ItemCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTool,
                                                                  RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectTool,
                                                               RelativeSource={RelativeSource AncestorType=views:MainUI}}"
                                            CommandParameter="{Binding}" />
                            </comps:ItemCard.InputBindings>
                        </comps:ItemCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ActiveScriptSrcImportZone}"
                          Margin="0 5 0 0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniScriptSrcImportZone}"
                                         Value="True">
                                <Setter Property="Visibility"
