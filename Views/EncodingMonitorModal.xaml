<Window x:Class="OneColumnEncoder.Views.EncodingMonitorModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:EncodingMonitorModalVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="1070"
        MinWidth="860"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encoding progress bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProgressTitle}"
                           Style="{StaticResource H3}"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             Height="20"
                             Margin="10 0 10 0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             Foreground="#2FA34F"
                             Background="#E9EEF2"
                             BorderThickness="0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ProgressText}"
                           FontSize="13"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Below progress bar text -->
            <Grid Grid.Row="1"
                  Margin="0 5 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentSizeLabel}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding EstimatedSizeLabel}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding WrittenFramesLabel}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           HorizontalAlignment="Center" />
            </Grid>

            <!-- RAM occupancy range and title -->
            <Grid Grid.Row="2"
                  Margin="0 15 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding MemoryTitle}"
                               Style="{StaticResource H3}"
                               VerticalAlignment="Center" />
                    <ScrollViewer Grid.Column="1"
                                  Margin="5 0 5 0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <comps:MemoryRangeBar Items="{Binding MemoryRangeBlocks}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    </ScrollViewer>
                    <TextBlock Grid.Column="2"
                               Text="{Binding RangeSummary}"
                               FontSize="13"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- RAM distribution labels and legend -->
                <Grid Grid.Row="1"
                      Margin="0 6 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 10 0"
                                    VerticalAlignment="Center">
                            <Rectangle Width="8"
                                       Height="8"
                                       Margin="0 0 5 0"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{StaticResource MemoryRangeUpstream8}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DistributionUpstreamLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}" />
                            <TextBlock Text="{Binding DistributionUpstream}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}"
                                       Margin="4 0 0 0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 10 0"
                                    VerticalAlignment="Center">
                            <Rectangle Width="8"
                                       Height="8"
                                       Margin="0 0 5 0"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{StaticResource MemoryRangeDownstream8}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DistributionDownstreamLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}" />
                            <TextBlock Text="{Binding DistributionDownstream}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}"
                                       Margin="4 0 0 0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 10 0"
                                    VerticalAlignment="Center">
                            <Rectangle Width="8"
                                       Height="8"
                                       Margin="0 0 5 0"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{StaticResource MemoryRangeCache8}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DistributionCacheLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}" />
                            <TextBlock Text="{Binding DistributionCache}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}"
                                       Margin="4 0 0 0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Rectangle Width="8"
                                       Height="8"
                                       Margin="0 0 5 0"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{StaticResource MemoryRangeEmpty}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DistributionAvailableLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}" />
                            <TextBlock Text="{Binding DistributionAvailable}"
                                       FontSize="10"
                                       Foreground="{StaticResource GlobalSecondary}"
                                       Margin="4 0 0 0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- RAM multi column display -->
            <comps:ColumnTextGrid Grid.Row="3"
                                   Margin="0 15 0 0"
                                   Items="{Binding MetricColumns}"
                                   ColumnCount="7" />

            <!-- RAM telemetry frequency slider -->
            <comps:IntegerSlider Grid.Row="4"
                                 Margin="0 15 0 0"
                                 Label="{Binding SampleIntervalLabel}"
                                 LabelWidth="80"
                                 Minimum="0"
                                 Maximum="240"
                                 Value="{Binding SampleIntervalSeconds, Mode=TwoWay}"
                                 TickLabels="{Binding SampleIntervalTickLabels}"
                                 TickCount="5"
                                 Step="1" />

            <!-- RAM telemetry pause & continue -->
            <comps:TwoButtonGroup Grid.Row="5"
                                   Margin="0 10 0 0"
                                  DataContext="{Binding MonitorButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}" />

            <StackPanel Grid.Row="6"
                        Margin="0 18 0 0">
                <!-- Process stderr: upstream | encoder -->
                <cards:SplitTextCard Title="{Binding StderrTitle}"
                                      LeftText="{Binding UpstreamReportText, Mode=TwoWay}"
                                      RightText="{Binding DownstreamReportText, Mode=TwoWay}"
                                     TextFontSize="{Binding LogFontSize}" />

                <comps:FiveButtonGroup Margin="0 10 0 0"
                                       DataContext="{Binding ReportButtons}"
                                       ButtonHeight="30"
                                       Button1Command="{Binding Cmd1}"
                                       Button2Command="{Binding Cmd2}"
                                       Button3Command="{Binding Cmd3}"
                                       Button4Command="{Binding Cmd4}"
                                       Button5Command="{Binding Cmd5}"
                                       Button1IsEnabled="{Binding B5_1IsEnabled}"
                                       Button2IsEnabled="{Binding B5_2IsEnabled}"
                                       Button3IsEnabled="{Binding B5_3IsEnabled}"
                                       Button4IsEnabled="{Binding B5_4IsEnabled}"
                                       Button5IsEnabled="{Binding B5_5IsEnabled}" />
                <StackPanel Orientation="Horizontal"
                             Margin="0 3 0 0">
                    <Rectangle Width="10"
                               Height="10"
                               Fill="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                                        Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{Binding DragLogReportHint}"
                               FontSize="9"
                               Foreground="{StaticResource GlobalSecondary}"
                               Margin="3.5 0 0 0" />
                </StackPanel>
            </StackPanel>

            <!-- Encoding timings -->
            <StackPanel Grid.Row="7"
                        Margin="0 15 0 0">
                <comps:ColumnTextGrid Items="{Binding FooterColumns}"
                                      ColumnCount="7" />
                <comps:FiveButtonGroup Margin="0 15 0 0"
                                       DataContext="{Binding FinishButtons}"
                                       ButtonHeight="30"
                                       Button1Command="{Binding Cmd1}"
                                       Button2Command="{Binding Cmd2}"
                                       Button3Command="{Binding Cmd3}"
                                       Button4Command="{Binding Cmd4}"
                                       Button5Command="{Binding Cmd5}"
                                       Button1IsEnabled="{Binding B5_1IsEnabled}"
                                       Button2IsEnabled="{Binding B5_2IsEnabled}"
                                       Button3IsEnabled="{Binding B5_3IsEnabled}"
                                       Button4IsEnabled="{Binding B5_4IsEnabled}"
                                       Button5IsEnabled="{Binding B5_5IsEnabled}" />
                <!-- Hint: abort will discard task progress -->
                <StackPanel Orientation="Horizontal"
                            Margin="0 3 0 0">
                    <Rectangle Width="10"
                               Height="10"
                               Fill="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                                        Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{Binding SmallNoteText}"
                               FontSize="9"
                               Foreground="{StaticResource GlobalSecondary}"
                               Margin="3.5 0 0 0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0 3 0 0">
                    <Rectangle Width="10"
                               Height="10"
                               Fill="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                                        Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{Binding IgnoreOtherProgramsMemoryNoteText}"
                               FontSize="9"
                               Foreground="{StaticResource GlobalSecondary}"
                               Margin="3.5 0 0 0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
