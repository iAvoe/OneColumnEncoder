<helpers:AdaptiveWindow x:Class="OneColumnEncoder.Views.EncodingMonitorModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:EncodingMonitorVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1010"
        MinWidth="1000"
        Height="910"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Queue sidebar panel (column 0) -->
        <Grid Grid.Column="0"
              Width="200"
              Visibility="{Binding QueueSidebar.IsVisible, Converter={StaticResource BoolToVisibility}}"
              Background="{StaticResource Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Queue sidebar header with batch controls -->
            <StackPanel Grid.Row="0" Margin="8 8 8 4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Lang.QueueSidebarTitle}"
                               Style="{StaticResource H3}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{Binding Lang.QueueSidebarCollapseText}"
                            Command="{Binding QueueSidebarToggleCmd}"
                            Style="{StaticResource LinkButton}"
                            FontSize="11" />
                </Grid>
                <comps:TwoButtonGroup Margin="0 6 0 0"
                                      DataContext="{Binding QueueSidebarButtons}"
                                      ButtonHeight="26"
                                      Button1Command="{Binding Cmd1}"
                                      Button2Command="{Binding Cmd2}"
                                      Button1IsEnabled="{Binding B2_1IsEnabled}"
                                      Button2IsEnabled="{Binding B2_2IsEnabled}" />
            </StackPanel>

            <!-- Virtualized job list -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding QueueSidebar.Jobs}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     Margin="4 0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0 0 0 4">
                            <cards:MiniItemCard DataContext="{Binding}"
                                                IsSelected="{Binding IsSelected}"
                                                IsCancel="{Binding IsCancel}" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Queue sidebar stats footer -->
            <StackPanel Grid.Row="2" Margin="8 4 8 8">
                <comps:SectionHeader HeaderText="{Binding Lang.QueueSidebarTitle}" />
                <TextBlock Text="{Binding QueueSidebar.StatsText}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           Margin="0 4 0 0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Grid splitter (column 1) -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      ResizeBehavior="PreviousAndNext"
                      IsEnabled="{Binding QueueSidebar.IsVisible}"
                      Visibility="{Binding QueueSidebar.IsVisible, Converter={StaticResource BoolToVisibility}}" />

        <!-- Main content (column 2) -->
        <Grid Grid.Column="2" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!-- Encoding progress bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ProgressTitle}"
                               Style="{StaticResource H3}"
                               VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1"
                                 Height="20"
                                 Margin="10 0 15 0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 Foreground="{StaticResource ProgressGreen}"
                                 Background="{StaticResource MemoryRangeEmpty}"
                                 BorderThickness="0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding ProgressText}"
                               FontSize="13"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- RAM occupancy range, title -->
                <Grid Grid.Row="1"
                      Margin="0 15 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MemoryTitle}"
                                   Style="{StaticResource H3}"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="1"
                                      Margin="5 0 5 0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <comps:MemoryRangeBar Items="{Binding MemoryRangeBlocks}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                        </ScrollViewer>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RangeSummary}"
                                   FontSize="13"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- RAM distribution labels and legend -->
                    <Grid Grid.Row="1"
                          Margin="0 6 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeUpstream8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionUpstreamLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionUpstream}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeDownstream8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionDownstreamLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionDownstream}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 10 0"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeCache8}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionCacheLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionCache}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                           Height="8"
                                           Margin="0 0 5 0"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource MemoryRangeEmpty}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DistributionAvailableLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}" />
                                <TextBlock Text="{Binding DistributionAvailable}"
                                           FontSize="10"
                                           Foreground="{StaticResource GlobalSecondary}"
                                           Margin="4 0 0 0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- RAM multi column display -->
                <comps:ColumnTextGrid Grid.Row="2"
                                      Margin="0 15 0 0"
                                      Items="{Binding MetricColumns}"
                                      ColumnCount="6" />

                <!-- RAM monitoring frequency slider -->
                <comps:IntegerSlider Grid.Row="3"
                                     Margin="0 15 0 0"
                                     Label="{Binding SampleIntervalLabel}"
                                     LabelWidth="120"
                                     Minimum="0"
                                     Maximum="240"
                                     Value="{Binding SampleIntervalSeconds, Mode=TwoWay}"
                                     TickLabels="{Binding SampleIntervalTickLabels}"
                                     TickCount="5"
                                     Step="1"
                                     IsEnabled="{Binding IsMonitoringEnabled}" />

                <!-- RAM monitoring pause & continue -->
                <comps:TwoButtonGroup Grid.Row="4"
                                      Margin="0 10 0 0"
                                      DataContext="{Binding MonitorButtons}"
                                      ButtonHeight="30"
                                      Button1Command="{Binding Cmd1}"
                                      Button2Command="{Binding Cmd2}"
                                      Button1IsEnabled="{Binding B2_1IsEnabled}"
                                      Button2IsEnabled="{Binding B2_2IsEnabled}" />

                <StackPanel Grid.Row="5"
                            Margin="0 15 0 0">
                    <!-- Process stderr: upstream | encoder -->
                     <cards:SplitTextCard Title="{Binding StderrTitle}"
                                          LeftText="{Binding UpstreamReportText, Mode=TwoWay}"
                                          RightText="{Binding DownstreamReportText, Mode=TwoWay}"
                                          TextFontSize="{Binding LogFontSize}"
                                          IsRichTextMode="{Binding LogRichTextMode}" />

                    <comps:ThreeButtonGroup Margin="0 15 0 0"
                                            DataContext="{Binding ReportButtons}"
                                            ButtonHeight="30"
                                            Button1Command="{Binding Cmd1}"
                                            Button2Command="{Binding Cmd2}"
                                            Button3Command="{Binding Cmd3}"
                                            Button1IsEnabled="{Binding B3_1IsEnabled}"
                                            Button2IsEnabled="{Binding B3_2IsEnabled}"
                                            Button3IsEnabled="{Binding B3_3IsEnabled}" />
                    <comps:HintPanel Text="{Binding DragLogReportHint}"
                                     HintBrush="{StaticResource GlobalSecondary}"
                                     Margin="0 3 0 0" />
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Encoding timings -->
        <StackPanel Grid.Row="1">
            <comps:ColumnTextGrid Items="{Binding FooterColumns}"
                                   ColumnCount="6" />
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <CheckBox Content="{Binding EnableMuxText}"
                          IsChecked="{Binding EnableMux, Mode=TwoWay}"
                          IsEnabled="{Binding CanMux}"
                          VerticalAlignment="Center" />
                <CheckBox Content="{Binding RichTextModeText}"
                          IsChecked="{Binding LogRichTextMode, Mode=TwoWay}"
                          Margin="20 0 0 0"
                          VerticalAlignment="Center" />
            </StackPanel>
            <comps:HintPanel Text="{Binding MuxTimebaseHint}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 3 0 0" />
            <comps:FiveButtonGroup Margin="0 15 0 0"
                                    DataContext="{Binding FinishButtons}"
                                   ButtonHeight="30"
                                   Button1Command="{Binding Cmd1}"
                                   Button2Command="{Binding Cmd2}"
                                   Button3Command="{Binding Cmd3}"
                                   Button4Command="{Binding Cmd4}"
                                   Button5Command="{Binding Cmd5}"
                                   Button1IsEnabled="{Binding B5_1IsEnabled}"
                                   Button2IsEnabled="{Binding B5_2IsEnabled}"
                                   Button3IsEnabled="{Binding B5_3IsEnabled}"
                                   Button4IsEnabled="{Binding B5_4IsEnabled}"
                                   Button5IsEnabled="{Binding B5_5IsEnabled}" />
            <!-- Hint: abort will discard task progress -->
            <comps:HintPanel Text="{Binding SmallNoteText}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 3 0 0" />
        </StackPanel>
    </Grid>
</Grid>
</helpers:AdaptiveWindow>
