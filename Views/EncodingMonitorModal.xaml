<Window x:Class="OneColumnEncoder.Views.EncodingMonitorModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:EncodingMonitorModalVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="1170"
        MinWidth="860"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProgressTitle}"
                           Style="{StaticResource H3}"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             Height="29"
                             Margin="20 0 14 0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             Foreground="#2FA34F"
                             Background="#E9EEF2"
                             BorderThickness="0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ProgressText}"
                           FontSize="13"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0 4 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentSizeLabel}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding EstimatedSizeLabel}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding WrittenFramesLabel}"
                           FontSize="10"
                           Foreground="{StaticResource GlobalSecondary}"
                           HorizontalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0 14 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding MemoryTitle}"
                               Style="{StaticResource H3}"
                               Margin="0 0 0 8" />
                    <comps:HeatMapGrid Items="{Binding HeatMapA}"
                                       Columns="32"
                                       CellSize="17.5"
                                       HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0 32 0 0">
                    <TextBlock Text="{Binding DistributionTitle}"
                               Style="{StaticResource H3}" />
                    <Grid Margin="0 12 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="上游程序" FontSize="13" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DistributionUpstream}" FontSize="13" />
                        <TextBlock Grid.Row="1" Text="下游程序（编码器）" FontSize="13" Margin="0 14 0 0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DistributionDownstream}" FontSize="13" Margin="0 14 0 0" />
                        <TextBlock Grid.Row="2" Text="其它程序" FontSize="13" Margin="0 14 0 0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DistributionOther}" FontSize="13" Margin="0 14 0 0" />
                        <TextBlock Grid.Row="3" Text="系统缓存" FontSize="13" Margin="0 14 0 0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DistributionCache}" FontSize="13" Margin="0 14 0 0" />
                    </Grid>

                    <TextBlock Text="{Binding BlockDetailsTitle}"
                               Style="{StaticResource H3}"
                               Margin="0 22 0 0" />
                    <Grid Margin="0 12 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="号，行，列，大小" FontSize="13" Foreground="{StaticResource GlobalSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BlockNo}" FontSize="13" />
                        <TextBlock Grid.Row="1" Text="隶属区段" FontSize="13" Foreground="{StaticResource GlobalSecondary}" Margin="0 12 0 0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BlockSegment}" FontSize="13" Margin="0 12 0 0" />
                        <TextBlock Grid.Row="2" Text="热度" FontSize="13" Foreground="{StaticResource GlobalSecondary}" Margin="0 12 0 0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BlockHeat}" FontSize="13" Margin="0 12 0 0" />
                    </Grid>
                </StackPanel>
            </Grid>

            <comps:ColumnTextGrid Grid.Row="3"
                                  Margin="0 14 0 0"
                                  Items="{Binding MetricColumns}"
                                  ColumnCount="7" />

            <comps:IntegerSlider Grid.Row="4"
                                  Margin="0 14 0 0"
                                  Label="{Binding SampleIntervalLabel}"
                                  LabelWidth="80"
                                  Minimum="0"
                                  Maximum="240"
                                  Value="{Binding SampleIntervalSeconds, Mode=TwoWay}"
                                  TickLabels="{Binding SampleIntervalTickLabels}"
                                  TickCount="5"
                                  Step="30" />

            <comps:TwoButtonGroup Grid.Row="5"
                                  Margin="0 10 0 0"
                                  DataContext="{Binding MonitorButtons}"
                                  ButtonHeight="30"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}" />

            <cards:SplitTextCard Grid.Row="6"
                                 Margin="0 18 0 0"
                                 Title="{Binding LogTitle}"
                                 LeftText="{Binding UpstreamLogText, Mode=TwoWay}"
                                 RightText="{Binding DownstreamLogText, Mode=TwoWay}"
                                 TextBoxMinHeight="210"
                                 TextFontSize="{Binding LogFontSize}" />

            <comps:FiveButtonGroup Grid.Row="7"
                                   Margin="0 10 0 0"
                                   DataContext="{Binding LogButtons}"
                                   ButtonHeight="30"
                                   Button1Command="{Binding Cmd1}"
                                   Button2Command="{Binding Cmd2}"
                                   Button3Command="{Binding Cmd3}"
                                   Button4Command="{Binding Cmd4}"
                                   Button5Command="{Binding Cmd5}"
                                   Button1IsEnabled="{Binding B5_1IsEnabled}"
                                   Button2IsEnabled="{Binding B5_2IsEnabled}"
                                   Button3IsEnabled="{Binding B5_3IsEnabled}"
                                   Button4IsEnabled="{Binding B5_4IsEnabled}"
                                   Button5IsEnabled="{Binding B5_5IsEnabled}" />

            <StackPanel Grid.Row="8"
                        Margin="0 3 0 0">

                <cards:SplitTextCard Margin="0 14 0 0"
                                     LeftText="{Binding UpstreamReportText, Mode=TwoWay}"
                                     RightText="{Binding DownstreamReportText, Mode=TwoWay}"
                                     TextBoxMinHeight="90"
                                     TextFontSize="{Binding LogFontSize}" />

                <comps:FiveButtonGroup Margin="0 10 0 0"
                                       DataContext="{Binding ReportButtons}"
                                       ButtonHeight="30"
                                       Button1Command="{Binding Cmd1}"
                                       Button2Command="{Binding Cmd2}"
                                       Button3Command="{Binding Cmd3}"
                                       Button4Command="{Binding Cmd4}"
                                       Button5Command="{Binding Cmd5}"
                                       Button1IsEnabled="{Binding B5_1IsEnabled}"
                                       Button2IsEnabled="{Binding B5_2IsEnabled}"
                                       Button3IsEnabled="{Binding B5_3IsEnabled}"
                                       Button4IsEnabled="{Binding B5_4IsEnabled}"
                                       Button5IsEnabled="{Binding B5_5IsEnabled}" />
                <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                    <Rectangle Width="10" Height="10" Fill="{StaticResource GlobalSecondary}" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}" Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{Binding DragReportHint}"
                               FontSize="9"
                               Foreground="{StaticResource GlobalSecondary}"
                               Margin="3.5 0 0 0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="9"
                        Margin="0 18 0 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StartedAtLabel}" Style="{StaticResource H3}" TextAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ElapsedLabel}" Style="{StaticResource H3}" TextAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding RemainingLabel}" Style="{StaticResource H3}" TextAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding CompleteAtLabel}" Style="{StaticResource H3}" TextAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding EncoderFileLabel}" Style="{StaticResource H3}" TextAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding RateControlLabel}" Style="{StaticResource H3}" TextAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding ArgsLabel}" Style="{StaticResource H3}" TextAlignment="Center" />
                </Grid>
                <comps:ColumnTextGrid Margin="0 4 0 0"
                                      Items="{Binding FooterColumns}"
                                      ColumnCount="7" />
                <comps:FiveButtonGroup Margin="0 14 0 0"
                                       DataContext="{Binding FinishButtons}"
                                       ButtonHeight="30"
                                       Button1Command="{Binding Cmd1}"
                                       Button2Command="{Binding Cmd2}"
                                       Button3Command="{Binding Cmd3}"
                                       Button4Command="{Binding Cmd4}"
                                       Button5Command="{Binding Cmd5}"
                                       Button1IsEnabled="{Binding B5_1IsEnabled}"
                                       Button2IsEnabled="{Binding B5_2IsEnabled}"
                                       Button3IsEnabled="{Binding B5_3IsEnabled}"
                                       Button4IsEnabled="{Binding B5_4IsEnabled}"
                                       Button5IsEnabled="{Binding B5_5IsEnabled}" />
                <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                    <Rectangle Width="10" Height="10" Fill="{StaticResource GlobalSecondary}" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}" Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{Binding SmallNoteText}"
                               FontSize="9"
                               Foreground="{StaticResource GlobalSecondary}"
                               Margin="3.5 0 0 0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
