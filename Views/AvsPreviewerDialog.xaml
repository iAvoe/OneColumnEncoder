<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.AvsPreviewerDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   xmlns:lang="clr-namespace:OneColumnEncoder.Models.Lang"
                   d:DataContext="{d:DesignInstance Type=vms:AvsPreviewerVM}"
                   mc:Ignorable="d"
                   Title="{x:Static lang:AvsPreviewerLangProvider.WindowTitle}"
                   Width="1550" Height="990" WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="10 10 10 15">
        <comps:AvsPreviewerPanel DataContext="{Binding}" />
    </Grid>
</ui:AdaptiveWindow>
