<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.QueueEditorModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:QueueEditorVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="470"
                   MinWidth="340"
                   MinHeight="180"
                   MaxHeight="720"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <ui:AdaptiveWindow.Resources>
        <DataTemplate x:Key="IconTextButtonTemplate">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Rectangle Width="16"
                           Height="16"
                           Margin="0 0 5 0"
                           VerticalAlignment="Center"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ui:AdaptiveWindow.Resources>
    <Grid Margin="10 10 10 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="QueueEditorScrollViewer"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="QueueItemsListBox"
                     ItemsSource="{Binding Items}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <cards:MiniItemCard IsSelected="{Binding IsSelected}"
                                            IsCancel="{Binding IsCancel}"
                                            IsRecentlyMoved="{Binding IsRecentlyMoved}"
                                            Margin="0 5"
                                            HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Margin="0 5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{Binding SortButtons.B2_1Text}"
                    Command="{Binding SortButtons.Cmd1}"
                    IsEnabled="{Binding SortButtons.B2_1IsEnabled}"
                    Height="30"
                    Margin="0 0 1.125 0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource NormalButton}"
                    Tag="{x:Static ui:SvgIconProvider.GameSort}"
                    ContentTemplate="{StaticResource IconTextButtonTemplate}" />

            <Button Grid.Column="1"
                    Content="{Binding SortButtons.B2_2Text}"
                    Command="{Binding SortButtons.Cmd2}"
                    IsEnabled="{Binding SortButtons.B2_2IsEnabled}"
                    Height="30"
                    Margin="1.125 0 0 0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource NormalButton}"
                    Tag="{x:Static ui:SvgIconProvider.GameSort}"
                    ContentTemplate="{StaticResource IconTextButtonTemplate}" />
        </Grid>

        <comps:HintPanel Grid.Row="2"
                         Text="{Binding HintText}"
                         RefreshTextOnLanguageChanged="True"
                         Margin="0.25 2.5 0 0" />

        <comps:TwoButtonGroup Grid.Row="3"
                              DataContext="{Binding FinishButtons}"
                              ButtonHeight="30"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}"
                              Margin="0 7.5 0 0" />
    </Grid>
</ui:AdaptiveWindow>
