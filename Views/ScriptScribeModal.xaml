<helpers:AdaptiveWindow x:Class="OneColumnEncoder.Views.ScriptScribeModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OneColumnEncoder.Views"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ScriptScribeModalVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="520"
        Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ScribeDescription1}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding ScribeDescription2}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />

        <!-- Select tab: AviSynth, VapourSynth script -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0 20 0 0">

            <TabItem Header="{Binding TabAvs}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding AvsPrefix, Mode=OneWay}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="1"
                             Text="{Binding AvsPrefix2, Mode=OneWay}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding AvsUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="#F1F5F9"
                             Foreground="#0F52BA"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="5"
                             FontSize="13"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             Margin="0 10 0 0"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding AvsSuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 10 0 0"
                             FontWeight="Normal" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabVpy}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding VpyPrefix, Mode=OneWay}"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="1"
                             Text="{Binding VpyPrefix2, Mode=OneWay}"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding VpyUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="#F0FDF4"
                             Foreground="#166534"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="5"
                             FontSize="13"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             Margin="0 10 0 0"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding VpySuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 10 0 0"
                             FontWeight="Normal" />
                </Grid>
            </TabItem>
        </TabControl>

        <comps:ThreeButtonGroup Grid.Row="3"
                                Margin="0 10 0 0"
                                ButtonHeight="30"
                                DataContext="{Binding ScriptExportButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />

        <TextBlock Grid.Row="4"
                   Text="{Binding NoteText}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   Foreground="{StaticResource GlobalPrimary}" />

        <comps:TwoButtonGroup Grid.Row="5"
                              Margin="0 10 0 10"
                              ButtonHeight="30"
                              DataContext="{Binding FinishScribeButtons}"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}" />
    </Grid>
</helpers:AdaptiveWindow>
