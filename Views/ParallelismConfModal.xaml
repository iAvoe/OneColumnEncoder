<Window x:Class="OneColumnEncoder.Views.ParallelismConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ParallelismConfVM}"
        mc:Ignorable="d"
        Title="{Binding Lang.WindowTitle}"
        Width="780"
        Height="1080"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26 22 26 26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Lang.WindowTitle}"
                       Style="{StaticResource H1}"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="1"
                       Text="{Binding Lang.IntroText}"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Margin="0 30 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="2"
                       Text="{Binding Lang.PriorityText}"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Margin="0 22 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="3"
                       Text="{Binding Lang.CacheGroupTitle}"
                       Style="{StaticResource H2}"
                       Margin="0 22 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="4"
                       Text="{Binding Lang.CacheGroupHint}"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Margin="0 4 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="5"
                       Text="{Binding Lang.UpstreamNumaTitle}"
                       Style="{StaticResource H2}"
                       Margin="0 22 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <ItemsControl Grid.Row="6"
                          ItemsSource="{Binding UpstreamNodes}"
                          Margin="0 4 0 0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:CPUNodeCard DataContext="{Binding}"
                                           IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                           IsEnabled="{Binding IsEnabled}"
                                           Margin="0 0 24 14">
                            <cards:CPUNodeCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectUpstreamNodeCmd,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectUpstreamNodeCmd,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                            </cards:CPUNodeCard.InputBindings>
                        </cards:CPUNodeCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="7"
                       Text="{Binding Lang.DownstreamNumaTitle}"
                       Style="{StaticResource H2}"
                       Margin="0 12 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <ItemsControl Grid.Row="8"
                          ItemsSource="{Binding DownstreamNodes}"
                          Margin="0 4 0 0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:CPUNodeCard DataContext="{Binding}"
                                           IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                           IsEnabled="{Binding IsEnabled}"
                                           Margin="0 0 24 14">
                            <cards:CPUNodeCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectDownstreamNodeCmd,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectDownstreamNodeCmd,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                            </cards:CPUNodeCard.InputBindings>
                        </cards:CPUNodeCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="9"
                       Text="{Binding Lang.NumaGuidanceText}"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Margin="0 8 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <StackPanel Grid.Row="10"
                        Margin="0 26 0 0">
                <TextBlock Text="{Binding Lang.ThreadStrategyTitle}"
                           Style="{StaticResource H2}"
                           Foreground="{StaticResource GlobalPrimary}" />
                <CheckBox Content="{Binding Lang.PreferPhysicalCoresText}"
                          IsChecked="{Binding PreferPhysicalCores, Mode=TwoWay}"
                          HorizontalContentAlignment="Stretch"
                          FlowDirection="RightToLeft"
                          FontSize="15"
                          Margin="0 18 0 0" />
                <CheckBox Content="{Binding Lang.PreferPerformanceCoresText}"
                          IsChecked="{Binding PreferPerformanceCores, Mode=TwoWay}"
                          HorizontalContentAlignment="Stretch"
                          FlowDirection="RightToLeft"
                          FontSize="15"
                          Margin="0 18 0 0" />

                <TextBlock Text="{Binding Lang.MemoryStrategyTitle}"
                           Style="{StaticResource H2}"
                           Margin="0 24 0 0"
                           Foreground="{StaticResource GlobalPrimary}" />
                <CheckBox Content="{Binding Lang.UseLargePagesText}"
                          IsChecked="{Binding UseLargePages, Mode=TwoWay}"
                          HorizontalContentAlignment="Stretch"
                          FlowDirection="RightToLeft"
                          FontSize="15"
                          Margin="0 18 0 0" />

                <comps:TwoButtonGroup DataContext="{Binding FinishButtons}"
                                      Button1Command="{Binding Cmd1}"
                                      Button2Command="{Binding Cmd2}"
                                      Button1IsEnabled="{Binding B2_1IsEnabled}"
                                      Button2IsEnabled="{Binding B2_2IsEnabled}"
                                      Margin="0 32 0 0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
