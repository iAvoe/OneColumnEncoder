<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.ParallelismConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:ui="clr-namespace:OneColumnEncoder.UI"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ParallelismConfVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="570"
        Height="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="15 10 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0 0 0 15">
            <comps:HintPanel Text="{Binding Lang.IntroText}"
                             Margin="5 0 5 0" />
            
            <comps:HintPanel Text="{Binding Lang.PriorityText}"
                             Margin="5 10 5 0" />

            <TextBlock Text="{Binding Lang.CacheGroupTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 15 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Text="{Binding CacheGroupHint}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <comps:HintPanel Text="{Binding Lang.NumaTopologyHintText}"
                             Margin="5 5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <TextBlock Text="{Binding Lang.UpstreamNumaTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 15 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <cards:CPUNodeCardGroup ItemsSource="{Binding UpstreamNodes}" />

            <TextBlock Text="{Binding Lang.DownstreamNumaTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 15 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <cards:CPUNodeCardGroup ItemsSource="{Binding DownstreamNodes}" />

            <comps:IntegerSlider Margin="5 5 5 0"
                                 Label="{Binding EncoderThreadCountText}"
                                Minimum="1"
                                Maximum="{Binding MaxThreadCount}"
                                Value="{Binding EncoderThreadCount, Mode=TwoWay}"
                                TickLabels="{Binding EncoderThreadTickLabels}"
                                TickCount="{Binding EncoderThreadTickCount}" />

            <comps:HintPanel Text="{Binding Lang.NumaGuidanceText}"
                             Margin="5 2.5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <comps:AppConfContainer Header="{Binding Lang.ThreadStrategyTitle}"
                                    Margin="0 15 0 0">
                <comps:AppConfItem Text="{Binding Lang.PreferUpstreamPhysCoresText}">
                    <CheckBox IsChecked="{Binding PreferUpstreamPhysicalCores, Mode=TwoWay}" />
                </comps:AppConfItem>
                <comps:AppConfItem Text="{Binding Lang.PreferDownstreamPhysCoresText}">
                    <CheckBox IsChecked="{Binding PreferPhysicalCores, Mode=TwoWay}" />
                </comps:AppConfItem>
            </comps:AppConfContainer>

                <comps:AppConfContainer Header="{Binding PipeBufferStrategyTitle}"
                                        Margin="0 10 0 0">
                <comps:AppConfItem Text="{Binding UseLargePipeBufferText}">
                    <CheckBox IsChecked="{Binding UseLargePipeBuffer, Mode=TwoWay}" />
                </comps:AppConfItem>
                <comps:HintPanel Text="{Binding LargePipeBufferHintText}"
                                 Margin="5 0" />
            </comps:AppConfContainer>

                <comps:AppConfContainer Header="{Binding Lang.MemoryStrategyTitle}"
                                        Margin="0 15 0 0">
                <comps:HintPanel Text="{Binding LargePagesUnavailableHintText}"
                                 Margin="5 0" />
            </comps:AppConfContainer>
            </StackPanel>
        </ScrollViewer>

        <comps:TwoButtonGroup Grid.Row="1"
                              DataContext="{Binding FinishButtons}"
                              ButtonHeight="30"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}" />
    </Grid>
</ui:AdaptiveWindow>
