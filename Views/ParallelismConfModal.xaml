<Window x:Class="OneColumnEncoder.Views.ParallelismConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ParallelismConfVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="530"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <comps:HintPanel Grid.Row="0"
                             Text="{Binding Lang.IntroText}"
                             Margin="5 0 5 0" />
            
            <comps:HintPanel Grid.Row="1"
                             Text="{Binding Lang.PriorityText}"
                             Margin="5 10 5 0" />

            <TextBlock Grid.Row="2"
                       Text="{Binding Lang.CacheGroupTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="3"
                       Text="{Binding CacheGroupHint}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0 5 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="4"
                       Text="{Binding Lang.UpstreamNumaTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <ItemsControl Grid.Row="5"
                          ItemsSource="{Binding UpstreamNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:CPUNodeCard DataContext="{Binding}"
                                           IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                           IsEnabled="{Binding IsEnabled}"
                                           Margin="2.5 5 2.5 0">
                            <cards:CPUNodeCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectUpstreamNodeCmd,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectUpstreamNodeCmd,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                            </cards:CPUNodeCard.InputBindings>
                        </cards:CPUNodeCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="6"
                       Text="{Binding Lang.DownstreamNumaTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <ItemsControl Grid.Row="7"
                          ItemsSource="{Binding DownstreamNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:CPUNodeCard DataContext="{Binding}"
                                           IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                           IsEnabled="{Binding IsEnabled}"
                                           Margin="2.5 5 2.5 0">
                            <cards:CPUNodeCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectDownstreamNodeCmd,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectDownstreamNodeCmd,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                            </cards:CPUNodeCard.InputBindings>
                        </cards:CPUNodeCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <comps:IntegerSlider Grid.Row="8"
                                Margin="5 10 5 0"
                                Label="{Binding EncoderThreadCountText}"
                                Minimum="1"
                                 Maximum="{Binding MaxThreadCount}"
                                 Value="{Binding EncoderThreadCount, Mode=TwoWay}"
                                 TickLabels="{Binding EncoderThreadTickLabels}"
                                 TickCount="{Binding EncoderThreadTickCount}" />

            <comps:HintPanel Grid.Row="9"
                             Text="{Binding Lang.NumaGuidanceText}"
                             Margin="5 5 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />

            <StackPanel Grid.Row="10"
                        Margin="0 10 0 0">
                <comps:AppConfContainer Header="{Binding Lang.ThreadStrategyTitle}">
                    <comps:AppConfItem Text="{Binding Lang.PreferUpstreamPhysCoresText}">
                        <CheckBox IsChecked="{Binding PreferUpstreamPhysicalCores, Mode=TwoWay}" />
                    </comps:AppConfItem>
                    <comps:AppConfItem Text="{Binding Lang.PreferDownstreamPhysCoresText}">
                        <CheckBox IsChecked="{Binding PreferPhysicalCores, Mode=TwoWay}" />
                    </comps:AppConfItem>
                    <comps:AppConfItem Text="{Binding Lang.PreferPCoreComputeText}">
                        <CheckBox IsChecked="{Binding PreferPCoreCompute, Mode=TwoWay}"
                                  IsEnabled="False"/>
                    </comps:AppConfItem>
                    <comps:AppConfItem Text="{Binding Lang.PreferECoreLookaheadText}">
                        <CheckBox IsChecked="{Binding PreferECoreLookahead, Mode=TwoWay}"
                                  IsEnabled="False" />
                    </comps:AppConfItem>
                </comps:AppConfContainer>

                <comps:AppConfContainer Header="{Binding Lang.MemoryStrategyTitle}"
                                        Margin="0 5 0 0">
                    <comps:HintPanel Text="{Binding LargePagesUnavailableHintText}"
                                     Margin="5 8 5 8" />
                </comps:AppConfContainer>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <comps:TwoButtonGroup Grid.Row="1"
                              DataContext="{Binding FinishButtons}"
                              ButtonHeight="30"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}"
                              Margin="0 15 0 0" />
    </Grid>
</Window>
