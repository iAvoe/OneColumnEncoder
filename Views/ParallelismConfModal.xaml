<Window x:Class="OneColumnEncoder.Views.ParallelismConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ParallelismConfVM}"
        mc:Ignorable="d"
        Title="{Binding Lang.WindowTitle}"
        Width="560"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Lang.IntroText}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="1"
                       Text="{Binding Lang.PriorityText}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="2"
                       Text="{Binding Lang.CacheGroupTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="3"
                       Text="{Binding Lang.CacheGroupHint}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0 5 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <TextBlock Grid.Row="4"
                       Text="{Binding Lang.UpstreamNumaTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <ItemsControl Grid.Row="5"
                          ItemsSource="{Binding UpstreamNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:CPUNodeCard DataContext="{Binding}"
                                           IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                           IsEnabled="{Binding IsEnabled}"
                                           Margin="2.5 5 2.5 0">
                            <cards:CPUNodeCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectUpstreamNodeCmd,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectUpstreamNodeCmd,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                            </cards:CPUNodeCard.InputBindings>
                        </cards:CPUNodeCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="6"
                       Text="{Binding Lang.DownstreamNumaTitle}"
                       Style="{StaticResource H3}"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <ItemsControl Grid.Row="7"
                          ItemsSource="{Binding DownstreamNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <cards:CPUNodeCard DataContext="{Binding}"
                                           IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                           IsEnabled="{Binding IsEnabled}"
                                           Margin="2.5 5 2.5 0">
                            <cards:CPUNodeCard.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectDownstreamNodeCmd,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectDownstreamNodeCmd,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                            </cards:CPUNodeCard.InputBindings>
                        </cards:CPUNodeCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="8"
                       Text="{Binding Lang.NumaGuidanceText}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0 10 0 0"
                       Foreground="{StaticResource GlobalPrimary}" />

            <StackPanel Grid.Row="9"
                        Margin="0 15 0 0">
                <comps:AppConfContainer Header="{Binding Lang.ThreadStrategyTitle}">
                    <comps:AppConfItem Text="{Binding Lang.PreferPhysicalCoresText}">
                        <CheckBox IsChecked="{Binding PreferPhysicalCores, Mode=TwoWay}" />
                    </comps:AppConfItem>
                    <comps:AppConfItem Text="{Binding Lang.PreferPerformanceCoresText}">
                        <CheckBox IsChecked="{Binding PreferPerformanceCores, Mode=TwoWay}" />
                    </comps:AppConfItem>
                </comps:AppConfContainer>

                <comps:AppConfContainer Header="{Binding Lang.MemoryStrategyTitle}">
                    <comps:AppConfItem Text="{Binding Lang.UseLargePagesText}">
                        <CheckBox IsChecked="{Binding UseLargePages, Mode=TwoWay}" />
                    </comps:AppConfItem>
                </comps:AppConfContainer>

                <comps:TwoButtonGroup DataContext="{Binding FinishButtons}"
                                      Button1Command="{Binding Cmd1}"
                                      Button2Command="{Binding Cmd2}"
                                      Button1IsEnabled="{Binding B2_1IsEnabled}"
                                      Button2IsEnabled="{Binding B2_2IsEnabled}"
                                      ButtonHeight="30"
                                      Margin="0 15 0 0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
