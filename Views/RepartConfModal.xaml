<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.RepartConfModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:RepartConfVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="1320"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid IsEnabled="{Binding CanEdit}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <comps:SectionHeader Grid.Row="0"
                                         HeaderText="{Binding TimelineTitle}" />
                    <Border Grid.Row="1"
                            Margin="0 5 0 10"
                            MaxHeight="50"
                            Background="{StaticResource TimelineTrackBackgroundDark}"
                            BorderBrush="{StaticResource TimelineTrackBorderDark}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding TimelineSlices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <comps:RepartTimelinePanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="comps:RepartTimelinePanel.Weight"
                                                Value="{Binding Weight}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                ToolTip="{Binding Tooltip}"
                                                Command="{Binding DataContext.SelectTimelineSliceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="4"
                                                Margin="2.5"
                                                HorizontalContentAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource BaseButton}">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource TimelineThumbBackground}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource TimelineThumbBorder}" />
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource GlobalPrimary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnallocated}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource RemixedBackground4}" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource RemixedBorder4}" />
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource GlobalSecondary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaletteIndex}"
                                                                     Value="1">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource BackgroundGreen}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaletteIndex}"
                                                                     Value="2">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource BackgroundAmber}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaletteIndex}"
                                                                     Value="3">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource RemixedBackground3}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding DividerItems}"
                                          Panel.ZIndex="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <comps:RepartDividerPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="comps:RepartDividerPanel.Position"
                                                Value="{Binding Position}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectDividerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Width="44"
                                                Height="32"
                                                Padding="0"
                                                FontWeight="Bold"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center">
                                            <Button.Content>
                                                <TextBlock Text="|"
                                                           FontSize="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource BaseButton}">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource BackgroundAmber}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource BorderAmber}" />
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource GlobalPrimary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource RemixedBackground4}" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource RemixedBorder4}" />
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource GlobalSecondary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource BackgroundGreen}" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource BorderGreen}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="310" />
                    </Grid.ColumnDefinitions>

                    <comps:RepartSourceSidebarPanel Grid.Column="0"
                                                    VerticalAlignment="Stretch" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <comps:SectionHeader Grid.Row="0"
                                             HeaderText="{Binding TimelineControlTitle}" />
                        <Grid Grid.Row="1"
                              Margin="0 10 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding StartTimeLabel}"
                                       Style="{StaticResource H3}"
                                       Margin="5 0 0 0" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding SegmentDurationLabel}"
                                       Style="{StaticResource H3}"
                                       Margin="5 0 0 0" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="{Binding EndTimeLabel}"
                                       Style="{StaticResource H3}"
                                       Margin="5 0 0 0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="0"
                                     Text="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="5"
                                     Margin="5 5 0 0" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SegmentDurationText}"
                                       Padding="5"
                                       Margin="5 5 0 0"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="2"
                                     Text="{Binding EndTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="5"
                                     Margin="5 5 0 0" />
                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0 10 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding FirstFrameLabel}"
                                       Style="{StaticResource H3}"
                                       Margin="5 0 0 0" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding FrameCountLabel}"
                                       Style="{StaticResource H3}"
                                       Margin="5 0 0 0" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="{Binding LastFrameLabel}"
                                       Style="{StaticResource H3}"
                                       Margin="5 0 0 0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="0"
                                     Text="{Binding FirstFrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="5"
                                     Margin="5 5 0 0" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding FrameCountText}"
                                       Padding="5"
                                       Margin="5 5 0 0"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="2"
                                     Text="{Binding LastFrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="5"
                                     Margin="5 5 0 0" />
                        </Grid>

                        <comps:SectionHeader Grid.Row="3"
                                             Margin="0 15 0 0"
                                             HeaderText="{Binding DividerControlTitle}" />
                        <Grid Grid.Row="4"
                              Margin="0 10 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*"
                                                  MaxWidth="210"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DividerTimestampLabel}"
                                           Style="{StaticResource H3}"
                                           Margin="5 0 0 0" />
                                <TextBox Text="{Binding DividerTimestampText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanNudgeDivider}"
                                         Padding="5"
                                         Margin="5 5 0 0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DividerFrameLabel}"
                                           Style="{StaticResource H3}" />
                                <TextBox Text="{Binding DividerFrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanNudgeDivider}"
                                         Padding="5"
                                         Margin="5 5 0 0" />
                            </StackPanel>
                            <comps:ThreeButtonGroup Grid.Column="2"
                                                    DataContext="{Binding DividerControlButtons}"
                                                    ButtonHeight="25"
                                                    HorizontalAlignment="Stretch"
                                                    Button1Command="{Binding Cmd1}"
                                                    Button2Command="{Binding Cmd2}"
                                                    Button3Command="{Binding Cmd3}"
                                                    Button1IsEnabled="{Binding B3_1IsEnabled}"
                                                    Button2IsEnabled="{Binding B3_2IsEnabled}"
                                                    Button3IsEnabled="{Binding B3_3IsEnabled}"
                                                    Margin="5 20 0 0" />
                        </Grid>

                        <Button Grid.Row="5"
                                Content="{Binding AddDividerText}"
                                Command="{Binding AddEpisodeCommand}"
                                IsEnabled="{Binding CanAddEpisode}"
                                Style="{StaticResource PrimaryButton}"
                                Width="500"
                                Height="40"
                                Margin="0 10 0 0" />

                        <comps:ThreeButtonGroup Grid.Row="6"
                                                DataContext="{Binding DividerSelectionButtons}"
                                                ButtonHeight="30"
                                                HorizontalAlignment="Stretch"
                                                Button1Command="{Binding Cmd1}"
                                                Button2Command="{Binding Cmd2}"
                                                Button3Command="{Binding Cmd3}"
                                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                                Button3IsEnabled="{Binding B3_3IsEnabled}"
                                                Margin="0 10 0 0" />

                        <comps:ThreeButtonGroup Grid.Row="7"
                                                DataContext="{Binding DividerDeleteButtons}"
                                                ButtonHeight="30"
                                                HorizontalAlignment="Stretch"
                                                Button1Command="{Binding Cmd1}"
                                                Button2Command="{Binding Cmd2}"
                                                Button3Command="{Binding Cmd3}"
                                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                                Button3IsEnabled="{Binding B3_3IsEnabled}"
                                                Margin="0 10 0 0" />

                        <comps:TwoButtonGroup Grid.Row="8"
                                              DataContext="{Binding OutputGenerationButtons}"
                                              ButtonHeight="30"
                                              HorizontalAlignment="Stretch"
                                              Button1Command="{Binding Cmd1}"
                                              Button2Command="{Binding Cmd2}"
                                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                                              Button2IsEnabled="{Binding B2_2IsEnabled}"
                                              Margin="0 10 0 0" />
                    </Grid>

                    <Border Grid.Column="4"
                            Background="#F1E6D8"
                            BorderBrush="#BBAC9C"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            VerticalAlignment="Stretch">
                        <DockPanel>
                            <comps:SectionHeader DockPanel.Dock="Top"
                                                 HeaderText="{Binding OutputEpisodesTitle}" />
                            <comps:TwoButtonGroup DockPanel.Dock="Bottom"
                                                  DataContext="{Binding FinishButtons}"
                                                  ButtonHeight="30"
                                                  HorizontalAlignment="Stretch"
                                                  Button1Command="{Binding Cmd1}"
                                                  Button2Command="{Binding Cmd2}"
                                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                                  Margin="0 10 0 0" />
                            <ListBox x:Name="OutputListBox"
                                     ItemsSource="{Binding Outputs}"
                                     SelectionMode="Extended"
                                     SelectionChanged="OutputListBox_SelectionChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <cards:MiniItemCard DataContext="{Binding}"
                                                            IsSelected="{Binding IsSelected}"
                                                            ShowActionButtons="False"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0 5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Margin="0 15 0 0">
            <ProgressBar Width="220"
                         Height="4"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                         VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0 0 0 10">
            <TextBlock Text="{Binding SummaryText}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource GlobalPrimary}" />
            <comps:HintPanel Text="{Binding StatusText}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 5 0 0" />
            <comps:HintPanel Text="{Binding FrameChangingFiltersWarning}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 5 0 0" />
        </StackPanel>
    </Grid>
</ui:AdaptiveWindow>
