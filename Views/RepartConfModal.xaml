<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.RepartConfModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:cards="clr-namespace:OneColumnEncoder.Components.Cards"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:RepartConfVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="1320"
                   SizeToContent="Height"
                   MinWidth="980"
                   MinHeight="640"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Padding="12"
                    Margin="0 0 5 0"
                    Background="{StaticResource RemixedBackground2}"
                    BorderBrush="{StaticResource RemixedBorder2}"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="{Binding InputSourcesTitle}"
                               Style="{StaticResource H3}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Padding="12"
                    Margin="5 0 0 0"
                    Background="{StaticResource RemixedBackground3}"
                    BorderBrush="{StaticResource RemixedBorder3}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Opacity="0.55">
                <StackPanel>
                    <TextBlock Text="{Binding ImportChaptersText}"
                               Style="{StaticResource H3}" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0 7.5 0 0">
                        <Button Content="{Binding ImportMplsText}"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="120" />
                        <TextBlock Text="{Binding UnavailableText}"
                                   Margin="10 0 0 0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource GlobalSecondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0 10 0 10">
            <TextBlock Text="{Binding SummaryText}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource GlobalPrimary}" />
            <comps:HintPanel Text="{Binding StatusText}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 5 0 0" />
            <comps:HintPanel Text="{Binding FrameChangingFiltersWarning}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             Margin="0 5 0 0" />
        </StackPanel>

        <Grid Grid.Row="2"
              IsEnabled="{Binding CanEdit}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"
                               MaxHeight="80"/>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <comps:SectionHeader Grid.Row="0"
                                 HeaderText="{Binding TimelineTitle}" />
            <Border Grid.Row="1"
                    Margin="0 5 0 10"
                    Padding="3"
                    Background="{StaticResource TimelineTrackBackground}"
                    BorderBrush="{StaticResource TimelineTrackBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ItemsControl ItemsSource="{Binding TimelineSlices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <comps:RepartTimelinePanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="comps:RepartTimelinePanel.Weight"
                                    Value="{Binding Weight}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    ToolTip="{Binding Tooltip}"
                                    Command="{Binding DataContext.SelectTimelineSliceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="4"
                                    Margin="2.5"
                                    HorizontalContentAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource BaseButton}">
                                        <Setter Property="Background"
                                                Value="{StaticResource TimelineThumbBackground}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource TimelineThumbBorder}" />
                                        <Setter Property="Foreground"
                                                Value="{StaticResource GlobalPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnallocated}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource RemixedBackground4}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource RemixedBorder4}" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource GlobalSecondary}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaletteIndex}"
                                                         Value="1">
                                                <Setter Property="Background"
                                                        Value="{StaticResource BackgroundGreen}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaletteIndex}"
                                                         Value="2">
                                                <Setter Property="Background"
                                                        Value="{StaticResource BackgroundAmber}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaletteIndex}"
                                                         Value="3">
                                                <Setter Property="Background"
                                                        Value="{StaticResource RemixedBackground3}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource RemixedBackground}"
                        BorderBrush="{StaticResource RemixedBorder}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        VerticalAlignment="Top"
                        MinHeight="300">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    Margin="0 7.5 0 0">
                            <Button Content="{Binding ImportFolderText}"
                                    Command="{Binding ImportFolderCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="120"
                                    Margin="0 0 5 0" />
                            <Button Content="{Binding AppendFilesText}"
                                    Command="{Binding AppendFilesCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="120" />
                        </StackPanel>
                        <comps:SectionHeader DockPanel.Dock="Top"
                                             HeaderText="{Binding InputSourcesTitle}" />
                        <ListBox ItemsSource="{Binding Sources}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <cards:MiniItemCard DataContext="{Binding}"
                                                        IsSelected="{Binding IsSelected}"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0 5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Margin="0 0 5 0">
                            <TextBlock Text="{Binding OutputNameLabel}"
                                       Style="{StaticResource H3}" />
                            <TextBox Text="{Binding OutputNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6"
                                     Margin="0 5 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0 7.5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Margin="0 0 5 0">
                            <TextBlock Text="{Binding StartTimeLabel}"
                                       Style="{StaticResource H3}" />
                            <TextBox Text="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="6"
                                     Margin="0 5 0 0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="5 0 0 0">
                            <TextBlock Text="{Binding EndTimeLabel}"
                                       Style="{StaticResource H3}" />
                            <TextBox Text="{Binding EndTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="6"
                                     Margin="0 5 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0 7.5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Margin="0 0 5 0">
                            <TextBlock Text="{Binding FirstFrameLabel}"
                                       Style="{StaticResource H3}" />
                            <TextBox Text="{Binding FirstFrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="6"
                                     Margin="0 5 0 0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="5 0 0 0">
                            <TextBlock Text="{Binding LastFrameLabel}"
                                       Style="{StaticResource H3}" />
                            <TextBox Text="{Binding LastFrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Padding="6"
                                     Margin="0 5 0 0" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="3"
                               Margin="0 10 0 0"
                               VerticalAlignment="Top">
                        <Button Content="{Binding ApplyEditText}"
                                Command="{Binding ApplyEditCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="105"
                                Margin="0 0 5 5" />
                        <Button Content="{Binding DeleteEpisodeText}"
                                Command="{Binding DeleteEpisodeCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="80"
                                Margin="0 0 5 5" />
                        <Button Content="{Binding MergeEpisodesText}"
                                Command="{Binding MergeEpisodesCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="125"
                                Margin="0 0 5 5" />
                    </WrapPanel>
                </Grid>

                <Border Grid.Column="4"
                        Background="{StaticResource RemixedBackground}"
                        BorderBrush="{StaticResource RemixedBorder}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        VerticalAlignment="Top"
                        MinHeight="300">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom"
                                Content="{Binding AddEpisodeText}"
                                Command="{Binding AddEpisodeCommand}"
                                IsEnabled="{Binding CanAddEpisode}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="105"
                                HorizontalAlignment="Stretch"
                                Margin="0 7.5 0 0" />
                        <comps:SectionHeader DockPanel.Dock="Top"
                                             HeaderText="{Binding OutputEpisodesTitle}" />
                        <ListBox x:Name="OutputListBox"
                                 ItemsSource="{Binding Outputs}"
                                 SelectionMode="Extended"
                                 SelectionChanged="OutputListBox_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <cards:MiniItemCard DataContext="{Binding}"
                                                        IsSelected="{Binding IsSelected}"
                                                        ShowActionButtons="False"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0 5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0 15 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Width="220"
                         Height="4"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                         VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"
                    Height="32"
                    Margin="0 0 7.5 0" />
            <Button Grid.Column="2"
                    Content="{Binding ApplyText}"
                    Command="{Binding ApplyCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="110"
                    Height="32"
                    IsEnabled="{Binding CanApply}" />
        </Grid>
    </Grid>
</ui:AdaptiveWindow>
