<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.RepartConfModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:RepartConfVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="1180"
                   Height="760"
                   MinWidth="900"
                   MinHeight="620"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="{Binding TimelineTitle}"
                       Style="{StaticResource H2}" />
            <TextBlock Text="{Binding SummaryText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource GlobalSecondary}" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0 8 0 0"
              IsEnabled="{Binding CanEdit}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource TimelineTrackBackgroundDark}"
                    BorderBrush="{StaticResource TimelineTrackBorderDark}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <ItemsControl ItemsSource="{Binding TimelineSlices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <comps:RepartTimelinePanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="comps:RepartTimelinePanel.Weight"
                                        Value="{Binding Weight}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2"
                                        Padding="6"
                                        Background="{StaticResource TimelineThumbBackground}"
                                        BorderBrush="{StaticResource TimelineThumbBorder}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding DividerItems}"
                                  Panel.ZIndex="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <comps:RepartDividerPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="comps:RepartDividerPanel.Position"
                                        Value="{Binding Position}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="20"
                                        Height="70"
                                        Padding="0"
                                        ToolTip="{Binding Frame}"
                                        Command="{Binding DataContext.SelectDividerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource BaseButton}">
                                            <Setter Property="Background"
                                                    Value="Transparent" />
                                            <Setter Property="BorderThickness"
                                                    Value="0" />
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource GlobalPrimary}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Width="2"
                                                                Background="{TemplateBinding Foreground}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource BorderGreen}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <Grid Grid.Row="1"
                  Margin="0 5 0 0">
                <TextBlock Text="{Binding TimelineStartText}"
                           Foreground="{StaticResource GlobalSecondary}" />
                <TextBlock Text="{Binding TimelineEndText}"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource GlobalSecondary}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Column="0"
                  Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <comps:SectionHeader HeaderText="{Binding InputSourcesTitle}" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Sources}"
                         Margin="0 8 0 8"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0 3"
                                    Padding="8"
                                    BorderBrush="{StaticResource GlobalSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding P1Text}"
                                               Foreground="{StaticResource GlobalSecondary}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="{Binding ImportMplsText}"
                            IsEnabled="False"
                            Height="32"
                            Margin="0 2">
                        <Button.ToolTip>
                            <TextBlock Text="{Binding ImportMplsText}" />
                        </Button.ToolTip>
                    </Button>
                    <Button Grid.Row="1"
                            Content="{Binding AppendFilesText}"
                            Command="{Binding AppendFilesCommand}"
                            Height="32"
                            Margin="0 2">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{x:Static ui:SvgIconProvider.GamePaste}"
                                           Width="16"
                                           Height="16"
                                           Margin="0 0 6 0" />
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Grid.Row="2"
                            Content="{Binding ImportFolderText}"
                            Command="{Binding ImportFolderCommand}"
                            Height="32"
                            Margin="0 2">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{x:Static ui:SvgIconProvider.GameImport}"
                                           Width="16"
                                           Height="16"
                                           Margin="0 0 6 0" />
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <comps:SectionHeader HeaderText="{Binding BatchOperationsTitle}" />
                <StackPanel Grid.Row="1"
                            Margin="0 10 0 0">
                    <TextBlock Text="{Binding DividerTimestampLabel}"
                               Style="{StaticResource H3}" />
                    <TextBox Text="{Binding NewDividerTimestampText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Padding="6"
                             Margin="0 4 0 8" />
                    <TextBlock Text="{Binding DividerFrameLabel}"
                               Style="{StaticResource H3}" />
                    <TextBox Text="{Binding NewDividerFrameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Padding="6"
                             Margin="0 4 0 0" />
                </StackPanel>
                <Button Grid.Row="2"
                        Content="{Binding AddDividerText}"
                        Command="{Binding AddEpisodeCommand}"
                        IsEnabled="{Binding CanAddEpisode}"
                        Style="{StaticResource PrimaryButton}"
                        Height="38"
                        Margin="0 12 0 0" />
            </Grid>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <comps:SectionHeader HeaderText="{Binding DividerControlTitle}" />
                <Grid Grid.Row="1"
                      Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="{Binding InvertSelectionText}"
                            Command="{Binding InvertDividerSelectionCommand}"
                            IsEnabled="{Binding CanInvertDividerSelection}"
                            Margin="0 0 6 6"
                            Height="34" />
                    <Button Grid.Column="1"
                            Content="{Binding ClearDividersText}"
                            Command="{Binding ClearOutputsCommand}"
                            IsEnabled="{Binding CanClearOutputs}"
                            Margin="6 0 0 6"
                            Height="34" />
                    <Button Grid.Row="1"
                            Content="{Binding DeleteLeftDividerText}"
                            Command="{Binding DeleteLeftDividerCommand}"
                            IsEnabled="{Binding CanDeleteLeftDivider}"
                            Margin="0 6 6 0"
                            Height="34" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="{Binding DeleteRightDividerText}"
                            Command="{Binding DeleteRightDividerCommand}"
                            IsEnabled="{Binding CanDeleteRightDivider}"
                            Margin="6 6 0 0"
                            Height="34" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Grid.Column="2"
                  Grid.ColumnSpan="3"
                  Margin="0 25 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <comps:SectionHeader HeaderText="{Binding OutputEpisodesTitle}" />
                    <TextBlock Text="{Binding OutputCountText}"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource GlobalSecondary}" />
                </Grid>
                <ScrollViewer Grid.Row="1"
                              Margin="0 8 0 0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0 3"
                                        Padding="8"
                                        BorderBrush="{StaticResource GlobalSecondary}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FrameRangeText}"
                                                       Foreground="{StaticResource GlobalSecondary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FrameCountText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource GlobalSecondary}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="4"
              Margin="0 15 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}"
                           Margin="0 5 0 0"
                           Foreground="{StaticResource GlobalSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    Height="38"
                    MinWidth="160"
                    Margin="10 0 0 0">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:SvgIconProvider.GameXMark}"
                                   Width="16"
                                   Height="16"
                                   Margin="0 0 6 0" />
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
            <Button Grid.Column="2"
                    Content="{Binding ApplyText}"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CanApply}"
                    Style="{StaticResource PrimaryButton}"
                    Height="38"
                    MinWidth="180"
                    Margin="10 0 0 0">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:SvgIconProvider.GameSave}"
                                   Width="16"
                                   Height="16"
                                   Margin="0 0 6 0" />
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </Grid>
    </Grid>
</ui:AdaptiveWindow>
