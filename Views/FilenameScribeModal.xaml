<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.FilenameScribeModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:FilenameScribeVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="560"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="15 12.5 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filename textbox header mini title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding MiniHeader}"
                           Style="{StaticResource H4}" />

                <!-- Filename textbox + extension group -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding VideoFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="{Binding VideoFilenameFontSize}"
                             Padding="0 2.5"
                             VerticalContentAlignment="Center"
                             TextWrapping="NoWrap"
                             AcceptsReturn="False">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground"
                                        Value="{StaticResource GlobalPrimary}" />
                                <Style.Triggers>
                                    <Trigger Property="Text"
                                             Value="">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource GlobalTertiary}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Column="0"
                               Text="{Binding PlaceholderText}"
                               Margin="5 0 0 5"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource GlobalTertiary}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VideoFilename}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ExtensionText}"
                               Margin="7.5 0 0 0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource GlobalSecondary}" />
                </Grid>


                <!-- Copy from clipboard, rotate textbox fontsize -->
                <comps:TwoButtonGroup Grid.Row="2"
                                      Margin="0 10 0 0"
                                      ButtonHeight="30"
                                      DataContext="{Binding FilenameActionButtons}"
                                      Button1Command="{Binding Cmd1}"
                                      Button2Command="{Binding Cmd2}" />

                <!-- Hint: extension is fixed -->
                <comps:HintPanel Grid.Row="3"
                                 Text="{Binding FooterHint}"
                                 Margin="0 2.5 0 0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center" />

                <!-- Preview on text pruning effects -->
                <StackPanel Grid.Row="4"
                            Margin="0 10 0 0">
                    <TextBlock Text="{Binding PreviewHeader}"
                               Style="{StaticResource H2}" />

                    <TextBlock Text="{Binding Preview30Label}"
                               Margin="0 10 0 0"
                               Style="{StaticResource H3}" />
                    <TextBlock Text="{Binding VideoFilename}"
                               Width="420"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               FontSize="14"
                               Foreground="{StaticResource GlobalPrimary}" />

                    <TextBlock Text="{Binding Preview25Label}"
                               Margin="0 10 0 0"
                               Style="{StaticResource H3}" />
                    <TextBlock Text="{Binding VideoFilename}"
                               Width="350"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               FontSize="14"
                               Foreground="{StaticResource GlobalPrimary}" />

                    <TextBlock Text="{Binding Preview20Label}"
                               Margin="0 10 0 0"
                               Style="{StaticResource H3}" />
                    <TextBlock Text="{Binding VideoFilename}"
                               Width="280"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               FontSize="14"
                               Foreground="{StaticResource GlobalPrimary}" />

                    <TextBlock Text="{Binding Preview15Label}"
                               Margin="0 10 0 0"
                               Style="{StaticResource H3}" />
                    <TextBlock Text="{Binding VideoFilename}"
                               Width="210"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               FontSize="14"
                               Foreground="{StaticResource GlobalPrimary}" />
                </StackPanel>

                <!-- Row 5: Validation checklist -->
                <StackPanel Grid.Row="5"
                            Margin="0 15 0 0">
                    <TextBlock Text="{Binding FormatCheckHeader}"
                               Style="{StaticResource H2}" />

                    <TextBlock Text="{Binding SevereIssueHeader}"
                               Margin="0 10 0 0"
                               Style="{StaticResource H3}" />
                    <comps:ChecklistContainer Margin="0 5 0 0"
                                              ItemsSource="{Binding SevereIssueChecklist}">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Margin="0 5" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>

                    <TextBlock Text="{Binding GeneralIssueHeader}"
                               Margin="0 10 0 0"
                               Style="{StaticResource H3}" />
                    <comps:ChecklistContainer Margin="0 5 0 0"
                                              ItemsSource="{Binding GeneralIssueChecklist}">
                        <comps:ChecklistContainer.ItemTemplate>
                            <DataTemplate>
                                <comps:ChecklistItem Text="{Binding Text}"
                                                     Status="{Binding Status}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Margin="0 5" />
                            </DataTemplate>
                        </comps:ChecklistContainer.ItemTemplate>
                    </comps:ChecklistContainer>
                </StackPanel>

                <!-- Row 6: Media scraping compatibility self-checklist -->
                <StackPanel Grid.Row="6"
                            Margin="0 10 0 0">
                    <TextBlock Text="{Binding SelfCheckHeader}"
                               Style="{StaticResource H3}" />

                    <TextBlock Text="{Binding SelfCheckDate}"
                               Margin="0 10 0 0"
                               FontSize="13"
                               Foreground="{StaticResource GlobalPrimary}" />
                    <TextBlock Text="{Binding SelfCheckSeason}"
                               Margin="0 10 0 0"
                               FontSize="13"
                               Foreground="{StaticResource GlobalPrimary}" />
                    <TextBlock Text="{Binding SelfCheckVersion}"
                               Margin="0 10 0 0"
                               FontSize="13"
                               Foreground="{StaticResource GlobalPrimary}" />
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Cancel, Confirm -->
        <comps:TwoButtonGroup Grid.Row="7"
                              Margin="0 15 0 0"
                              ButtonHeight="30"
                              DataContext="{Binding FilenameFinishButtons}"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}" />
    </Grid>
</ui:AdaptiveWindow>
