<Window x:Class="OneColumnEncoder.Views.FilenameScribeModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:FilenameScribeModalVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="560"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding HeaderText}"
                   Foreground="{StaticResource GlobalPrimary}"
                   Style="{StaticResource H1}" />

        <Grid Grid.Row="1"
              Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding VideoFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"
                     Padding="5 3"
                     VerticalContentAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground"
                                Value="{StaticResource GlobalPrimary}" />
                        <Style.Triggers>
                            <Trigger Property="Text"
                                     Value="">
                                <Setter Property="Foreground"
                                        Value="{StaticResource GlobalTertiary}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock Grid.Column="0"
                       Text="{Binding PlaceholderText}"
                       Margin="7 0 0 0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource GlobalTertiary}"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VideoFilename}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="1"
                       Text="{Binding ExtensionText}"
                       Margin="8 0 0 0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{StaticResource GlobalSecondary}" />
        </Grid>

        <comps:ChecklistContainer Grid.Row="2"
                                  Margin="0 15 0 0"
                                  ItemsSource="{Binding FilenameChecklist}">
            <comps:ChecklistContainer.ItemTemplate>
                <DataTemplate>
                    <comps:ChecklistItem Text="{Binding Text}"
                                         Status="{Binding Status}"
                                         Margin="0 5" />
                </DataTemplate>
            </comps:ChecklistContainer.ItemTemplate>
        </comps:ChecklistContainer>

        <StackPanel Grid.Row="3"
                    Margin="0 10 0 0">
            <TextBlock Text="{Binding AutoRuleDate}"
                       Margin="0 5"
                       FontSize="14"
                       Foreground="{StaticResource GlobalPrimary}" />
            <TextBlock Text="{Binding AutoRuleSeason}"
                       Margin="0 5"
                       FontSize="14"
                       Foreground="{StaticResource GlobalPrimary}" />
            <TextBlock Text="{Binding AutoRuleVersion}"
                       Margin="0 5"
                       FontSize="14"
                       Foreground="{StaticResource GlobalPrimary}" />
        </StackPanel>

        <comps:ThreeButtonGroup Grid.Row="4"
                                Margin="0 20 0 0"
                                DataContext="{Binding FilenameButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />

        <TextBlock Grid.Row="5"
                   Text="{Binding FooterHint}"
                   Margin="0 10 0 0"
                   FontSize="11"
                   Foreground="{StaticResource GlobalTertiary}" />
    </Grid>
</Window>
