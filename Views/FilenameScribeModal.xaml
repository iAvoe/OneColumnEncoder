<Window x:Class="OneColumnEncoder.Views.FilenameScribeModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:FilenameScribeModalVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="560"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding MiniHeader}"
                   Style="{StaticResource H4}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding VideoFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"
                     Padding="0 2.5"
                     VerticalContentAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground"
                                Value="{StaticResource GlobalPrimary}" />
                        <Style.Triggers>
                            <Trigger Property="Text"
                                     Value="">
                                <Setter Property="Foreground"
                                        Value="{StaticResource GlobalTertiary}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock Grid.Column="0"
                       Text="{Binding PlaceholderText}"
                       Margin="10 0 0 0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource GlobalTertiary}"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VideoFilename}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="1"
                       Text="{Binding ExtensionText}"
                       Margin="5 0 0 0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{StaticResource GlobalSecondary}" />
        </Grid>

        <comps:ChecklistContainer Grid.Row="2"
                                  Margin="0 10 0 0"
                                  ItemsSource="{Binding FilenameChecklist}">
            <comps:ChecklistContainer.ItemTemplate>
                <DataTemplate>
                    <comps:ChecklistItem Text="{Binding Text}"
                                         Status="{Binding Status}"
                                         IsEnabled="{Binding IsEnabled}"
                                         Margin="0 5" />
                </DataTemplate>
            </comps:ChecklistContainer.ItemTemplate>
        </comps:ChecklistContainer>

        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding SelfCheckDate}"
                       Margin="0 5"
                       FontSize="13"
                       Foreground="{StaticResource GlobalPrimary}" />
            <TextBlock Text="{Binding SelfCheckSeason}"
                       Margin="0 5"
                       FontSize="13"
                       Foreground="{StaticResource GlobalPrimary}" />
            <TextBlock Text="{Binding SelfCheckVersion}"
                       Margin="0 5"
                       FontSize="13"
                       Foreground="{StaticResource GlobalPrimary}" />
        </StackPanel>

        <comps:ThreeButtonGroup Grid.Row="4"
                                Margin="0 10 0 0"
                                ButtonHeight="30"
                                DataContext="{Binding FilenameButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />

        <StackPanel Grid.Row="5"
                    Margin="5 1.25 5 0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <Rectangle Width="10"
                       Height="10"
                       VerticalAlignment="Center"
                       Fill="{StaticResource GlobalTertiary}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                                Stretch="Uniform" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock FontSize="9"
                       Focusable="False"
                       Margin="3.5 0 0 0"
                       Text="{Binding FooterHint}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource GlobalTertiary}" />
        </StackPanel>
    </Grid>
</Window>
