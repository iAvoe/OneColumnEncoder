<Window x:Class="OneColumnEncoder.Views.ScriptSrcScribeModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OneColumnEncoder.Views"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Lang.WindowTitle}"
        Width="520"
        Height="950"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"
                           MinHeight="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Lang.Title}"
                   Foreground="{StaticResource GlobalPrimary}"
                   Style="{StaticResource H1}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding Lang.ScribeDescription1}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />
        <TextBlock Grid.Row="2"
                   Text="{Binding Lang.ScribeDescription2}"
                   Margin="0 5 0 0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />

        <!-- Select tab: AviSynth, VapourSynth script -->
        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0 15 0 10">
            <TabItem Header="AviSynth (.avs)"
                     Padding="15 6">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FFFFFF"
                            Padding="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox Text="{Binding AvsPrefix, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#666666"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                                <TextBox Text="{Binding AvsUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="#F1F5F9"
                                         Foreground="#0F52BA"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="140"
                                         Padding="6"
                                         Margin="0 4" />
                                <TextBox Text="{Binding AvsSuffix, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#666666"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  Cursor="SizeNS" />
                </Grid>
            </TabItem>

            <TabItem Header="VapourSynth (.vpy)"
                     Padding="15 6">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FFFFFF"
                            Padding="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox Text="{Binding VpyPrefix, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#666666"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                                <TextBox Text="{Binding VpyUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="#F0FDF4"
                                         Foreground="#166534"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="140"
                                         Padding="6"
                                         Margin="0 4" />
                                <TextBox Text="{Binding VpySuffix, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#666666"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  Cursor="SizeNS" />
                </Grid>
            </TabItem>
        </TabControl>
        
        <comps:ThreeButtonGroup Grid.Row="4"
                                Margin="0 5 0 0"
                                DataContext="{Binding ScriptExportButtons}" />

        <TextBlock Grid.Row="5"
                   Text="{Binding Lang.NoteText}"
                   Margin="0 15 0 5"
                   FontWeight="Bold"
                   FontSize="13"
                   Foreground="{StaticResource GlobalPrimary}" />

        <comps:TwoButtonGroup Grid.Row="6"
                              Margin="0 5 0 0"
                              DataContext="{Binding FinishScribeButtons}" />

    </Grid>
</Window>
