<Window x:Class="OneColumnEncoder.Views.ScriptSrcScribeModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OneColumnEncoder.Views"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="520"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ScribeDescription1}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding ScribeDescription2}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />

        <!-- Select tab: AviSynth, VapourSynth script -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0 20 0 0">

            <TabItem Header="{Binding TabAvs}"
                     Padding="15 7.5">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            CornerRadius="5">
                        <TextBox Text="{Binding AvsPrefix, Mode=OneWay}"
                                 Height="40"
                                 VerticalAlignment="Stretch"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                    </Border>
                    <TextBox Grid.Row="1"
                             Text="{Binding AvsUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="#F1F5F9"
                             Foreground="#0F52BA"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="5"
                             FontSize="13"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel" />
                    <TextBox Grid.Row="2"
                             Text="{Binding AvsSuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 10 0 0" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabVpy}"
                     Padding="15 7.5">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            CornerRadius="5">
                        <TextBox Text="{Binding VpyPrefix, Mode=OneWay}"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                    </Border>
                    <TextBox Grid.Row="1"
                             Text="{Binding VpyUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="#F0FDF4"
                             Foreground="#166534"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="5"
                             FontSize="13"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel" />
                    <TextBox Grid.Row="2"
                             Text="{Binding VpySuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 10 0 0" />
                </Grid>
            </TabItem>
        </TabControl>

        <comps:ThreeButtonGroup Grid.Row="3"
                                Margin="0 10 0 0"
                                DataContext="{Binding ScriptExportButtons}" />

        <TextBlock Grid.Row="4"
                   Text="{Binding NoteText}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   Foreground="{StaticResource GlobalPrimary}" />

        <comps:TwoButtonGroup Grid.Row="5"
                              Margin="0 10 0 10"
                              DataContext="{Binding FinishScribeButtons}" />

    </Grid>
</Window>
