<Window x:Class="OneColumnEncoder.Views.AppConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OneColumnEncoder.Views"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:vm="clr-namespace:OneColumnEncoder.ViewModels"
        mc:Ignorable="d"
        Title="1cenc Settings"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   Foreground="{StaticResource GlobalPrimary}"
                   Style="{StaticResource H2}"
                   Margin="10"/>

        <ScrollViewer Grid.Row="1"
                      Padding="20"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SettingsListing}" />
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <comps:TwoButtonGroup DataContext="{Binding ConfirmCancelButtons}"
                                  Button1Command="{Binding CancelCmd}"
                                  Button2Command="{Binding ConfirmCmd}"
                                  Margin="0 0 0 20" />
        </StackPanel>
    </Grid>
</Window>