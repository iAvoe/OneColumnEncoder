<UserControl x:Class="OneColumnEncoder.Components.AppConfModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OneColumnEncoder.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="{StaticResource GlobalPrimary}"
            BorderThickness="1.5"
            SnapsToDevicePixels="True"
            CornerRadius="20"
            Padding="17.5 20"
            Background="{StaticResource Background}">
        <Grid>
            <!-- The Mask
                Keep the background solid so the Alpha is 1.0.
                IsHitTestVisible="False": so it doesn't interfere with clicks
                Placed behind the ListView -->
            <Border x:Name="MaskBorder"
                    Background="Black"
                    BorderBrush="Black"
                    BorderThickness="0"
                    CornerRadius="10"
                    IsHitTestVisible="False" />
            <!-- Setting titles and items -->
            <ListView BorderThickness="0"
                      Background="Transparent"
                      Margin="10"
                      ItemsSource="{Binding SettingsListing}">
                <ListView.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=MaskBorder}" />
                </ListView.OpacityMask>
                
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Center" />
                        <Setter Property="Padding"
                                Value="10" />
                        <Setter Property="Margin"
                                Value="0" />

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="10"
                                            Margin="{TemplateBinding Margin}"
                                            Padding="{TemplateBinding Padding}"
                                            UseLayoutRounding="True">
                                        <ContentPresenter />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <!-- Color change on hover -->
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#E5E5E5" />
                                        </Trigger>

                                        <!-- Color change on select -->
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#D0E5FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <!-- List Items -->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- We cannot access x:Name behind DataTemplate, so we use a separate XAML for it -->
                        
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
