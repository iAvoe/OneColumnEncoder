<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.SrcReviserModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:SrcReviserVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="450"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="15 10 15 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SettingsHeader}"
                       Style="{StaticResource H3}" />
            <CheckBox Margin="0 8 0 0"
                      Content="{Binding RotateLabel}"
                      IsChecked="{Binding IsRotated, Mode=TwoWay}" />
            <Grid Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0 5"
                           Text="{Binding CurrentResolutionLabel}"
                           Style="{StaticResource H4}"
                           VerticalAlignment="Center" />
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="{Binding CurrentResolutionText}"
                        Command="{Binding UseCurrentResolutionCommand}"
                        Width="125"
                        Height="25"
                        VerticalAlignment="Center"
                        Style="{StaticResource NormalButton}" />

                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Height="5" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0 5"
                           Text="{Binding CropResolutionLabel}"
                           Style="{StaticResource H4}"
                           VerticalAlignment="Center" />
                <Button Grid.Row="2"
                        Grid.Column="1"
                        Content="{Binding CropResolutionText}"
                        Command="{Binding UseCropResolutionCommand}"
                        Width="125"
                        Height="25"
                        VerticalAlignment="Center"
                        Style="{StaticResource NormalButton}" />

                <Border Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Height="5" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Margin="0 5"
                           Text="{Binding SuggestedResolutionLabel}"
                           Style="{StaticResource H4}"
                           VerticalAlignment="Center" />
                <Button Grid.Row="4"
                        Grid.Column="1"
                        Content="{Binding SuggestedResolutionText}"
                        Command="{Binding UseSuggestedResolutionCommand}"
                        Width="125"
                        Height="25"
                        VerticalAlignment="Center"
                        Style="{StaticResource NormalButton}" />

                <Border Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Height="5" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Margin="0 5"
                           Text="{Binding UpscaleResolutionLabel}"
                           Style="{StaticResource H4}"
                           VerticalAlignment="Center" />
                <Button Grid.Row="6"
                        Grid.Column="1"
                        Content="{Binding UpscaleResolutionText}"
                        Command="{Binding UseUpscaleResolutionCommand}"
                        IsEnabled="{Binding HasUpscale}"
                        Width="125"
                        Height="25"
                        VerticalAlignment="Center"
                        Style="{StaticResource NormalButton}" />
            </Grid>

            <comps:AppConfItem Text="{Binding WidthLabel}"
                               Margin="0 5 0 0">
                <TextBox Width="120"
                         Text="{Binding ResolutionWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Left"
                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                         DataObject.Pasting="NumericTextBox_Pasting" />
            </comps:AppConfItem>
            <comps:AppConfItem Text="{Binding HeightLabel}">
                <TextBox Width="120"
                         Text="{Binding ResolutionHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Left"
                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                         DataObject.Pasting="NumericTextBox_Pasting" />
            </comps:AppConfItem>
        </StackPanel>

        <comps:TwoButtonGroup Grid.Row="1"
                              ButtonHeight="30"
                              DataContext="{Binding FinishButtons}"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}" />

        <comps:HintPanel Grid.Row="2"
                         Margin="0 2.5 0 0"
                         Text="{Binding Description}" />
        <comps:HintPanel Grid.Row="3"
                         Text="{Binding EvenResolutionHint}" />

    </Grid>
</ui:AdaptiveWindow>
