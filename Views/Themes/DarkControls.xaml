<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comps="clr-namespace:OneColumnEncoder.Components">

    <!--
    Dark-only implicit styles for controls that otherwise use light system templates.
     This dictionary is merged only while the Dark theme is active, so the light
     appearance stays byte-for-byte unchanged.
     -->

     <!-- Default text element -->
     <Style TargetType="TextBlock">
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <!-- Default label -->
     <Style TargetType="Label">
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <!-- Heading styles - extend base styles with dark foreground -->
     <Style TargetType="TextBlock"
            x:Key="H1">
         <Setter Property="FontSize"
                 Value="18" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="Control"
            x:Key="H1C">
         <Setter Property="FontSize"
                 Value="18" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="TextBlock"
            x:Key="H2">
         <Setter Property="FontSize"
                 Value="15" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="Control"
            x:Key="H2C">
         <Setter Property="FontSize"
                 Value="15" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="TextBlock"
            x:Key="H3">
         <Setter Property="FontSize"
                 Value="13" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="Control"
            x:Key="H3C">
         <Setter Property="FontSize"
                 Value="13" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="TextBlock"
            x:Key="H4">
         <Setter Property="FontSize"
                 Value="11" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="TextBlock"
            x:Key="H4Normal">
         <Setter Property="FontSize"
                 Value="11" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <Style TargetType="Control"
            x:Key="H4C">
         <Setter Property="FontSize"
                 Value="11" />
         <Setter Property="FontWeight"
                 Value="Bold" />
         <Setter Property="Foreground"
                 Value="{DynamicResource GlobalPrimary}" />
     </Style>

     <!-- Text input -->
    <Style TargetType="TextBox">
        <Setter Property="Background"
                Value="{DynamicResource MemoryRangeEmpty}" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlobalTertiary}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="SelectionBrush"
                Value="{DynamicResource BackgroundAzure2}" />
        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource GlobalPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource GlobalSecondary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource BorderAzure}" />
            </Trigger>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource GlobalTertiary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="RichTextBox">
        <Setter Property="Background"
                Value="{DynamicResource MemoryRangeEmpty}" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlobalTertiary}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="SelectionBrush"
                Value="{DynamicResource BackgroundAzure2}" />
        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource GlobalPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource GlobalSecondary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource BorderAzure}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Check box -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal"
                                Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                CornerRadius="3"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource GlobalTertiary}"
                                Background="{DynamicResource Background}"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckGlyph"
                                  Data="M 3,8 L 6.5,11.5 L 13,4"
                                  Stroke="{DynamicResource GlobalPrimary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="7 0 0 0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="CheckGlyph"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource BackgroundAzure2}" />
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BorderAzure}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GlobalSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource GlobalTertiary}" />
                            <Setter TargetName="Box"
                                    Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List boxes -->
    <Style TargetType="ListBox">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlobalTertiary}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="Padding"
                Value="4 2" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource BackgroundAzure2}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource BackgroundAzure2}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource GlobalPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource GlobalTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool tips -->
    <Style TargetType="ToolTip">
        <Setter Property="Background"
                Value="{DynamicResource MemoryRangeEmpty}" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlobalTertiary}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="6 4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background"
                Value="{DynamicResource MemoryRangeEmpty}" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlobalTertiary}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="4">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="8 5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconPresenter"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0 0 6 0"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource GlobalTertiary}"
                                           Margin="16 0 0 0"
                                           VerticalAlignment="Center" />
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Data="M 0 0 L 4 4 L 0 8"
                                      Stroke="{DynamicResource GlobalPrimary}"
                                      StrokeThickness="1.5"
                                      Margin="8 0 0 0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right"
                               HorizontalOffset="-4"
                               VerticalOffset="-4">
                            <Border Background="{DynamicResource MemoryRangeEmpty}"
                                    BorderBrush="{DynamicResource GlobalTertiary}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="HeaderBorder"
                                    Property="Background"
                                    Value="{DynamicResource BackgroundAzure2}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="IconPresenter"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource GlobalTertiary}" />
                            <Setter TargetName="SubmenuArrow"
                                    Property="Stroke"
                                    Value="{DynamicResource GlobalTertiary}" />
                        </Trigger>
                        <Trigger Property="Role"
                                 Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height"
                Value="1" />
        <Setter Property="Margin"
                Value="4 3" />
        <Setter Property="Background"
                Value="{DynamicResource GlobalTertiary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab control -->
    <Style TargetType="TabControl">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlobalTertiary}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel"
                                  Grid.Row="0"
                                  IsItemsHost="True"
                                  Background="Transparent"
                                  Margin="2 2 2 0" />
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0 4 4 4"
                                Padding="4">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource GlobalSecondary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource GlobalTertiary}" />
        <Setter Property="BorderThickness"
                Value="1 1 1 0" />
        <Setter Property="Padding"
                Value="12 6" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4 4 0 0"
                            Padding="{TemplateBinding Padding}"
                            Margin="0 0 2 0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource BackgroundAzure2}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource GlobalPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource MemoryRangeEmpty}" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BorderAzure}" />
                            <Setter TargetName="Border"
                                    Property="BorderThickness"
                                    Value="1 2 1 0" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource GlobalPrimary}" />
                            <Setter Property="Panel.ZIndex"
                                    Value="100" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource GlobalTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
