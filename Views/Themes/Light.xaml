<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme identification marker -->
    <SolidColorBrush x:Key="ThemePaletteMarker"
                     Color="Transparent" />

    <!-- Core semantic palette -->
    <SolidColorBrush Color="#111"
                     x:Key="GlobalPrimary" />
    <SolidColorBrush Color="#6C767D"
                     x:Key="GlobalSecondary" />
    <SolidColorBrush Color="#939CA2"
                     x:Key="GlobalTertiary" />
    <SolidColorBrush Color="#4A5458"
                     x:Key="GlobalQuaternary" />
    <SolidColorBrush Color="#EA6B66"
                     x:Key="BorderRed" />
    <SolidColorBrush Color="#67AB9F"
                     x:Key="BorderGreen" />
    <SolidColorBrush Color="#679FAB"
                     x:Key="BorderAzure" />
    <SolidColorBrush Color="#6C3082"
                     x:Key="BorderEmience" />
    <SolidColorBrush Color="#D8BFD8"
                     x:Key="BorderThistle" />
    <SolidColorBrush Color="#D4A017"
                      x:Key="BorderAmber" />
    <SolidColorBrush Color="#9673A6"
                     x:Key="BorderPurple" />
    <SolidColorBrush Color="#98568D"
                     x:Key="BorderPurpleish" />
    <SolidColorBrush Color="#FAFAFA"
                     x:Key="Background" />
    <SolidColorBrush Color="#FEF7F7"
                     x:Key="BackgroundRed" />
    <SolidColorBrush Color="#F1FBF9"
                     x:Key="BackgroundGreen" />
    <SolidColorBrush Color="#F1F9FB"
                     x:Key="BackgroundAzure" />
    <SolidColorBrush Color="#A3C5CF"
                     x:Key="BackgroundAzure2" />
    <SolidColorBrush Color="#FFF8E1"
                     x:Key="BackgroundAmber" />
    <SolidColorBrush Color="#BBFFFF"
                     x:Key="BackgroundTeal" />
    <SolidColorBrush Color="#E6E6FA"
                     x:Key="BackgroundLavender" />
    <SolidColorBrush Color="#A3CCC5"
                     x:Key="BackgroundGreen2" />
    <SolidColorBrush Color="#75AEAC"
                     x:Key="BorderLowSatGreen" />
    <SolidColorBrush Color="#009587"
                     x:Key="CorrectTeal" />
    <SolidColorBrush Color="#F68819"
                     x:Key="WarningOrange" />
    <SolidColorBrush Color="#95000E"
                     x:Key="ErrorRed" />
    <SolidColorBrush Color="#ECECE7"
                      x:Key="MuxTrackSourceBackground" />
    <SolidColorBrush Color="#5E5E5C"
                      x:Key="MuxTrackSourceBorder" />
    <SolidColorBrush Color="#D8D7DD"
                      x:Key="MuxTrackUserBackground" />
    <SolidColorBrush Color="#454546"
                      x:Key="MuxTrackUserBorder" />
    <SolidColorBrush Color="#343A40"
                      x:Key="ButtonPrimary" />
    <SolidColorBrush Color="#878574"
                      x:Key="ButtonTertiary" />
    <!-- Disabled button palette (light: matches previous appearance) -->
    <SolidColorBrush Color="#6C767D"
                      x:Key="ButtonDisabledForeground" />
    <SolidColorBrush Color="#FAFAFA"
                      x:Key="ButtonDisabledBackground" />
    <SolidColorBrush Color="#939CA2"
                      x:Key="ButtonDisabledBorder" />
    <SolidColorBrush Color="#2FA34F"
                      x:Key="ProgressGreen" />
    <SolidColorBrush Color="#2F4FA3"
                      x:Key="ProgressAzure" />
    <SolidColorBrush Color="#F1F5F9"
                      x:Key="ScriptAccentAvsBackground" />
    <SolidColorBrush Color="#0F52BA"
                      x:Key="ScriptAccentAvsForeground" />
    <SolidColorBrush Color="#F0FDF4"
                      x:Key="ScriptAccentVpyBackground" />
    <SolidColorBrush Color="#166534"
                      x:Key="ScriptAccentVpyForeground" />
    <SolidColorBrush Color="#FBF0FD"
                      x:Key="ScriptAccentFFmpegBackground" />
    <SolidColorBrush Color="#5C1665"
                      x:Key="ScriptAccentFFmpegForeground" />
    <SolidColorBrush Color="#D9CAE4"
                      x:Key="TimelineTrackBackground" />
    <SolidColorBrush Color="#9673A6"
                      x:Key="TimelineTrackBorder" />
    <SolidColorBrush Color="#664281"
                     x:Key="TimelineTrackBackgroundDark" />
    <SolidColorBrush Color="#4E3858"
                     x:Key="TimelineTrackBorderDark" />
    <SolidColorBrush Color="#F5E6A4"
                      x:Key="TimelineThumbBackground" />
    <SolidColorBrush Color="#D2B45A"
                      x:Key="TimelineThumbBorder" />
    <!-- Card palettes -->
    <!-- Default card palette (light gray blue background) -->
    <SolidColorBrush Color="#BAD3D2"
                     x:Key="RemixedBackground" />
    <SolidColorBrush Color="#002B33"
                     x:Key="RemixedForeground" />
    <SolidColorBrush Color="#235D59"
                     x:Key="RemixedBorder" />
    <SolidColorBrush Color="#808080"
                     x:Key="RemixedDisabledForeground" />
    <SolidColorBrush Color="#2A3A3A"
                     x:Key="RemixedBackgroundGreen" />
    <SolidColorBrush Color="#3A3A2A"
                     x:Key="RemixedBackgroundDarkYellow" />
    <SolidColorBrush Color="#3A2A2A"
                     x:Key="RemixedBackgroundRed" />
    <!-- Alternate card palette (light gray green background) -->
    <SolidColorBrush Color="#BAC8D3"
                     x:Key="RemixedBackground2" />
    <SolidColorBrush Color="#013"
                     x:Key="RemixedForeground2" />
    <SolidColorBrush Color="#23445D"
                     x:Key="RemixedBorder2" />

    <!-- Alternate card palette (light pink background) -->
    <SolidColorBrush Color="#EAD6BC"
                     x:Key="RemixedBackground3" />
    <SolidColorBrush Color="#27200C"
                     x:Key="RemixedForeground3" />
    <SolidColorBrush Color="#62411E"
                     x:Key="RemixedBorder3" />

    <!-- Alternate card palette (light olive background) -->
    <SolidColorBrush Color="#d5d7b6"
                     x:Key="RemixedBackground4" />
    <SolidColorBrush Color="#1c1f14"
                     x:Key="RemixedForeground4" />
    <SolidColorBrush Color="#4e4e32"
                     x:Key="RemixedBorder4" />
    
    <!-- Memory range palette: empty block and level colors -->
    <SolidColorBrush Color="#E9EEF2"
                     x:Key="MemoryRangeEmpty" />

    <!-- Upstream program (yellow to orange occupancy family) -->
    <SolidColorBrush Color="#FFF8E1"
                     x:Key="MemoryRangeUpstream1" />
    <SolidColorBrush Color="#FFECB3"
                     x:Key="MemoryRangeUpstream2" />
    <SolidColorBrush Color="#FFE082"
                     x:Key="MemoryRangeUpstream3" />
    <SolidColorBrush Color="#FFD54F"
                     x:Key="MemoryRangeUpstream4" />
    <SolidColorBrush Color="#FFCA28"
                     x:Key="MemoryRangeUpstream5" />
    <SolidColorBrush Color="#FFB300"
                     x:Key="MemoryRangeUpstream6" />
    <SolidColorBrush Color="#FF8F00"
                     x:Key="MemoryRangeUpstream7" />
    <SolidColorBrush Color="#E65100"
                     x:Key="MemoryRangeUpstream8" />

    <!-- Downstream program / encoder (pink to maroon occupancy family) -->
    <SolidColorBrush Color="#FCE4EC"
                     x:Key="MemoryRangeDownstream1" />
    <SolidColorBrush Color="#F8BBD0"
                     x:Key="MemoryRangeDownstream2" />
    <SolidColorBrush Color="#F48FB1"
                     x:Key="MemoryRangeDownstream3" />
    <SolidColorBrush Color="#F06292"
                     x:Key="MemoryRangeDownstream4" />
    <SolidColorBrush Color="#E91E63"
                     x:Key="MemoryRangeDownstream5" />
    <SolidColorBrush Color="#C2185B"
                     x:Key="MemoryRangeDownstream6" />
    <SolidColorBrush Color="#AD1457"
                     x:Key="MemoryRangeDownstream7" />
    <SolidColorBrush Color="#880E4F"
                     x:Key="MemoryRangeDownstream8" />

    <!-- Other programs (light blue to navy occupancy family) -->
    <SolidColorBrush Color="#E3F2FD"
                     x:Key="MemoryRangeOther1" />
    <SolidColorBrush Color="#BBDEFB"
                     x:Key="MemoryRangeOther2" />
    <SolidColorBrush Color="#90CAF9"
                     x:Key="MemoryRangeOther3" />
    <SolidColorBrush Color="#64B5F6"
                     x:Key="MemoryRangeOther4" />
    <SolidColorBrush Color="#42A5F5"
                     x:Key="MemoryRangeOther5" />
    <SolidColorBrush Color="#1E88E5"
                     x:Key="MemoryRangeOther6" />
    <SolidColorBrush Color="#1565C0"
                     x:Key="MemoryRangeOther7" />
    <SolidColorBrush Color="#0D47A1"
                     x:Key="MemoryRangeOther8" />

    <!-- System cache (pale green to deep green occupancy family) -->
    <SolidColorBrush Color="#E8F5E9"
                     x:Key="MemoryRangeCache1" />
    <SolidColorBrush Color="#C8E6C9"
                     x:Key="MemoryRangeCache2" />
    <SolidColorBrush Color="#A5D6A7"
                     x:Key="MemoryRangeCache3" />
    <SolidColorBrush Color="#81C784"
                     x:Key="MemoryRangeCache4" />
    <SolidColorBrush Color="#66BB6A"
                     x:Key="MemoryRangeCache5" />
    <SolidColorBrush Color="#4CAF50"
                     x:Key="MemoryRangeCache6" />
    <SolidColorBrush Color="#2E7D32"
                     x:Key="MemoryRangeCache7" />
    <SolidColorBrush Color="#1B5E20"
                     x:Key="MemoryRangeCache8" />

    <!-- Script tool card palette -->
    <SolidColorBrush Color="#FAD7AC"
                     x:Key="ScriptRemixedBackground" />
    <SolidColorBrush Color="#663300"
                     x:Key="ScriptRemixedForeground" />
    <SolidColorBrush Color="#B46504"
                     x:Key="ScriptRemixedBorder" />
    <SolidColorBrush Color="#808080"
                     x:Key="ScriptRemixedDisabledForeground" />
    <SolidColorBrush Color="#2A3A3A"
                     x:Key="ScriptRemixedBackgroundGreen" />
    <SolidColorBrush Color="#3A2A2A"
                     x:Key="ScriptRemixedBackgroundRed" />

    <!-- Theme support colors -->
    <SolidColorBrush Color="#30679FAB"
                     x:Key="DragDropHighlight" />
    <SolidColorBrush Color="#F0F8FF"
                     x:Key="StatusBadgeBackground" />
    <SolidColorBrush Color="#10739E"
                     x:Key="StatusBadgeForeground" />
    <SolidColorBrush Color="#006C767D"
                     x:Key="ProgressStripeBackground" />
    <SolidColorBrush Color="#5A6C767D"
                     x:Key="ProgressStripeForeground" />

</ResourceDictionary>
