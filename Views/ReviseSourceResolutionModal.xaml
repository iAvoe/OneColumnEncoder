<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.ReviseSourceResolutionModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:ReviseSourceResolutionVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="520"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Description}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />

        <Grid Grid.Row="1"
              Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding CurrentResolutionLabel}"
                           Style="{StaticResource H3}" />
                <TextBlock Text="{Binding CurrentResolutionText}"
                           FontSize="13"
                           Margin="0 4 0 0"
                           Foreground="{StaticResource GlobalSecondary}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="12 0 0 0">
                <TextBlock Text="{Binding SuggestedResolutionLabel}"
                           Style="{StaticResource H3}" />
                <TextBlock Text="{Binding SuggestedResolutionText}"
                           FontSize="13"
                           Margin="0 4 0 0"
                           Foreground="{StaticResource GlobalSecondary}" />
            </StackPanel>
        </Grid>

        <comps:AppConfContainer Grid.Row="2"
                                Header="{Binding SettingsHeader}"
                                Margin="0 14 0 0">
            <comps:AppConfItem Text="{Binding WidthLabel}">
                <TextBox Width="180"
                         Text="{Binding ResolutionWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Right"
                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                         DataObject.Pasting="NumericTextBox_Pasting" />
            </comps:AppConfItem>
            <comps:AppConfItem Text="{Binding HeightLabel}">
                <TextBox Width="180"
                         Text="{Binding ResolutionHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Right"
                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                         DataObject.Pasting="NumericTextBox_Pasting" />
            </comps:AppConfItem>
        </comps:AppConfContainer>

        <comps:TwoButtonGroup Grid.Row="3"
                              ButtonHeight="30"
                              Margin="0 10 0 0"
                              DataContext="{Binding FinishButtons}"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}" />
    </Grid>
</ui:AdaptiveWindow>
