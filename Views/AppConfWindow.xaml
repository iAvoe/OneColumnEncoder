<Window x:Class="OneColumnEncoder.Views.AppConfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OneColumnEncoder.Views"
        xmlns:vm="clr-namespace:OneColumnEncoder.ViewModels"
        mc:Ignorable="d"
        Title="1cenc Settings"
        Width="600"
        Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource GlobalPrimary}"
                Padding="20,15">
            <TextBlock Text="Application Settings"
                       Foreground="{StaticResource Background}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="20"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SettingsListing}" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource GlobalPrimary}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Close"
                        Click="CloseButton_Click"
                        Width="100"
                        Height="32"
                        Background="{StaticResource ButtonPrimary}"
                        Foreground="{StaticResource Background}"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>