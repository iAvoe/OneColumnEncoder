<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.BdPlaylistSelectModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:BdPlaylistSelectVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="1180"
                   Height="760"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="{Binding WindowTitle}"
                       Style="{StaticResource H2}" />
            <TextBlock Text="{Binding SummaryText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource GlobalSecondary}" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0 15 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <comps:SectionHeader HeaderText="{Binding ClustersTitle}" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Clusters}"
                         SelectedItem="{Binding SelectedCluster, Mode=TwoWay}"
                         Margin="0 15 0 0"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0 0 0 5"
                                    Padding="8"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    BorderBrush="{StaticResource GlobalSecondary}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PlaylistCount, StringFormat={}{0} playlist(s)}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DurationText, StringFormat=Duration: {0}}"
                                               Foreground="{StaticResource GlobalSecondary}" />
                                    <TextBlock Text="{Binding ClipSequenceText}"
                                               Foreground="{StaticResource GlobalSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SamplePlaylistIdsText, StringFormat=Playlists: {0}}"
                                               Foreground="{StaticResource GlobalSecondary}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="1"
                  Margin="15 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <comps:SectionHeader HeaderText="{Binding PlaylistsTitle}" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                         Margin="0 15 0 0"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0 0 0 5"
                                    Padding="8"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    BorderBrush="{StaticResource GlobalSecondary}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DurationText, StringFormat=Duration: {0}}"
                                               Foreground="{StaticResource GlobalSecondary}" />
                                    <TextBlock Text="{Binding ChapterCount, StringFormat={}{0} chapters}"
                                               Foreground="{StaticResource GlobalSecondary}" />
                                    <TextBlock Text="{Binding ClipSequenceText}"
                                               Foreground="{StaticResource GlobalSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <comps:TwoButtonGroup Grid.Row="2"
                              ButtonHeight="30"
                              DataContext="{Binding FooterButtons}"
                              Button1Command="{Binding Cmd1}"
                              Button2Command="{Binding Cmd2}"
                              Button1IsEnabled="{Binding B2_1IsEnabled}"
                              Button2IsEnabled="{Binding B2_2IsEnabled}"
                              Margin="0 15 0 0" />
    </Grid>
</ui:AdaptiveWindow>
