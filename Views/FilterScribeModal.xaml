                                             TickLabels="{Binding ScaleTickLabels}"
                                             TickCount="5"
                                             Step="{Binding ScaleStep}">
                            <comps:IntegerSlider.Style>
                                <Style TargetType="comps:IntegerSlider">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScaleApplicable}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </comps:IntegerSlider.Style>
                        </comps:IntegerSlider>
                        <!-- N/A -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ScaleNotApplicableText}"
                                   Margin="0 0 0 5"
                                   Foreground="{StaticResource ButtonTertiary}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScaleApplicable}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Resolution display -->
                        <Border Grid.Column="1"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScaleApplicable}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TargetDisplay}"
                                       Foreground="{StaticResource GlobalSecondary}"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>

                     <TextBox Margin="0 2.5 0 0"
                              Padding="0 2.5"
                              Text="{Binding SelectedResizeFilterDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             FontWeight="Normal" />
                    <comps:HintPanel Margin="0 2.5 0 0"
                                     Text="{Binding ScaleHint}"
                                     FontWeight="Normal" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsBlurSharpenSectionVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BlurSharpenTitle}"
                                   Style="{StaticResource H3}"
                                   Margin="0 15 0 0" />
                        <Button Grid.Column="1"
                                Visibility="{Binding IsAvsTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertAvsFilterCommand}"
                                CommandParameter="{Binding AviSynthBlurFilter}"
                                ToolTip="Blur"
                                Style="{StaticResource AppendLinkButton}" />
                        <Button Grid.Column="2"
                                Visibility="{Binding IsAvsTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertAvsFilterCommand}"
                                CommandParameter="{Binding AviSynthAsharpFilter}"
                                ToolTip="ASharp"
                                Style="{StaticResource AppendLinkButton}" />
                        <Button Grid.Column="1"
                                Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertVpyFilterCommand}"
                                CommandParameter="{Binding VapourSynthBlurFilter}"
                                ToolTip="BoxBlur"
                                Style="{StaticResource AppendLinkButton}" />
                        <Button Grid.Column="2"
                                Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertVpyFilterCommand}"
                                CommandParameter="{Binding VapourSynthASharpFilter}"
                                ToolTip="ASharp"
                                Style="{StaticResource AppendLinkButton}" />
                    </Grid>
                     <TextBox Text="{Binding SelectedBlurSharpenFilterDisplay, Mode=OneWay}"
                              Visibility="{Binding IsScriptTabSelected, Converter={StaticResource BoolToVisibility}}"
                             Margin="0 2.5 0 0"
                             Padding="0 2.5"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             VerticalAlignment="Center" />

                </StackPanel>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SubtitleBurnTitle}"
                                   Style="{StaticResource H3}"
                                   Margin="0 15 0 0" />

                        <Button Grid.Column="1"
                                Visibility="{Binding IsAvsTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertAvsFilterCommand}"
                                CommandParameter="{Binding AviSynthAssRenderFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                        <Button Grid.Column="1"
                                Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertVpyFilterCommand}"
                                CommandParameter="{Binding VapourSynthSubtitleFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                        <Button Grid.Column="1"
                                Visibility="{Binding IsFFmpegTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertFFmpegFilterCommand}"
                                CommandParameter="{Binding FFmpegSubtitleFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                    </Grid>
                     <TextBox Text="{Binding SelectedSubtitleFilterDisplay, Mode=OneWay}"
                             Margin="0 2.5 0 0"
                             Padding="0 2.5"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsFFmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding MultiFilterAssemblyTitle}"
                               Style="{StaticResource H3}"
                               Margin="0 15 0 0" />
                    <TextBox Margin="0 2.5 0 0"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             VerticalAlignment="Center"
                             Text="3 -filter:v &quot;fps=_,libplacebo=color_primaries=_:color_trc=_:colorspace=_,scale=_:_&quot;&#x0a;4 -filter:v &quot;fps=_,libplacebo=reset_sar=_,libplacebo=color_primaries=_:color_trc=_:colorspace=_,scale=_:_&quot;&#x0a;5 -filter:v &quot;hqdn3d,fps=_,libplacebo=reset_sar=_,libplacebo=color_primaries=_:color_trc=_:colorspace=_,scale=_:_&quot;" />
                </StackPanel>

                <!-- VS-zipcl GPU OpenCL filter example (VapourSynth only) -->
                <StackPanel Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding VSZipCLTitle}"
                                   Style="{StaticResource H3}"
                                   Margin="0 15 0 0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding InsertVpyFilterCommand}"
                                CommandParameter="{Binding VSZipCLFilter}"
                                IsEnabled="{Binding CanInsertVSZipCLFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                    </Grid>
                    <!-- OpenCL device ID, default 0 -->
                    <ItemsControl ItemsSource="{Binding VSZipCLSettingsListing}" />
                    <!-- Filter script line -->
                    <TextBox Padding="0 2.5"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal"
                             Text="{Binding VSZipCLFilter, Mode=OneWay}" />

                    <comps:HintPanel Margin="0 2.5 0 0"
                                     Text="{Binding VSZipCLPreviewHint}" />
                    <comps:HintPanel Margin="0 2.5 0 0"
                                     Text="{Binding VSZipCLDeviceHint}" />
                    <comps:HintPanel Margin="0 2.5 0 0"
                                     Visibility="{Binding VSZipCLHasFmtconv, Converter={StaticResource BoolToVisibility}}"
                                     Text="{Binding VSZipCLFmtconvHint}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <comps:ThreeButtonGroup Grid.Row="3"
                                Margin="0 15 0 0"
                                ButtonHeight="30"
                                DataContext="{Binding FinishScribeButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />

        <comps:HintPanel Grid.Row="4"
                         Margin="0 5 0 0"
                         Text="{Binding NoteText}" />
    </Grid>
</ui:AdaptiveWindow>
