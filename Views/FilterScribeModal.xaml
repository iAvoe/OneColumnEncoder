<helpers:AdaptiveWindow x:Class="OneColumnEncoder.Views.FilterScribeModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OneColumnEncoder.Views"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:FilterScribeVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="710"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ScribeDescription1}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding ScribeDescription2}"
                   Margin="0 10 0 0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />

        <!-- TabControl: AviSynth, VapourSynth, ffmpeg -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0 15 0 0">

            <TabItem Header="{Binding TabAvs}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="80" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding AvsPrefix, Mode=OneWay}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="1"
                             Text="{Binding AvsPrefix2, Mode=OneWay}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding AvsUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="#F1F5F9"
                             Foreground="#0F52BA"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="5"
                             FontSize="13"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             Margin="0 5 0 0"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding AvsSuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 5 0 0"
                             FontWeight="Normal" />
                    <CheckBox Grid.Row="4"
                              Content="{Binding AvsEnableFpsParamsLabel}"
                              IsChecked="{Binding AvsEnableFpsParams}"
                              IsEnabled="{Binding IsFrameRateApplicable}"
                              Margin="0 5 0 0"
                              FontWeight="Normal"
                              Foreground="{StaticResource GlobalSecondary}" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabVpy}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="80" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding VpyPrefix, Mode=OneWay}"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="1"
                             Text="{Binding VpyPrefix2, Mode=OneWay}"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding VpyUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="#F0FDF4"
                             Foreground="#166534"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="5"
                             FontSize="13"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             Margin="0 5 0 0"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding VpySuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 5 0 0"
                             FontWeight="Normal" />
                    <CheckBox Grid.Row="4"
                              Content="{Binding VpyEnableFpsParamsLabel}"
                              IsChecked="{Binding VpyEnableFpsParams}"
                              IsEnabled="{Binding IsFrameRateApplicable}"
                              Margin="0 5 0 0"
                              FontWeight="Normal"
                              Foreground="{StaticResource GlobalSecondary}" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabFfmpeg}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding FfmpegFreeTextHint}"
                               FontSize="12"
                               Foreground="{StaticResource GlobalSecondary}"
                               TextWrapping="Wrap"
                               Margin="5 0 0 10"
                               FontWeight="Normal"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding FfmpegFreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="#FBF0FD"
                             Foreground="#5C1665"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="5"
                             FontSize="13"
                             FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             FontWeight="Normal" />
                </Grid>
            </TabItem>
        </TabControl>

        <comps:ThreeButtonGroup Grid.Row="3"
                                Margin="0 10 0 0"
                                ButtonHeight="30"
                                DataContext="{Binding ScriptExportButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />
        
        <!-- Resolution Scaling Section -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ResolutionScaleTitle}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />

        <Grid Grid.Row="5"
              Margin="0 2.5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"
                                  MinWidth="60" />
            </Grid.ColumnDefinitions>

            <!-- Scaling slider (visible when applicable) -->
            <comps:IntegerSlider Grid.Column="0"
                                 Label="{Binding ScalePercentLabel}"
                                 Minimum="10"
                                 Maximum="100"
                                 Value="{Binding ScalePercent}"
                                 TickLabels="{Binding ScaleTickLabels}"
                                 TickCount="5"
                                 Step="1" >
                <comps:IntegerSlider.Style>
                    <Style TargetType="comps:IntegerSlider">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScaleApplicable}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </comps:IntegerSlider.Style>
            </comps:IntegerSlider>

            <!-- Warning when scaling not applicable -->
            <TextBlock Grid.Column="0"
                       Text="{Binding ScaleNotApplicableText}"
                       FontSize="12"
                       Margin="0 0 0 5"
                       Foreground="{StaticResource ButtonTertiary}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScaleApplicable}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Target resolution display -->
            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Margin="5 0 0 0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScaleApplicable}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding TargetDisplay}"
                           Foreground="{StaticResource GlobalSecondary}"
                           FontSize="11"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
        
        <!-- Auto-generated Filters Section -->
        <StackPanel Grid.Row="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding FfmpegAutoFilter}"
                           FontSize="11"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Margin="5 0 0 0"
                         Text="{Binding FfmpegResizeFilter, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource Background}"
                         Foreground="{StaticResource ButtonTertiary}"
                         FontSize="11"
                         FontFamily="Segoe UI"
                         VerticalScrollBarVisibility="Disabled" />
            </Grid>
            <Grid Margin="0 5 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding VapourSynthAutoFilter}"
                           FontSize="11"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Margin="5 0 0 0"
                         Text="{Binding VapourSynthResizeFilter, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource Background}"
                         Foreground="{StaticResource ButtonTertiary}"
                         FontSize="11"
                         FontFamily="Segoe UI"
                         VerticalScrollBarVisibility="Disabled" />
            </Grid>
            <Grid Margin="0 5 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding AviSynthAutoFilter}"
                           FontSize="11"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Margin="5 0 0 0"
                         Text="{Binding AviSynthResizeFilter, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource Background}"
                         Foreground="{StaticResource ButtonTertiary}"
                         FontSize="11"
                         FontFamily="Segoe UI"
                         VerticalScrollBarVisibility="Disabled" />
            </Grid>
        </StackPanel>

        <!-- VFR -> CFR Framerate Conversion Section -->
        <TextBlock Grid.Row="7"
                   Text="{Binding FrameRateConvertTitle}"
                   Style="{StaticResource H3}"
                   Margin="0 15 0 0" />

        <StackPanel Grid.Row="8"
                    Margin="0 5 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding FfmpegAutoFilter}"
                           FontSize="11"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Margin="5 0 0 0"
                         Text="{Binding FfmpegFpsFilter, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource Background}"
                         Foreground="{StaticResource ButtonTertiary}"
                         FontSize="11"
                         FontFamily="Segoe UI"
                         VerticalScrollBarVisibility="Disabled" />
            </Grid>
            <Grid Margin="0 3 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="ffmpeg::"
                           FontSize="11"
                           Foreground="{StaticResource GlobalSecondary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Margin="5 0 0 0"
                         Text="{Binding FfmpegCombinedFilter, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource Background}"
                         Foreground="{StaticResource ButtonTertiary}"
                         FontSize="11"
                         FontFamily="Segoe UI"
                         VerticalScrollBarVisibility="Disabled" />
            </Grid>
        </StackPanel>

        <comps:ThreeButtonGroup Grid.Row="10"
                                Margin="0 10 0 0"
                                ButtonHeight="30"
                                DataContext="{Binding FinishScribeButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />
        
        <comps:HintPanel Grid.Row="11"
                         Margin="0 5 0 5"
                         Text="{Binding NoteText}" />
    </Grid>
</helpers:AdaptiveWindow>
