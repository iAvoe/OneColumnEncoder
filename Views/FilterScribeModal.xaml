<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.FilterScribeModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:OneColumnEncoder.Views"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:FilterScribeVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="740"
                   SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <Grid Margin="15 12.5 15 15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"
                           MaxHeight="350" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <comps:ConcatSrcSidebarPanel Grid.Column="0"
                                     Grid.RowSpan="6"
                                     DataContext="{Binding ConcatSources}"
                                     Margin="0 0 10 0">
            <comps:ConcatSrcSidebarPanel.Style>
                <Style TargetType="comps:ConcatSrcSidebarPanel">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsConcatMode, RelativeSource={RelativeSource AncestorType=ui:AdaptiveWindow}}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.CanEditConcatSources, RelativeSource={RelativeSource AncestorType=ui:AdaptiveWindow}}"
                                     Value="False">
                            <Setter Property="IsEnabled"
                                    Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsRepartMode, RelativeSource={RelativeSource AncestorType=ui:AdaptiveWindow}}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </comps:ConcatSrcSidebarPanel.Style>
        </comps:ConcatSrcSidebarPanel>

        <comps:RepartFilterScribeSidebarPanel Grid.Column="0"
                                              Grid.RowSpan="6"
                                              DataContext="{Binding RepartOutputs}"
                                              Margin="0 0 10 0">
            <comps:RepartFilterScribeSidebarPanel.Style>
                <Style TargetType="comps:RepartFilterScribeSidebarPanel">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsRepartMode, RelativeSource={RelativeSource AncestorType=ui:AdaptiveWindow}}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </comps:RepartFilterScribeSidebarPanel.Style>
        </comps:RepartFilterScribeSidebarPanel>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Text="{Binding ScribeDescription}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />

        <!-- TabControl: AviSynth, VapourSynth, ffmpeg -->
        <TabControl Grid.Row="1"
                    Grid.Column="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0 15 0 0">

            <TabItem Header="{Binding TabAvs}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 2.5">
                    <Grid.RowDefinitions>
                        <!-- Note: if modifying VS or ffmpeg tab height, go below -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding AvsPrefix, Mode=OneWay}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal"
                             MaxHeight="80"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBox Grid.Row="1"
                             Text="{Binding AvsPrefix2, Mode=OneWay}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding AvsUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource ScriptAccentAvsBackground}"
                             Foreground="{StaticResource ScriptAccentAvsForeground}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="2.5"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             Margin="0 2.5 0 0"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding AvsSuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             Margin="0 2.5 0 0"
                             FontWeight="Normal" />
                    <CheckBox Grid.Row="4"
                              Content="{Binding AvsEnableFpsParamsLabel}"
                              IsChecked="{Binding AvsEnableFpsParams}"
                              IsEnabled="{Binding IsFrameRateApplicable}"
                              Margin="0 2.5 0 0"
                              FontWeight="DemiBold"
                              Foreground="{StaticResource GlobalSecondary}" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabVpy}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 2.5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="80" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding VpyPrefix, Mode=OneWay}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal"
                             MaxHeight="110"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBox Grid.Row="1"
                             Text="{Binding VpyPrefix2, Mode=OneWay}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding VpyUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource ScriptAccentVpyBackground}"
                             Foreground="{StaticResource ScriptAccentVpyForeground}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="2.5"
                             FontSize="12"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             Margin="0 2.5 0 0"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding VpySuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             Margin="0 2.5 0 0"
                             FontWeight="Normal" />
                    <CheckBox Grid.Row="4"
                              Content="{Binding VpyEnableFpsParamsLabel}"
                              IsChecked="{Binding VpyEnableFpsParams}"
                              IsEnabled="{Binding IsFrameRateApplicable}"
                              Margin="0 2.5 0 0"
                              FontWeight="DemiBold"
                              Foreground="{StaticResource GlobalSecondary}" />
                    <Button Grid.Row="2"
                            Command="{Binding OpenVpyPreviewCommand}"
                            IsEnabled="{Binding CanOpenVpyPreview}"
                            Height="30"
                            Width="120"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0 2.5 0 0"
                            Panel.ZIndex="1"
                            Style="{StaticResource TealButton}"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Rectangle Width="14"
                                       Height="14"
                                       VerticalAlignment="Center"
                                       Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GamePlay}"
                                                Stretch="Uniform"
                                                AlignmentX="Center"
                                                AlignmentY="Center" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="A/B Preview"
                                       VerticalAlignment="Center"
                                       FontWeight="Normal"
                                       Margin="5 0 0 0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabFfmpeg}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 2.5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="170" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding FfmpegConcatFileList, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             Padding="2.5"
                             FontSize="12"
                             MaxHeight="170"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsConcatMode, Converter={StaticResource BoolToVisibility}}"
                             FontWeight="Normal" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding FfmpegFreeTextHint}"
                               FontSize="12"
                               Foreground="{StaticResource GlobalSecondary}"
                               TextWrapping="Wrap"
                               Margin="5 0 0 0"
                               FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding FfmpegFreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource ScriptAccentFfmpegBackground}"
                             Foreground="{StaticResource ScriptAccentFfmpegForeground}"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             Margin="0 2.5 0 0"
                             Padding="2.5"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Disabled"
                             PreviewKeyDown="FfmpegFreeText_PreviewKeyDown"
                             DataObject.Pasting="FfmpegFreeText_Pasting"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             FontWeight="Normal" />
                </Grid>
            </TabItem>
        </TabControl>

        <comps:ThreeButtonGroup Grid.Row="2"
                                Grid.Column="1"
                                Margin="0 10 0 0"
                                ButtonHeight="30"
                                DataContext="{Binding ScriptExportButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />

        <StackPanel Grid.Row="3"
                    Grid.Column="1">
            <StackPanel Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FrameRateConvertTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 20 0 0" />
                <Grid Margin="0 2.5 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding FfmpegText}"
                               FontSize="11"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding FfmpegFpsFilter, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             FontSize="11" />
                </Grid>
            </StackPanel>

            <StackPanel Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SarRepairTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 15 0 0" />
                <Grid Margin="0 5 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding FfmpegText}"
                               FontSize="11"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding FfmpegSarRepairFilter, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             FontSize="11" />
                </Grid>
            </StackPanel>

            <StackPanel Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ColorSpaceConvertTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 15 0 0" />
                <StackPanel Margin="0 2.5 0 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LowToHighColorFilterLabel}"
                                   FontSize="11"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FfmpegLowToHighColorFilter, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 FontSize="11" />
                    </Grid>
                    <Grid Margin="0 3 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding HighToLowColorFilterLabel}"
                                   FontSize="11"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FfmpegHighToLowColorFilter, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 FontSize="11" />
                    </Grid>
                    <Grid Margin="0 3 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding HdrToSdrColorFilterLabel}"
                                   FontSize="11"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FfmpegHdrToSdrColorFilter, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 FontSize="11" />
                    </Grid>
                    <Grid Margin="0 3 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding HighHdrToLowSdrColorFilterLabel}"
                                   FontSize="11"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FfmpegHighHdrToLowSdrColorFilter, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 FontSize="11" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <comps:HintPanel Margin="0 2.5 0 0"
                             Text="{Binding ColorSpacePeakNitsHint}"
                             Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Visibility="{Binding IsDenoiseSectionVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding DenoiseTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 20 0 0" />
                <Grid Margin="0 5 0 0"
                      Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding FfmpegText}"
                               FontSize="11"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding FfmpegHqdn3dDenoiseFilter, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             FontSize="11" />
                </Grid>
                <Grid Margin="0 5 0 0"
                      Visibility="{Binding IsAvsTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding AviSynthText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Margin="5 2.5 0 0"
                             Padding="2.5"
                             Text="{Binding AviSynthHqdn3dDenoiseFilter, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             FontSize="11" />
                </Grid>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding ResolutionScaleTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 20 0 0" />

                <Grid Margin="0 2.5 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"
                                          MinWidth="60" />
                    </Grid.ColumnDefinitions>

                    <comps:IntegerSlider Grid.Column="0"
                                         Label=""
                                         Minimum="{Binding ScaleHeightMinimum}"
                                         Maximum="{Binding ScaleHeightMaximum}"
                                         Value="{Binding ScaleHeight}"
                                         TickLabels="{Binding ScaleTickLabels}"
                                         TickCount="5"
                                         Step="{Binding ScaleStep}">
                        <comps:IntegerSlider.Style>
                            <Style TargetType="comps:IntegerSlider">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleApplicable}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </comps:IntegerSlider.Style>
                    </comps:IntegerSlider>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ScaleNotApplicableText}"
                               FontSize="12"
                               Margin="0 0 0 5"
                               Foreground="{StaticResource ButtonTertiary}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleApplicable}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Margin="5 0 0 0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleApplicable}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TargetDisplay}"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Margin="0 10 0 0">
                    <Grid Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="47.5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="5 0 0 0"
                                   Text="{Binding FfmpegText}"
                                   FontSize="11"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="5 2.5 0 0"
                                 Padding="2.5"
                                 Text="{Binding FfmpegResizeFilter, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 FontSize="11"
                                 FontWeight="Normal" />
                    </Grid>
                    <Grid Margin="0 5 0 0"
                          Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="5 0 0 0"
                                   Text="{Binding VapourSynthText}"
                                   FontSize="11"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="5 2.5 0 0"
                                 Padding="2.5"
                                 Text="{Binding VapourSynthResizeFilter, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 FontSize="11"
                                 FontWeight="Normal" />
                    </Grid>
                    <Grid Margin="5 5 0 0"
                          Visibility="{Binding IsAvsTabSelected, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding AviSynthText}"
                                   FontSize="11"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="5 2.5 0 0"
                                 Padding="2.5"
                                 Text="{Binding AviSynthResizeFilter, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 FontSize="11"
                                 FontWeight="Normal" />
                    </Grid>

                    <comps:HintPanel Margin="5 2.5 0 0"
                                     Text="{Binding ScaleHint}"
                                     FontWeight="Normal" />
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding SubtitleBurnTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 15 0 0" />
                <Grid Margin="0 2.5 0 0"
                      Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding FfmpegText}"
                               FontSize="11"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding FfmpegSubtitleFilter, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             FontSize="11" />
                </Grid>
                <Grid Margin="0 5 0 0"
                      Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding VapourSynthText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding VapourSynthSubtitleFilter, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             FontSize="11" />
                </Grid>
                <Grid Margin="0 5 0 0"
                      Visibility="{Binding IsAvsTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding AviSynthText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource GlobalSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding AviSynthAssRenderFilter, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontSize="11" />
                </Grid>
            </StackPanel>

            <StackPanel Visibility="{Binding IsFfmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding MultiFilterAssemblyTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 15 0 0" />
                <TextBox Margin="0 2.5 0 0"
                         IsReadOnly="True"
                         BorderThickness="0"
                         FontFamily="{DynamicResource CodeFont}"
                         Background="{StaticResource Background}"
                         Foreground="{StaticResource ButtonTertiary}"
                         FontSize="10"
                         VerticalAlignment="Center"
                         Text="ffmpeg::: -filter:v &quot;fps=30000/1001,zscale=matrix=bt709:primaries=bt709:transfer=bt709,scale=1280:720&quot;&#x0a;ffmpeg:::: -filter:v &quot;fps=30000/1001,libplacebo=reset_sar=1,zscale=matrix=bt709:primaries=bt709:transfer=bt709,scale=1280:720&quot;&#x0a;ffmpeg::::: -filter:v &quot;hqdn3d,fps=30000/1001,libplacebo=reset_sar=1,zscale=matrix=bt709:primaries=bt709:transfer=bt709,scale=1280:720&quot;" />
            </StackPanel>

            <!-- VS-zipcl GPU OpenCL filter example (VapourSynth only) -->
            <StackPanel Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding VapourSynthVszipclTitle}"
                           Style="{StaticResource H3}"
                           Margin="0 15 0 0" />
                <TextBox Margin="0 2.5 0 0"
                         IsReadOnly="True"
                         BorderThickness="0"
                         FontFamily="{DynamicResource CodeFont}"
                         Background="{StaticResource Background}"
                         Foreground="{StaticResource ButtonTertiary}"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         Padding="2.5"
                         FontSize="11"
                         FontWeight="Normal"
                         Text="{Binding VapourSynthVszipclFilter, Mode=OneWay}" />
                <comps:HintPanel Margin="0 2.5 0 0"
                                 Text="{Binding VapourSynthVszipclPreviewHint}" />
                <comps:HintPanel Margin="0 2.5 0 0"
                                 Text="{Binding VapourSynthVszipclDeviceHint}" />
                <comps:HintPanel Margin="0 2.5 0 0"
                                 Visibility="{Binding VapourSynthVszipclHasFmtconv, Converter={StaticResource BoolToVisibility}}"
                                 Text="{Binding VapourSynthVszipclFmtconvHint}" />
            </StackPanel>
        </StackPanel>

        <comps:ThreeButtonGroup Grid.Row="4"
                                Grid.Column="1"
                                Margin="0 15 0 0"
                                ButtonHeight="30"
                                DataContext="{Binding FinishScribeButtons}"
                                Button1Command="{Binding Cmd1}"
                                Button2Command="{Binding Cmd2}"
                                Button3Command="{Binding Cmd3}"
                                Button1IsEnabled="{Binding B3_1IsEnabled}"
                                Button2IsEnabled="{Binding B3_2IsEnabled}"
                                Button3IsEnabled="{Binding B3_3IsEnabled}" />

        <comps:HintPanel Grid.Row="5"
                         Grid.Column="1"
                         Margin="0 5 0 0"
                         Text="{Binding NoteText}" />
    </Grid>
</ui:AdaptiveWindow>
