<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.FilterScribeModal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:OneColumnEncoder.Views"
                   xmlns:comps="clr-namespace:OneColumnEncoder.Components"
                   xmlns:ui="clr-namespace:OneColumnEncoder.UI"
                   xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
                   d:DataContext="{d:DesignInstance Type=vms:FilterScribeVM}"
                   mc:Ignorable="d"
                   Title="{Binding WindowTitle}"
                   Width="760"
                   MinHeight="1180"
                   WindowStartupLocation="CenterOwner"
                   Background="{StaticResource Background}">
    <ui:AdaptiveWindow.Resources>
        <Style x:Key="AppendLinkButton"
               TargetType="Button"
               BasedOn="{StaticResource LinkButton}">
            <Setter Property="ToolTip"
                    Value="Insert filter" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="VerticalAlignment"
                    Value="Bottom" />
            <Setter Property="Content"
                    Value="+" />
            <Setter Property="FontSize"
                    Value="22" />
        </Style>

        <ControlTemplate x:Key="ScribeScrollViewerTemplate"
                         TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}" />

                <ScrollBar x:Name="PART_HorizontalScrollBar"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Orientation="Horizontal"
                           ViewportSize="{TemplateBinding ViewportWidth}"
                           Maximum="{TemplateBinding ScrollableWidth}"
                           Minimum="0"
                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                           Value="{TemplateBinding HorizontalOffset}" />

                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="1"
                           Orientation="Vertical"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           Minimum="0"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                           Value="{TemplateBinding VerticalOffset}" />

                <Rectangle x:Name="ScrollCorner"
                           Grid.Row="1"
                           Grid.Column="1"
                           Visibility="Collapsed" />
            </Grid>
        </ControlTemplate>

        <!--
        Fix: H-V scrollbar region overlap on the tab code TextBoxes (Grid.Row="0" of TabAvs, TabVpy, TabFFmpeg).
        Same fix as EncodingMonitor log viewer (SplitTextCard.xaml / commit 289b015)
        the default ScrollViewer template is replaced with a 2x2 Grid where the horizontal bar spans the
        full bottom row, the vertical bar spans the full right column, and the corner Rectangle is collapsed
        so the bars can never draw an intersecting corner box. ScribeCodeBox below wires the TextBox template
        to this ScrollViewer and forwards ScrollViewer.H/VScrollBarVisibility via TemplateBinding.
        -->
        <Style x:Key="ScribeCodeBox"
               TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          Template="{StaticResource ScribeScrollViewerTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:AdaptiveWindow.Resources>
    <Grid Margin="15 12.5 15 15">
        <!--
        Top description
        TabControl filter text editor
        ScrollViewer filter generator
        Bottom Buttons
        Bottom HintPanel
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"
                           MaxHeight="300" />
            <RowDefinition Height="*"
                           MinHeight="480" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ScribeDescription}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource GlobalPrimary}" />

        <!-- TabControl: AviSynth, VapourSynth, ffmpeg -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0 12.5 0 0">

            <TabItem Header="{Binding TabAvs}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 2.5">
                    <Grid.RowDefinitions>
                        <!-- Note: if modifying VS or ffmpeg tab height, go below -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding AvsPrefix, Mode=OneWay}"
                             Style="{StaticResource ScribeCodeBox}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal"
                             MaxHeight="80"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBox Grid.Row="1"
                             Text="{Binding AvsPrefix2, Mode=OneWay}"
                             VerticalAlignment="Stretch"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding AvsUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource ScriptAccentAvsBackground}"
                             Foreground="{StaticResource ScriptAccentAvsForeground}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 2.5 0 0"
                             Padding="2 2.5"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding AvsSuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             Margin="0 2.5 0 0"
                             FontWeight="Normal" />
                    <CheckBox Grid.Row="4"
                              Content="{Binding AvsEnableFpsParamsLabel}"
                              IsChecked="{Binding AvsEnableFpsParams}"
                              IsEnabled="{Binding IsFrameRateApplicable}"
                              Margin="0 2.5 0 0"
                              FontWeight="DemiBold"
                              Foreground="{StaticResource GlobalSecondary}" />
                    <!-- A/B Preview button -->
                    <Button Grid.Row="2"
                            Command="{Binding OpenAvsPreviewCommand}"
                            IsEnabled="{Binding CanOpenAvsPreview}"
                            Height="30"
                            Width="120"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0 2.5 0 0"
                            Panel.ZIndex="1"
                            Style="{StaticResource AzureButton}"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Rectangle Width="14"
                                       Height="14"
                                       VerticalAlignment="Center"
                                       Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GamePlay}"
                                                Stretch="Uniform"
                                                AlignmentX="Center"
                                                AlignmentY="Center" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="A/B Preview"
                                       VerticalAlignment="Center"
                                       FontWeight="Normal"
                                       Margin="5 0 -5 0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabVpy}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 2.5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*"
                                       MinHeight="60" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding VpyPrefix, Mode=OneWay}"
                             Style="{StaticResource ScribeCodeBox}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal"
                             MaxHeight="70"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBox Grid.Row="1"
                             Text="{Binding VpyPrefix2, Mode=OneWay}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             IsReadOnly="True"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding VpyUserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource ScriptAccentVpyBackground}"
                             Foreground="{StaticResource ScriptAccentVpyForeground}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 2.5 0 0"
                             Padding="2 2.5"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             FontWeight="Normal" />
                    <TextBox Grid.Row="3"
                             Text="{Binding VpySuffix, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="Transparent"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             Margin="0 2.5 0 0"
                             FontWeight="Normal" />
                    <CheckBox Grid.Row="4"
                              Content="{Binding VpyEnableFpsParamsLabel}"
                              IsChecked="{Binding VpyEnableFpsParams}"
                              IsEnabled="{Binding IsFrameRateApplicable}"
                              Margin="0 2.5 0 0"
                              FontWeight="DemiBold"
                              Foreground="{StaticResource GlobalSecondary}" />
                    <Button Grid.Row="2"
                            Command="{Binding OpenVpyPreviewCommand}"
                            IsEnabled="{Binding CanOpenVpyPreview}"
                            Height="30"
                            Width="120"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0 2.5 0 0"
                            Panel.ZIndex="1"
                            Style="{StaticResource TealButton}"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Rectangle Width="14"
                                       Height="14"
                                       VerticalAlignment="Center"
                                       Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GamePlay}"
                                                Stretch="Uniform"
                                                AlignmentX="Center"
                                                AlignmentY="Center" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="A/B Preview"
                                       VerticalAlignment="Center"
                                       FontWeight="Normal"
                                       Margin="5 0 -5 0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabFFmpeg}"
                     Padding="15 7.5"
                     FontWeight="Bold">
                <Grid Margin="0 2.5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding FFmpegConcatFileList, Mode=OneWay}"
                             IsReadOnly="True"
                             Style="{StaticResource ScribeCodeBox}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             Padding="1.25 2.5"
                             MaxHeight="150"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsConcatMode, Converter={StaticResource BoolToVisibility}}"
                             FontWeight="Normal" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding FFmpegFreeTextHint}"
                               Foreground="{StaticResource GlobalSecondary}"
                               TextWrapping="Wrap"
                               FontWeight="Normal" />
                    <TextBox Grid.Row="2"
                             Text="{Binding FFmpegFreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource ScriptAccentFFmpegBackground}"
                             Foreground="{StaticResource ScriptAccentFFmpegForeground}"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             Margin="0 2.5 0 0"
                             Padding="2 2.5"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Disabled"
                             PreviewKeyDown="FFmpegFreeText_PreviewKeyDown"
                             DataObject.Pasting="FFmpegFreeText_Pasting"
                             PreviewMouseWheel="UserInput_PreviewMouseWheel"
                             FontWeight="Normal" />
                    <Button Grid.Row="2"
                            Command="{Binding OpenFfmpegPreviewCommand}"
                            IsEnabled="{Binding CanOpenFfmpegPreview}"
                            Height="30"
                            Width="120"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0 2.5 0 0"
                            Panel.ZIndex="1"
                            Style="{StaticResource LavenderButton}"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Rectangle Width="14"
                                       Height="14"
                                       VerticalAlignment="Center"
                                       Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{x:Static ui:SvgIconProvider.GamePlay}"
                                                Stretch="Uniform"
                                                AlignmentX="Center"
                                                AlignmentY="Center" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="A/B Preview"
                                       VerticalAlignment="Center"
                                       FontWeight="Normal"
                                       Margin="5 0 -5 0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Filter generator section -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel>
                <StackPanel Visibility="{Binding IsFFmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <!-- FFMPEG VFR to CFR -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="VFR→CFR"
                                       Style="{StaticResource H3}"
                                       Margin="0 15 0 0" />
                            <Button Grid.Column="1"
                                    Command="{Binding InsertFFmpegFilterCommand}"
                                    CommandParameter="{Binding FFmpegFpsFilter}"
                                    IsEnabled="{Binding CanInsertFFmpegFpsFilter}"
                                    Style="{StaticResource AppendLinkButton}" />
                        </Grid>
                        <TextBox Text="{Binding FFmpegFpsFilterDisplay, Mode=OneWay}"
                                 Padding="0 2.5"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SarRepairTitle}"
                                       Style="{StaticResource H3}"
                                       Margin="0 15 0 0" />
                            <Button Grid.Column="1"
                                    Command="{Binding InsertFFmpegFilterCommand}"
                                    CommandParameter="{Binding FFmpegSarRepairFilter}"
                                    IsEnabled="{Binding CanInsertFFmpegSarRepairFilter}"
                                    Style="{StaticResource AppendLinkButton}" />
                        </Grid>
                        <TextBox Text="{Binding FFmpegSarRepairFilterDisplay, Mode=OneWay}"
                                 Padding="0 2.5"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{StaticResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Keep all libplacebo options directly after SAR repair. -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DebandTitle}"
                                       Style="{StaticResource H3}"
                                       Margin="0 15 0 0" />
                            <Button Grid.Column="1"
                                    Command="{Binding InsertFFmpegFilterCommand}"
                                    CommandParameter="{Binding FFmpegDebandFilter}"
                                    IsEnabled="{Binding CanInsertFFmpegDebandFilter}"
                                    Style="{StaticResource AppendLinkButton}" />
                        </Grid>
                        <TextBox Text="{Binding FFmpegDebandFilterDisplay, Mode=OneWay}"
                                 Padding="0 2.5"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RotateTitle}"
                                   Style="{StaticResource H3}"
                                   Margin="0 15 0 0" />
                        <Button Grid.Column="1"
                                Visibility="{Binding IsAvsTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertAvsFilterCommand}"
                                CommandParameter="{Binding AvsRotateFilter}"
                                IsEnabled="{Binding CanInsertAvsRotateFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                        <Button Grid.Column="2"
                                Visibility="{Binding IsVpyTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertVpyFilterCommand}"
                                CommandParameter="{Binding VpyRotateFilter}"
                                IsEnabled="{Binding CanInsertVpyRotateFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                        <Button Grid.Column="3"
                                Visibility="{Binding IsFFmpegTabSelected, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding InsertFFmpegFilterCommand}"
                                CommandParameter="{Binding FFmpegRotateFilter}"
                                IsEnabled="{Binding CanInsertFFmpegRotateFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                    </Grid>
                    <Grid Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <comps:IntegerSlider Grid.Column="0"
                                             Label=""
                                             Minimum="0"
                                             Maximum="3"
                                             Value="{Binding RotateMode}"
                                             TickLabels="{Binding RotateTickLabels}"
                                             TickCount="4"
                                             Step="1"
                                             ValueText="{Binding RotateDisplay}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RotateDisplay}"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>
                     <TextBox Text="{Binding SelectedRotateFilterDisplay, Mode=OneWay}"
                              Margin="0 2.5 0 0"
                             Padding="0 2.5"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsFFmpegTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding UpscaleTitle}"
                                   Style="{StaticResource H3}"
                                   Margin="0 15 0 0" />
                        <Button Grid.Column="1"
                                Command="{Binding InsertFFmpegFilterCommand}"
                                CommandParameter="{Binding FFmpegUpscaleFilter}"
                                IsEnabled="{Binding CanInsertFFmpegUpscaleFilter}"
                                Style="{StaticResource AppendLinkButton}" />
                    </Grid>
                    <Grid Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="60" />
                        </Grid.ColumnDefinitions>
                        <comps:IntegerSlider Grid.Column="0"
                                             Label=""
                                             Minimum="{Binding UpscaleHeightMinimum}"
                                             Maximum="{Binding UpscaleHeightMaximum}"
                                             Value="{Binding UpscaleHeight}"
                                             TickLabels="{Binding UpscaleTickLabels}"
                                             TickCount="5"
                                             Step="{Binding UpscaleStep}"
                                             Margin="2.5 0 -5 0">
                            <comps:IntegerSlider.Style>
                                <Style TargetType="comps:IntegerSlider">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSource}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </comps:IntegerSlider.Style>
                        </comps:IntegerSlider>
                        <!-- !Scale text, hide normally -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ScaleNotApplicableText}"
                                   Margin="0 0 0 5"
                                   Foreground="{StaticResource ButtonTertiary}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSource}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Scale target display -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding UpscaleTargetDisplay}"
                                   Foreground="{StaticResource GlobalSecondary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Margin="1 5 0 0">
                        <CheckBox Content="{Binding UpscalerSpline36Label}"
                                  IsChecked="{Binding UseSpline36Upscaler}"
                                  Margin="0 0 15 0"
                                  Foreground="{StaticResource GlobalSecondary}" />
                        <CheckBox Content="{Binding UpscalerNearestLabel}"
                                  IsChecked="{Binding UseNearestUpscaler}"
                                  Margin="0 0 15 0"
                                  Foreground="{StaticResource GlobalSecondary}" />
                        <CheckBox Content="{Binding UpscalerOversampleLabel}"
                                  IsChecked="{Binding UseOversampleUpscaler}"
                                  Margin="0 0 15 0"
                                  Foreground="{StaticResource GlobalSecondary}" />
                        <CheckBox Content="{Binding UpscalerEwaLanczosLabel}"
                                  IsChecked="{Binding UseEwaLanczosUpscaler}"
                                  Foreground="{StaticResource GlobalSecondary}" />
                    </StackPanel>
                    <TextBox Text="{Binding FFmpegUpscaleFilterDisplay, Mode=OneWay}"
                             Margin="0 2.5 0 0"
                             Padding="0 2.5"
                             IsReadOnly="True"
                             BorderThickness="0"
                             FontFamily="{DynamicResource CodeFont}"
                             Background="{StaticResource Background}"
                             Foreground="{StaticResource ButtonTertiary}"
                             VerticalAlignment="Center" />

                    <!-- The writer places native flips before an existing libplacebo block. -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FlipTitle}"
                                       Style="{StaticResource H3}"
                                       Margin="0 15 0 0" />
                            <Button Grid.Column="1"
                                    Command="{Binding InsertFFmpegFlipFilterCommand}"
                                    CommandParameter="{Binding FFmpegFlipFilter}"
                                    IsEnabled="{Binding CanInsertFFmpegFlipFilter}"
                                    Style="{StaticResource AppendLinkButton}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Margin="1 5 0 0">
                            <CheckBox Content="{Binding HorizontalFlipLabel}"
                                      IsChecked="{Binding HorizontalFlipEnabled}"
                                      Margin="0 0 20 0"
                                      Foreground="{StaticResource GlobalSecondary}" />
                            <CheckBox Content="{Binding VerticalFlipLabel}"
                                      IsChecked="{Binding VerticalFlipEnabled}"
                                      Foreground="{StaticResource GlobalSecondary}" />
                        </StackPanel>
                        <TextBox Text="{Binding FFmpegFlipFilterDisplay, Mode=OneWay}"
                                 Margin="0 2.5 0 0"
                                 Padding="0 2.5"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource CodeFont}"
                                 Background="{StaticResource Background}"
                                 Foreground="{StaticResource ButtonTertiary}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                 <StackPanel Visibility="{Binding IsScriptTabSelected, Converter={StaticResource BoolToVisibility}}">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
