<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.LsmashIndexProgressModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:ui="clr-namespace:OneColumnEncoder.UI"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:LsmashIndexProgressVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="510"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}">
    <Grid Margin="15">
        <StackPanel>
            <comps:ProgressBar
                ProgressTitle="{Binding ProgressTitle}"
                ProgressValue="{Binding ProgressValue}"
                ProgressText="{Binding ProgressText}"
                IsProgressTrackingAvailable="True"
                IsEncodingActive="True"
                Margin="0 0 0 10" />
            <comps:HintPanel
                Text="{Binding HintText}"
                HorizontalAlignment="Left"
                Margin="5 0 5 0" />
        </StackPanel>
    </Grid>
</ui:AdaptiveWindow>
