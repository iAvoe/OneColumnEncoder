<helpers:AdaptiveWindow x:Class="OneColumnEncoder.Views.ImageABPreviewModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ImageABPreviewVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="Manual"
        Background="{StaticResource Background}">
    <Grid Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding EncoderLabel}"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="0 0 10 0"
                       Foreground="{StaticResource GlobalPrimary}" />
            <comps:DropdownMenu Grid.Column="1"
                                Height="29"
                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=helpers:AdaptiveWindow}}"
                                DataContext="{Binding EncoderDropdown}" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10 0">

                <TextBlock Text="{Binding ZoomLabel}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}" />

                <Rectangle Width="10" />

                <Button Content="--"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineOut_Click" />

                <Rectangle Width="5" />

                <Button Content="-"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomOut_Click" />

                <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                           Width="55"
                           FontSize="14"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalPrimary}"/>

                <Button Content="+"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomIn_Click" />

                <Rectangle Width="5" />

                <Button Content="++"
                        Width="30"
                        Height="30"
                        Style="{StaticResource NormalButton}"
                        Click="ZoomFineIn_Click" />
            </StackPanel>

            <comps:ThreeButtonGroup Grid.Column="4"
                                    DataContext="{Binding ZoomPresetButtons}"
                                    ButtonHeight="30"
                                    Width="330"
                                    Button1Command="{Binding Cmd1}"
                                    Button2Command="{Binding Cmd2}"
                                    Button3Command="{Binding Cmd3}" />
        </Grid>

        <!-- Set gap with EncoderConfModal in OpenEncoderConfCmd -->
        <comps:ImageABPreviewViewer x:Name="PreviewViewer"
                                    Grid.Row="1"
                                    Margin="0 10 0 10" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="107" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding PositionLabel}"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <comps:IntegerSlider Grid.Column="1"
                                  Minimum="0"
                                  Maximum="{Binding MaxPositionSeconds}"
                                  Value="{Binding PreviewPositionSeconds, Mode=TwoWay}"
                                  TickLabels="{Binding PositionTickLabels}"
                                  TickCount="5"
                                  LabelWidth="0"
                                  SliderMaxWidth="1200"
                                  IsEnabled="{Binding IsIdle}" />
            <Button Grid.Column="2"
                    Content="{Binding PreviewButtonText}"
                    Command="{Binding PreviewCommand}"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource GlobalSecondary}"
                   TextWrapping="Wrap"
                   Margin="0 6 0 0" />

        <StackPanel Grid.Row="4"
                    Margin="0 6 0 0">
            <comps:HintPanel Text="{Binding Hint1Text}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             FontSize="11" />
            <comps:HintPanel Text="{Binding Hint2Text}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             FontSize="11"
                             Margin="0 4 0 0" />
            <comps:HintPanel Text="{Binding Hint3Text}"
                             HintBrush="{StaticResource GlobalSecondary}"
                             FontSize="11"
                             Margin="0 4 0 0" />
        </StackPanel>
    </Grid>
</helpers:AdaptiveWindow>
