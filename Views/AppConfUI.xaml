<UserControl x:Class="OneColumnEncoder.Views.AppConfUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OneColumnEncoder.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#CC000000">
        <Border Background="#FF1E1E1E"
                BorderBrush="#FF3F3F46"
                BorderThickness="1"
                CornerRadius="8"
                Width="600"
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#FF2D2D30"
                        BorderBrush="#FF3F3F46"
                        BorderThickness="0,0,0,1"
                        Padding="20,15">
                    <TextBlock Text="Application Settings"
                               Foreground="#FFF1F1F1"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Content Area (placeholder) -->
                <ScrollViewer Grid.Row="1"
                              Padding="20"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="Settings content will be added here."
                               Foreground="#FFB0B0B0"
                               FontStyle="Italic"/>
                </ScrollViewer>

                <!-- Footer with Close button -->
                <Border Grid.Row="2"
                        Background="#FF2D2D30"
                        BorderBrush="#FF3F3F46"
                        BorderThickness="0,1,0,0"
                        Padding="20,15">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Close"
                                Command="{Binding CloseCmd}"
                                Width="100"
                                Height="32"
                                Background="#FF007ACC"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
