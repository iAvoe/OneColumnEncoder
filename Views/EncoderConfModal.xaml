<Window x:Class="OneColumnEncoder.Views.EncoderConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:EncoderConfVM}"
        mc:Ignorable="d"
        Title="{Binding Lang.WindowTitle}"
        Width="530"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TabControl with dual tabs (copied pattern from ScriptSrcScribeModal) -->
            <TabControl Grid.Row="0"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        Margin="0 0 0 0">
                <!-- Tab 1: Rate Control -->
                <TabItem Header="{Binding Lang.TabRateControl}"
                         Padding="15 7.5"
                         FontWeight="Bold">
                    <Grid Margin="0 10 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <comps:AppConfContainer Grid.Row="0"
                                                Header="{Binding Lang.RateControlModeText}">
                            <comps:AppConfItem>
                                <comps:DropdownMenu DataContext="{Binding RateControlModeDropdown}"
                                                    Width="200"
                                                    HorizontalAlignment="Right" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>

                        <comps:IntegerSlider Grid.Row="1"
                                             Margin="0 10 0 0"
                                             Label="{Binding Lang.CrfSliderLabel}"
                                             Minimum="0"
                                             Maximum="51"
                                             Value="{Binding CrfValue, Mode=TwoWay}"
                                             TickLabels="{Binding CrfTickLabels}"
                                             TickCount="10">
                            <comps:IntegerSlider.Style>
                                <Style TargetType="comps:IntegerSlider">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCrfMode}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </comps:IntegerSlider.Style>
                        </comps:IntegerSlider>

                        <comps:AppConfContainer Grid.Row="2"
                                                Header="{Binding Lang.TargetBitrateText}">
                            <comps:AppConfContainer.Style>
                                <Style TargetType="comps:AppConfContainer">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCrfMode}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </comps:AppConfContainer.Style>
                            <comps:AppConfItem>
                                <TextBox Width="200"
                                         HorizontalAlignment="Right"
                                         Text="{Binding TargetBitrate, Mode=TwoWay}" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>

                        <comps:AppConfContainer Grid.Row="3"
                                                Header="{Binding Lang.PresetText}">
                            <comps:AppConfItem>
                                <comps:DropdownMenu DataContext="{Binding PresetDropdown}"
                                                    Width="200"
                                                    HorizontalAlignment="Right" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>

                        <comps:AppConfContainer Grid.Row="4"
                                                Header="{Binding Lang.TuneText}">
                            <comps:AppConfItem>
                                <comps:DropdownMenu DataContext="{Binding TuneDropdown}"
                                                    Width="200"
                                                    HorizontalAlignment="Right" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Advanced -->
                <TabItem Header="{Binding Lang.TabAdvanced}"
                         Padding="15 7.5"
                         FontWeight="Bold">
                    <Grid Margin="0 10 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <comps:AppConfContainer Grid.Row="0"
                                                Header="{Binding Lang.ProfileText}">
                            <comps:AppConfItem>
                                <comps:DropdownMenu DataContext="{Binding ProfileDropdown}"
                                                    Width="200"
                                                    HorizontalAlignment="Right" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>

                        <comps:IntegerSlider Grid.Row="1"
                                             Margin="0 10 0 0"
                                             Label="{Binding Lang.KeyframeIntervalText}"
                                             Minimum="10"
                                             Maximum="1000"
                                             Value="{Binding KeyframeInterval, Mode=TwoWay}"
                                             TickLabels="{Binding KeyframeTickLabels}"
                                             TickCount="8" />

                        <comps:AppConfContainer Grid.Row="2"
                                                Header="{Binding Lang.FastDecodeText}"
                                                Margin="0 10 0 0">
                            <comps:AppConfItem>
                                <CheckBox IsChecked="{Binding FastDecode, Mode=TwoWay}"
                                          HorizontalAlignment="Right" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>

                        <comps:AppConfContainer Grid.Row="3"
                                                Header="{Binding Lang.ZeroLatencyText}">
                            <comps:AppConfItem>
                                <CheckBox IsChecked="{Binding ZeroLatency, Mode=TwoWay}"
                                          HorizontalAlignment="Right" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>

                        <comps:AppConfContainer Grid.Row="4"
                                                Header="{Binding Lang.CustomParamsText}">
                            <comps:AppConfItem>
                                <TextBox Width="200"
                                         HorizontalAlignment="Right"
                                         Text="{Binding CustomParams, Mode=TwoWay}" />
                            </comps:AppConfItem>
                        </comps:AppConfContainer>

                        <!-- Small hint text (copied pattern from ParallelismConfModal Grid.Row="9") -->
                        <StackPanel Grid.Row="5"
                                    Margin="5 10 5 0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Rectangle Width="10"
                                       Height="10"
                                       VerticalAlignment="Center"
                                       Fill="{StaticResource GlobalTertiary}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                                                Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock FontSize="9"
                                       Focusable="False"
                                       Margin="3.5 0 0 0"
                                       Text="{Binding Lang.CustomParamsHint}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource GlobalTertiary}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- TwoButtonGroup for Cancel / Confirm -->
            <comps:TwoButtonGroup Grid.Row="2"
                                  DataContext="{Binding FinishButtons}"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  ButtonHeight="30"
                                  Margin="0 15 0 0" />
        </Grid>
    </ScrollViewer>
</Window>
