<Window x:Class="OneColumnEncoder.Views.EncoderConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:EncoderConfVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="520"
        Height="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding RateControlTitle}"
                       Style="{StaticResource H1}" />

            <StackPanel Grid.Row="1"
                        Margin="0 18 0 0">
                <TextBlock Text="{Binding CrfModeText}"
                           Style="{StaticResource H2}"
                           Margin="0 0 0 8" />
                <Border BorderBrush="{StaticResource GlobalPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="White"
                        Padding="14 12 14 10">
                    <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                                Margin="0"
                                Background="Transparent"
                                BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Padding"
                                        Value="18 9" />
                                <Setter Property="FontWeight"
                                        Value="Bold" />
                                <Setter Property="Margin"
                                        Value="0 0 4 0" />
                                <Setter Property="Background"
                                        Value="#E7E7E7" />
                                <Setter Property="BorderBrush"
                                        Value="#BDBDBD" />
                                <Setter Property="BorderThickness"
                                        Value="1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5 5 0 0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Header" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="White" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource GlobalPrimary}" />
                                                    <Setter Property="Panel.ZIndex"
                                                            Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="{Binding CrfModeText}">
                            <StackPanel Margin="0 10 0 0">
                                <comps:IntegerSlider Label="x264"
                                                     Minimum="0"
                                                     Maximum="25"
                                                     Value="{Binding X264Crf, Mode=TwoWay}"
                                                     TickLabels="{Binding X264CrfLabels}"
                                                     TickCount="5" />
                                <comps:IntegerSlider Label="x265"
                                                     Minimum="0"
                                                     Maximum="35"
                                                     Value="{Binding X265Crf, Mode=TwoWay}"
                                                     TickLabels="{Binding X265CrfLabels}"
                                                     TickCount="5"
                                                     Margin="0 8 0 0" />
                                <comps:IntegerSlider Label="SVT-AV1"
                                                     Minimum="0"
                                                     Maximum="45"
                                                     Value="{Binding SvtAv1Crf, Mode=TwoWay}"
                                                     TickLabels="{Binding SvtAv1CrfLabels}"
                                                     TickCount="5"
                                                     Margin="0 8 0 0" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="{Binding AbrModeText}">
                            <StackPanel Margin="0 10 0 0">
                                <comps:IntegerSlider Label="x264"
                                                     Minimum="1"
                                                     Maximum="500"
                                                     Value="{Binding X264Abr, Mode=TwoWay}"
                                                     TickLabels="{Binding X264AbrLabels}"
                                                     TickCount="5" />
                                <comps:IntegerSlider Label="x265"
                                                     Minimum="1"
                                                     Maximum="500"
                                                     Value="{Binding X265Abr, Mode=TwoWay}"
                                                     TickLabels="{Binding X265AbrLabels}"
                                                     TickCount="5"
                                                     Margin="0 8 0 0" />
                                <comps:IntegerSlider Label="SVT-AV1"
                                                     Minimum="1"
                                                     Maximum="500"
                                                     Value="{Binding SvtAv1Abr, Mode=TwoWay}"
                                                     TickLabels="{Binding SvtAv1AbrLabels}"
                                                     TickCount="5"
                                                     Margin="0 8 0 0" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 8 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding CrfHintText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0 18 0 0">
                <TextBlock Text="{Binding CustomParamsTitle}"
                           Style="{StaticResource H1}" />
                <TextBlock Text="{Binding BasicParamsText}"
                           Style="{StaticResource H2}"
                           Margin="0 12 0 4" />
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="x264"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="1"
                                        MinWidth="120"
                                        Height="25"
                                        DataContext="{Binding X264ModeDropdown}" />
                </Grid>
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="x265"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="1"
                                        MinWidth="120"
                                        Height="25"
                                        DataContext="{Binding X265ModeDropdown}" />
                </Grid>
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SVT-AV1"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="1"
                                        MinWidth="120"
                                        Height="25"
                                        DataContext="{Binding SvtAv1ModeDropdown}" />
                </Grid>

                <TextBlock Text="{Binding KeyframeSecondsText, Mode=OneWay}"
                           Style="{StaticResource H2}"
                           Margin="0 10 0 0"/>
                <comps:IntegerSlider Label="{Binding X264Text}"
                                     Minimum="6"
                                     Maximum="15"
                                     Value="{Binding X264Keyframe, Mode=TwoWay}"
                                     TickLabels="{Binding X264KeyframeLabels}"
                                     TickCount="4" />
                <comps:IntegerSlider Label="{Binding X265Text}"
                                     Minimum="4"
                                     Maximum="13"
                                     Value="{Binding X265Keyframe, Mode=TwoWay}"
                                     TickLabels="{Binding X265KeyframeLabels}"
                                     TickCount="4"
                                     Margin="0 6 0 0" />
                <comps:IntegerSlider Label="{Binding SvtAv1Text}"
                                     Minimum="6"
                                     Maximum="15"
                                     Value="{Binding SvtAv1Keyframe, Mode=TwoWay}"
                                     TickLabels="{Binding SvtAv1KeyframeLabels}"
                                     TickCount="4"
                                     Margin="0 6 0 0" />

                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 5 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding KeyframeHintText1, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 5 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding KeyframeHintText2, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="{Binding ThirdPartyParamsText, Mode=OneWay}"
                           Style="{StaticResource H2}"
                           Margin="0 10 0 0" />
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding X264ModText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Row="0"
                              Grid.Column="1"
                              IsChecked="{Binding X264Mod, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding X265JpsdrAqText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="1"
                              IsChecked="{Binding X265Aq, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding X265JpsdrDarkText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              IsChecked="{Binding X265Dark, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="3"
                               Text="{Binding X265JpsdrTextureText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              IsChecked="{Binding X265Texture, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding SvtAv1EssentialDl2Text, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="1"
                              IsChecked="{Binding SvtAv1Dl2, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="5"
                               Text="{Binding SvtAv1EssentialAutoTileText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="5"
                              Grid.Column="1"
                              IsChecked="{Binding SvtAv1AutoTile, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                </Grid>

                <TextBlock FontSize="11"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 6 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText1, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 4 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText2, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 4 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText3, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 4 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText4, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <comps:TwoButtonGroup Grid.Row="4"
                                  Margin="0 18 0 0"
                                  DataContext="{Binding FinishButtons}"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  ButtonHeight="32" />
        </Grid>
    </ScrollViewer>
</Window>
