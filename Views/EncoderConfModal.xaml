<Window x:Class="OneColumnEncoder.Views.EncoderConfModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:EncoderConfVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="520"
        Height="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding RateControlTitle}"
                       Style="{StaticResource H1}"
                       Margin="0 5 0 0" />

            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        Margin="0 15 0 0">

                <TabItem Header="{Binding CrfModeText}"
                         Padding="15 7.5"
                         FontWeight="Bold">
                    <comps:IntegerSliderGroup Margin="0 10 0 0">
                        <comps:IntegerSlider Label="x264"
                                             Minimum="0"
                                             Maximum="25"
                                             Value="{Binding X264Crf, Mode=TwoWay}"
                                             TickLabels="{Binding X264CrfLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="340" />
                        <comps:IntegerSlider Label="x265"
                                             Minimum="0"
                                             Maximum="30"
                                             Value="{Binding X265Crf, Mode=TwoWay}"
                                             TickLabels="{Binding X265CrfLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="340"/>
                        <comps:IntegerSlider Label="SVT-AV1"
                                             Minimum="0"
                                             Maximum="43"
                                             Value="{Binding SvtAv1Crf, Mode=TwoWay}"
                                             TickLabels="{Binding SvtAv1CrfLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="340"/>
                    </comps:IntegerSliderGroup>
                </TabItem>

                <TabItem Header="{Binding AbrModeText}"
                         Padding="15 7.5"
                         FontWeight="Bold">
                    <comps:IntegerSliderGroup Margin="0 10 0 0">
                        <comps:IntegerSlider Label="x264"
                                             Minimum="1"
                                             Maximum="500"
                                             Value="{Binding X264Abr, Mode=TwoWay}"
                                             TickLabels="{Binding X264AbrLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="340" />
                        <comps:IntegerSlider Label="x265"
                                             Minimum="1"
                                             Maximum="500"
                                             Value="{Binding X265Abr, Mode=TwoWay}"
                                             TickLabels="{Binding X265AbrLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="340"/>
                        <comps:IntegerSlider Label="SVT-AV1"
                                             Minimum="1"
                                             Maximum="500"
                                             Value="{Binding SvtAv1Abr, Mode=TwoWay}"
                                             TickLabels="{Binding SvtAv1AbrLabels}"
                                             TickCount="5"
                                             SliderMaxWidth="340"/>
                    </comps:IntegerSliderGroup>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="2"
                        Margin="5 10 5 0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Rectangle Width="10"
                           Height="10"
                           VerticalAlignment="Center"
                           Fill="{StaticResource GlobalTertiary}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock FontSize="9"
                           Focusable="False"
                           Margin="3.5 0 0 0"
                           Text="{Binding CrfHintText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GlobalTertiary}" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Margin="0 10 0 0">
                <TextBlock Text="{Binding CustomParamsTitle}"
                           Style="{StaticResource H1}" />
                <TextBlock Text="{Binding BasicParamsText}"
                           Style="{StaticResource H2}"
                           Margin="0 10 0 0" />

                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="x264"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="1"
                                        MinWidth="120"
                                        Height="25"
                                        DataContext="{Binding X264ModeDropdown}" />
                </Grid>

                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="x265"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="1"
                                        MinWidth="120"
                                        Height="25"
                                        DataContext="{Binding X265ModeDropdown}" />
                </Grid>
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SVT-AV1"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <comps:DropdownMenu Grid.Column="1"
                                        MinWidth="120"
                                        Height="25"
                                        DataContext="{Binding SvtAv1ModeDropdown}" />
                </Grid>

                <TextBlock Text="{Binding KeyframeSecondsText, Mode=OneWay}"
                           Style="{StaticResource H2}"
                           Margin="0 10 0 0" />
                <comps:IntegerSliderGroup>
                    <comps:IntegerSlider Label="{Binding X264Text}"
                                         Minimum="6"
                                         Maximum="15"
                                         Value="{Binding X264Keyframe, Mode=TwoWay}"
                                         TickLabels="{Binding X264KeyframeLabels}"
                                         TickCount="4"
                                         SliderMaxWidth="430" />
                    <comps:IntegerSlider Label="{Binding X265Text}"
                                         Minimum="4"
                                         Maximum="13"
                                         Value="{Binding X265Keyframe, Mode=TwoWay}"
                                         TickLabels="{Binding X265KeyframeLabels}"
                                         TickCount="4"
                                         SliderMaxWidth="430"
                                         Margin="0 6 0 0" />
                    <comps:IntegerSlider Label="{Binding SvtAv1Text}"
                                         Minimum="6"
                                         Maximum="15"
                                         Value="{Binding SvtAv1Keyframe, Mode=TwoWay}"
                                         TickLabels="{Binding SvtAv1KeyframeLabels}"
                                         TickCount="4"
                                         SliderMaxWidth="430"
                                         Margin="0 6 0 0" />
                </comps:IntegerSliderGroup>

                <StackPanel Margin="5 10 5 0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Rectangle Width="10"
                               Height="10"
                               VerticalAlignment="Center"
                               Fill="{StaticResource GlobalTertiary}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{x:Static helpers:SvgIconProviderH.GameInfo}"
                                        Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="9"
                               Focusable="False"
                               Margin="3.5 0 0 0"
                               Text="{Binding KeyintHintText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource GlobalTertiary}" />
                </StackPanel>

                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 5 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding KeyframeHintText1, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 5 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding KeyframeHintText2, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="{Binding ThirdPartyParamsText, Mode=OneWay}"
                           Style="{StaticResource H2}"
                           Margin="0 10 0 0" />
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding X264ModText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Row="0"
                              Grid.Column="1"
                              IsChecked="{Binding X264Mod, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding X265JpsdrAqText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="1"
                              IsChecked="{Binding X265Aq, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding X265JpsdrDarkText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              IsChecked="{Binding X265Dark, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="3"
                               Text="{Binding X265JpsdrTextureText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              IsChecked="{Binding X265Texture, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding SvtAv1EssentialDl2Text, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="1"
                              IsChecked="{Binding SvtAv1Dl2, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                    <TextBlock Grid.Row="5"
                               Text="{Binding SvtAv1EssentialAutoTileText, Mode=OneWay}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0 10 0 0" />
                    <CheckBox Grid.Row="5"
                              Grid.Column="1"
                              IsChecked="{Binding SvtAv1AutoTile, Mode=TwoWay}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 10 0 0" />
                </Grid>

                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 6 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText1, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 4 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText2, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 4 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText3, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource GlobalTertiary}"
                           Margin="0 4 0 0">
                    <Run Text="&#x24d8; " /><Run Text="{Binding ThirdPartyHintText4, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <comps:TwoButtonGroup Grid.Row="4"
                                  Margin="0 18 0 0"
                                  DataContext="{Binding FinishButtons}"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  ButtonHeight="32" />
        </Grid>
    </ScrollViewer>
</Window>
