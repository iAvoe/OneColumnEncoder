<ui:AdaptiveWindow x:Class="OneColumnEncoder.Views.ProgressModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="clr-namespace:OneColumnEncoder.UI"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ProgressVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        SizeToContent="Height"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="14"
                   Text="{Binding P1Text}"
                   TextWrapping="WrapWithOverflow"
                   VerticalAlignment="Center" />

        <Button Grid.Row="1"
                Margin="0 15 0 0"
                MinHeight="40"
                Width="160"
                Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource PrimaryButton}" />
    </Grid>
</ui:AdaptiveWindow>
