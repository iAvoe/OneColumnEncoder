<Window x:Class="OneColumnEncoder.Views.ConfirmationModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:OneColumnEncoder.Views"
        xmlns:comps="clr-namespace:OneColumnEncoder.Components"
        xmlns:helpers="clr-namespace:OneColumnEncoder.Helpers"
        xmlns:vms="clr-namespace:OneColumnEncoder.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ConfirmationModalVM}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        MinHeight="150"
        MaxHeight="650"
        SizeToContent="Height"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy"
                        CanExecute="CopyMessage_CanExecute"
                        Executed="CopyMessage_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="C"
                    Modifiers="Control"
                    Command="ApplicationCommands.Copy" />
    </Window.InputBindings>

    <!--
    | P1 & TwoButtonGGroup |  I1  |
    Title: Window title
    I1: 3-row Icon (warning or error)
    P1: Message
    -->
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    MaxWidth="400"
                    VerticalAlignment="Center">
            <ScrollViewer MaxHeight="500"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock FontSize="14"
                           Focusable="True"
                           Height="Auto"
                           Text="{Binding P1Text}"
                           TextWrapping="WrapWithOverflow"
                           VerticalAlignment="Top">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding PlacementTarget.DataContext.CopyText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </ScrollViewer>
            <comps:TwoButtonGroup ButtonHeight="30"
                                  DataContext="{Binding FinishWarnErrButtons}"
                                  Button1Command="{Binding Cmd1}"
                                  Button2Command="{Binding Cmd2}"
                                  Button1IsEnabled="{Binding B2_1IsEnabled}"
                                  Button2IsEnabled="{Binding B2_2IsEnabled}"
                                  Margin="0 15 0 0" />
            <comps:HintPanel Text="{Binding CopyHint}"
                             Margin="5 1.25 5 0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
        </StackPanel>
        <!-- This might be an image icon instead -->
        <Image Grid.Column="1"
               Margin="15 0 0 0"
               Height="60"
               Source="{Binding I1Source}" />
    </Grid>
</Window>
